+// ---------------------------------------------------------------------------------------------------------------------------------
+// ipad-air: lookup-table kernel for Q2_K experts (EXPERIMENT.md section 21.9). The file's experts are repacked by tools/gguf_q2lut.py
+// (key ipad.expert_layout = "q2lut"). For every pair of activations (a0, a1) a 16-entry table holds q0*a0 + q1*a1 for all 2-bit codes,
+// rounded to int8 with one scale per 256 columns; a weight byte holds two 4-bit pair codes of one row, 16 rows to a vector, so one
+// vqtbl1q gives 16 rows' partial sums of two weights each, with no multiplies. Per 16 columns the 8 lookups are summed in int16 and
+// scaled by the sub-block scale; the Q2_K min term uses per-sub-block activation sums (int16, own scale).
+#if defined(__ARM_NEON)
+namespace {
+struct q2l_tabs {
+    std::vector<int8_t> T; std::vector<float> tS, aS; std::vector<int16_t> S;
+    int64_t nsb = 0;
+};
+q2l_tabs & q2l_get() { static q2l_tabs t; return t; }
+
+void q2l_build_sb(const float * a, int8_t * T, float * tS, int16_t * S, float * aS) {
+    float mx = 0.0f;
+    for (int p = 0; p < 128; p++) { mx = std::max(mx, 3.0f * (fabsf(a[2 * p]) + fabsf(a[2 * p + 1]))); }
+    const float s = mx / 127.0f, inv = s > 0.0f ? 1.0f / s : 0.0f;
+    *tS = s;
+    for (int p = 0; p < 128; p++) {
+        const float a0 = a[2 * p] * inv, a1 = a[2 * p + 1] * inv;
+        int8_t * t = T + p * 16;
+        for (int n = 0; n < 16; n++) { t[n] = (int8_t) lrintf((float) (n & 3) * a0 + (float) (n >> 2) * a1); }
+    }
+    float sj[16], ms = 0.0f;
+    for (int j = 0; j < 16; j++) { float x = 0.0f; for (int c = 0; c < 16; c++) { x += a[16 * j + c]; } sj[j] = x; ms = std::max(ms, fabsf(x)); }
+    const float sa = ms / 32767.0f, ia = sa > 0.0f ? 1.0f / sa : 0.0f;
+    *aS = sa;
+    for (int j = 0; j < 16; j++) { S[j] = (int16_t) lrintf(sj[j] * ia); }
+}
+
+// 16 rows (one row group) x one activation column: W points at the group's first super-block
+inline void q2l_group16(const uint8_t * W, int64_t nsb, const int8_t * T, const float * tS, const int16_t * S, const float * aS, float * out) {
+    const uint8x16_t m4 = vdupq_n_u8(0x0F);
+    float32x4_t f0 = vdupq_n_f32(0), f1 = f0, f2 = f0, f3 = f0;
+    for (int64_t sb = 0; sb < nsb; sb++) {
+        const uint8_t * b = W + sb * 1344;
+        const uint8_t * sc = b + 64, * qs = b + 320;
+        const int8_t * Ts = T + sb * 2048;
+        const int16_t * Ss = S + sb * 16;
+        int32x4_t i0 = vdupq_n_s32(0), i1 = i0, i2 = i0, i3 = i0, n0 = i0, n1 = i0, n2 = i0, n3 = i0;
+        for (int j = 0; j < 16; j++) {
+            const int8_t * Tj = Ts + j * 128;
+            const uint8_t * q = qs + j * 64;
+            int16x8_t sl, sh;
+            {
+                const uint8x16_t x = vld1q_u8(q);
+                const int8x16_t l0 = vqtbl1q_s8(vld1q_s8(Tj),      vandq_u8(x, m4));
+                const int8x16_t l1 = vqtbl1q_s8(vld1q_s8(Tj + 16), vshrq_n_u8(x, 4));
+                sl = vaddl_s8(vget_low_s8(l0), vget_low_s8(l1)); sh = vaddl_high_s8(l0, l1);
+            }
+            for (int v = 1; v < 4; v++) {
+                const uint8x16_t x = vld1q_u8(q + 16 * v);
+                const int8x16_t l0 = vqtbl1q_s8(vld1q_s8(Tj + 32 * v),      vandq_u8(x, m4));
+                const int8x16_t l1 = vqtbl1q_s8(vld1q_s8(Tj + 32 * v + 16), vshrq_n_u8(x, 4));
+                sl = vaddq_s16(sl, vaddl_s8(vget_low_s8(l0), vget_low_s8(l1)));
+                sh = vaddq_s16(sh, vaddl_high_s8(l0, l1));
+            }
+            const uint8x16_t s = vld1q_u8(sc + 16 * j);
+            const int16x8_t sl16 = vreinterpretq_s16_u16(vmovl_u8(vget_low_u8(vandq_u8(s, m4))));
+            const int16x8_t sh16 = vreinterpretq_s16_u16(vmovl_high_u8(vandq_u8(s, m4)));
+            i0 = vmlal_s16(i0, vget_low_s16(sl), vget_low_s16(sl16)); i1 = vmlal_high_s16(i1, sl, sl16);
+            i2 = vmlal_s16(i2, vget_low_s16(sh), vget_low_s16(sh16)); i3 = vmlal_high_s16(i3, sh, sh16);
+            const uint8x16_t mn = vshrq_n_u8(s, 4);
+            const int16x8_t ml = vreinterpretq_s16_u16(vmovl_u8(vget_low_u8(mn))), mh = vreinterpretq_s16_u16(vmovl_high_u8(mn));
+            const int16_t sj = Ss[j];
+            n0 = vmlal_n_s16(n0, vget_low_s16(ml), sj); n1 = vmlal_high_n_s16(n1, ml, sj);
+            n2 = vmlal_n_s16(n2, vget_low_s16(mh), sj); n3 = vmlal_high_n_s16(n3, mh, sj);
+        }
+        const float16_t * d = (const float16_t *) b, * dm = (const float16_t *) (b + 32);
+        const float ts = tS[sb], as = aS[sb];
+        f0 = vfmaq_f32(f0, vcvtq_f32_s32(i0), vmulq_n_f32(vcvt_f32_f16(vld1_f16(d)),      ts));
+        f1 = vfmaq_f32(f1, vcvtq_f32_s32(i1), vmulq_n_f32(vcvt_f32_f16(vld1_f16(d + 4)),  ts));
+        f2 = vfmaq_f32(f2, vcvtq_f32_s32(i2), vmulq_n_f32(vcvt_f32_f16(vld1_f16(d + 8)),  ts));
+        f3 = vfmaq_f32(f3, vcvtq_f32_s32(i3), vmulq_n_f32(vcvt_f32_f16(vld1_f16(d + 12)), ts));
+        f0 = vfmsq_f32(f0, vcvtq_f32_s32(n0), vmulq_n_f32(vcvt_f32_f16(vld1_f16(dm)),      as));
+        f1 = vfmsq_f32(f1, vcvtq_f32_s32(n1), vmulq_n_f32(vcvt_f32_f16(vld1_f16(dm + 4)),  as));
+        f2 = vfmsq_f32(f2, vcvtq_f32_s32(n2), vmulq_n_f32(vcvt_f32_f16(vld1_f16(dm + 8)),  as));
+        f3 = vfmsq_f32(f3, vcvtq_f32_s32(n3), vmulq_n_f32(vcvt_f32_f16(vld1_f16(dm + 12)), as));
+    }
+    vst1q_f32(out, f0); vst1q_f32(out + 4, f1); vst1q_f32(out + 8, f2); vst1q_f32(out + 12, f3);
+}
+struct q2l_row { int32_t i1, i2; };   // ggml-cpu.c's mmid_row_mapping
+}  // namespace
+
+extern "C" {
+int ggml_moe_q2lut = 0;
+void ggml_backend_cpu_moe_pager_layout(const char * layout) {
+    if (layout && strcmp(layout, "q2lut") == 0) { ggml_moe_q2lut = getenv("GGML_MOE_Q2LUT_REF") ? 0 : 1; }
+}
+bool ggml_moe_q2lut_ok(const struct ggml_tensor * src0, const struct ggml_tensor * src1) {
+    return ggml_moe_q2lut && src0->type == GGML_TYPE_Q2_K && src0->ne[0] % 256 == 0 && src0->ne[1] % 16 == 0 &&
+           src1->type == GGML_TYPE_F32 && ggml_is_contiguous(src1);
+}
+// all threads, before the op's first barrier: tables for every column of src1
+void ggml_moe_q2lut_tables(const struct ggml_compute_params * params, const struct ggml_tensor * src1) {
+    q2l_tabs & t = q2l_get();
+    const int64_t ncol = src1->ne[1] * src1->ne[2], nsb = src1->ne[0] / 256;
+    // sized once by thread 0 before anyone writes: every thread computes the same sizes, and resize only grows
+    static std::mutex mu;
+    {
+        std::lock_guard<std::mutex> lk(mu);
+        t.nsb = nsb;
+        if ((int64_t) t.T.size() < ncol * nsb * 2048) { t.T.resize(ncol * nsb * 2048); t.tS.resize(ncol * nsb); t.aS.resize(ncol * nsb); t.S.resize(ncol * nsb * 16); }
+    }
+    ggml_barrier(params->threadpool);
+    for (int64_t u = params->ith; u < ncol * nsb; u += params->nth) {
+        const int64_t col = u / nsb, sb = u % nsb;
+        const float * a = (const float *) ((const char *) src1->data + (col % src1->ne[1]) * src1->nb[1] + (col / src1->ne[1]) * src1->nb[2]) + sb * 256;
+        q2l_build_sb(a, t.T.data() + u * 2048, t.tS.data() + u, t.S.data() + u * 16, t.aS.data() + u);
+    }
+}
+// all threads: experts[0..n) of this group, whose repacked data is at ptrs[i]
+void ggml_moe_q2lut_group(const struct ggml_compute_params * params, struct ggml_tensor * dst, const struct ggml_tensor * src0,
+                          const struct ggml_tensor * src1, const int32_t * experts, int n, const char ** ptrs,
+                          const int64_t * counts, const void * rows, int64_t rows_stride) {
+    q2l_tabs & t = q2l_get();
+    const int64_t nsb = src0->ne[0] / 256, G = src0->ne[1] / 16;
+    const q2l_row * R = (const q2l_row *) rows;
+    int64_t total = 0;
+    for (int i = 0; i < n; i++) { total += counts[experts[i]] * G; }
+    const int64_t w0 = total * params->ith / params->nth, w1 = total * (params->ith + 1) / params->nth;
+    int64_t w = 0;
+    for (int i = 0; i < n && w < w1; i++) {
+        const int e = experts[i];
+        const int64_t span = counts[e] * G;
+        if (w + span <= w0) { w += span; continue; }
+        for (int64_t r = 0; r < counts[e]; r++) {
+            const q2l_row m = R[(int64_t) e * rows_stride + r];
+            const int64_t col = (m.i1 % src1->ne[1]) + (int64_t) m.i2 * src1->ne[1];
+            const int8_t * T = t.T.data() + col * nsb * 2048;
+            float * out = (float *) ((char *) dst->data + m.i1 * dst->nb[1] + m.i2 * dst->nb[2]);
+            for (int64_t g = 0; g < G; g++, w++) {
+                if (w < w0) { continue; }
+                if (w >= w1) { break; }
+                q2l_group16((const uint8_t *) ptrs[i] + g * nsb * 1344, nsb, T, t.tS.data() + col * nsb, t.S.data() + col * nsb * 16,
+                            t.aS.data() + col * nsb, out + 16 * g);
+            }
+            if (w >= w1) { break; }
+        }
+    }
+}
+}  // extern "C"
+#endif
