diff --git a/ggml/src/ggml-cpu/repack-q1lut-tv.inc b/ggml/src/ggml-cpu/repack-q1lut-tv.inc
new file mode 100644
index 0000000..614dbd3
--- /dev/null
+++ b/ggml/src/ggml-cpu/repack-q1lut-tv.inc
@@ -0,0 +1,150 @@
+// tvbox patch: Four-Russians (T-MAC style) Q1_0 kernel for in-order ARM, EXPERIMENT.md section 19.
+// Groups of 32 rows. One 16-byte vector holds 32 weight nibbles, i.e. 4 columns of 32 rows (low nibble: rows 0-15, high
+// nibble: rows 16-31), so one 16-entry table of activation subset sums serves 32 rows x 4 columns = 128 multiply-adds with
+// about 8 NEON ops + 2 loads, vs 16 ops + 4 loads for the bit-plane kernel in repack-q1-tv.inc.
+//
+// Tables are built straight from the float activations, per 128 columns: is = 127 / (largest |x0|+|x1|+|x2|+|x3| of a tile),
+// T[n] = round(is * sum(+-x)) + 128, rounding once and exactly antisymmetric (only entries 0-7 are computed, T[15-n] mirrors
+// them), so there is no intermediate 8-bit activation and no bias. dot = d * (1 / is) * sum(T - 128).
+//
+// Layout, per group of 32 rows (same bytes as the bit-plane layout: 17 per 128 weights + 4 per row):
+//   ggml_half dmin[32], dstep[32];  then per 128 columns: uint8_t code[32]; uint8_t nib[32][16];
+// Activation row in wdata: float yd[nb128], padded to 64 bytes, then uint8_t T[nb128 * 32][16].
+static inline size_t q1lut_group_bytes(int64_t n) { return 128 + (size_t) (n / 128) * 544; }
+static inline size_t q1lut_row_bytes(int64_t n) { return GGML_PAD((size_t) (n / 128) * sizeof(float), 64) + (size_t) (n / 128) * 512 + 64; }
+
+static int repack_q1_0_to_q1lut_tv(struct ggml_tensor * t, const void * GGML_RESTRICT data, size_t data_size) {
+    GGML_ASSERT(t->type == GGML_TYPE_Q1_0);
+    const int nrow = ggml_nrows(t);
+    const int nb128 = t->ne[0] / 128;
+    GGML_ASSERT(data_size == (size_t) nrow * nb128 * sizeof(block_q1_0));
+    if (t->ne[1] % 32 != 0 || t->ne[0] % 128 != 0) {
+        return -1;
+    }
+    const block_q1_0 * src = (const block_q1_0 *) data;
+    uint8_t * dst = (uint8_t *) t->data;
+    for (int r = 0; r < nrow; r += 32) {
+        ggml_half * hdr = (ggml_half *) dst;
+        float mn[32], st[32];
+        for (int j = 0; j < 32; j++) {
+            float lo = INFINITY, hi = -INFINITY;
+            for (int b = 0; b < nb128; b++) {
+                const float d = GGML_CPU_FP16_TO_FP32(src[(size_t) (r + j) * nb128 + b].d);
+                lo = std::min(lo, d); hi = std::max(hi, d);
+            }
+            hdr[j]      = GGML_CPU_FP32_TO_FP16(lo);
+            hdr[32 + j] = GGML_CPU_FP32_TO_FP16((hi - lo) / 255.0f);
+            mn[j] = GGML_CPU_FP16_TO_FP32(hdr[j]);
+            st[j] = GGML_CPU_FP16_TO_FP32(hdr[32 + j]);
+        }
+        uint8_t * o = dst + 128;
+        for (int b = 0; b < nb128; b++, o += 544) {
+            uint8_t tmp[544];
+            memset(tmp, 0, sizeof tmp);
+            for (int j = 0; j < 32; j++) {
+                const block_q1_0 * in = &src[(size_t) (r + j) * nb128 + b];
+                const float d = GGML_CPU_FP16_TO_FP32(in->d);
+                const int q = st[j] > 0 ? (int) lroundf((d - mn[j]) / st[j]) : 0;
+                tmp[j] = (uint8_t) std::max(0, std::min(255, q));
+                for (int m = 0; m < 128; m++) {
+                    if ((in->qs[m / 8] >> (m % 8)) & 1) {
+                        tmp[32 + (m / 4) * 16 + (j & 15)] |= (uint8_t) (1u << (m % 4 + (j >= 16 ? 4 : 0)));
+                    }
+                }
+            }
+            memcpy(o, tmp, sizeof tmp);
+        }
+        dst += q1lut_group_bytes(t->ne[0]);
+    }
+    return 0;
+}
+
+#if defined(__ARM_NEON) // base ARMv8 NEON only, so it also runs on CPUs without dotprod (iPad Air)
+// Tables of 128-column groups g0..g1-1 of one activation row.
+static void q1lut_tables(const float * GGML_RESTRICT x, void * GGML_RESTRICT wrow, int64_t n, int64_t g0, int64_t g1) {
+    const int64_t nb128 = n / 128;
+    float * yd = (float *) wrow;
+    uint8_t * tables = (uint8_t *) wrow + GGML_PAD((size_t) nb128 * sizeof(float), 64);
+    static const int16_t P0[8] = {-1, 1,-1, 1,-1, 1,-1, 1}, P1[8] = {-1,-1, 1, 1,-1,-1, 1, 1}, P2[8] = {-1,-1,-1,-1, 1, 1, 1, 1};
+    const int16x8_t p0 = vld1q_s16(P0), p1 = vld1q_s16(P1), p2 = vld1q_s16(P2);
+    const uint8x8_t rev = vcreate_u8(0x0001020304050607ull);
+    for (int64_t g = g0; g < g1; g++) {
+        const float * xg = x + g * 128;
+        float mx = 0.0f;
+        for (int t = 0; t < 32; t++) {
+            mx = std::max(mx, vaddvq_f32(vabsq_f32(vld1q_f32(xg + t * 4))));
+        }
+        const float is = mx > 0.0f ? 16.0f * 127.0f / mx : 0.0f;   // 4 extra bits before the single rounding
+        yd[g] = mx / 127.0f;
+        uint8_t * T = tables + g * 512;
+        for (int t = 0; t < 32; t++, T += 16) {
+            const int16x4_t q = vmovn_s32(vcvtnq_s32_f32(vmulq_n_f32(vld1q_f32(xg + t * 4), is)));
+            int16x8_t s = vmulq_lane_s16(p0, q, 0);
+            s = vmlaq_lane_s16(s, p1, q, 1);
+            s = vmlaq_lane_s16(s, p2, q, 2);
+            s = vsubq_s16(s, vdupq_lane_s16(q, 3));   // entries 0-7 have bit 3 clear
+            const int8x8_t lo = vrshrn_n_s16(s, 4);
+            const uint8x8_t ulo = vreinterpret_u8_s8(vadd_s8(lo, vdup_n_s8((int8_t) 128)));
+            const uint8x8_t uhi = vtbl1_u8(vreinterpret_u8_s8(vsub_s8(vdup_n_s8((int8_t) 128), lo)), rev);
+            vst1q_u8(T, vcombine_u8(ulo, uhi));
+        }
+    }
+}
+
+// Row groups [gr0, gr1) of the matrix x activation rows. Loop interchange: every activation row walks the same 128-column
+// block before the next block is loaded, so a batch reads the weights from DRAM once.
+static void q1lut_gemm(int64_t n, const uint8_t * GGML_RESTRICT vx, const char * GGML_RESTRICT wdata, size_t row_bytes, int64_t nact,
+                       char * dst, size_t dst_row, int64_t gr0, int64_t gr1) {
+    const int64_t nb128 = n / 128;
+    const size_t tab_off = GGML_PAD((size_t) nb128 * sizeof(float), 64);
+    const uint8x16_t m0f = vdupq_n_u8(0x0f);
+    const uint16x8_t off = vdupq_n_u16(32 * 128);
+    for (int64_t x = gr0; x < gr1; x++) {
+        const uint8_t * grp = vx + (size_t) x * q1lut_group_bytes(n);
+        const __fp16 * hdr = (const __fp16 *) grp;
+        float32x4_t mn[8], st[8];
+        for (int i = 0; i < 8; i++) {
+            mn[i] = vcvt_f32_f16(vld1_f16(hdr + i * 4));
+            st[i] = vcvt_f32_f16(vld1_f16(hdr + 32 + i * 4));
+        }
+        for (int64_t r = 0; r < nact; r++) {
+            memset(dst + (size_t) r * dst_row + (size_t) x * 32 * sizeof(float), 0, 32 * sizeof(float));
+        }
+        const uint8_t * o = grp + 128;
+        for (int64_t g = 0; g < nb128; g++, o += 544) {
+            float32x4_t d[8];
+            for (int i = 0; i < 4; i++) {
+                const uint16x8_t c16 = vmovl_u8(vld1_u8(o + i * 8));
+                d[i * 2]     = vfmaq_f32(mn[i * 2],     vcvtq_f32_u32(vmovl_u16(vget_low_u16(c16))),  st[i * 2]);
+                d[i * 2 + 1] = vfmaq_f32(mn[i * 2 + 1], vcvtq_f32_u32(vmovl_u16(vget_high_u16(c16))), st[i * 2 + 1]);
+            }
+            for (int64_t r = 0; r < nact; r++) {
+                const char * wrow = wdata + (size_t) r * row_bytes;
+                const uint8_t * tb = (const uint8_t *) wrow + tab_off + (size_t) g * 512;
+                const uint8_t * w = o + 32;
+                // four accumulators in turn, so no add waits on the previous one's latency
+                uint16x8_t a0 = vdupq_n_u16(0), a1 = a0, a2 = a0, a3 = a0;
+                for (int t = 0; t < 32; t++, w += 16, tb += 16) {
+                    const uint8x16_t v = vld1q_u8(w), tv = vld1q_u8(tb);
+                    const uint8x16_t r0 = vqtbl1q_u8(tv, vandq_u8(v, m0f));
+                    const uint8x16_t r1 = vqtbl1q_u8(tv, vshrq_n_u8(v, 4));
+                    a0 = vaddw_u8(a0, vget_low_u8(r0)); a2 = vaddw_u8(a2, vget_low_u8(r1));
+                    a1 = vaddw_high_u8(a1, r0);         a3 = vaddw_high_u8(a3, r1);
+                }
+                const float yd = ((const float *) wrow)[g];
+                float * s = (float *) (dst + (size_t) r * dst_row) + x * 32;
+                const uint16x8_t A[4] = { a0, a1, a2, a3 };
+                for (int i = 0; i < 4; i++, s += 8) {
+                    const int16x8_t si = vreinterpretq_s16_u16(vsubq_u16(A[i], off));
+                    vst1q_f32(s,     vfmaq_f32(vld1q_f32(s),     vmulq_n_f32(d[i * 2],     yd), vcvtq_f32_s32(vmovl_s16(vget_low_s16(si)))));
+                    vst1q_f32(s + 4, vfmaq_f32(vld1q_f32(s + 4), vmulq_n_f32(d[i * 2 + 1], yd), vcvtq_f32_s32(vmovl_s16(vget_high_s16(si)))));
+                }
+            }
+        }
+    }
+}
+#else
+static void q1lut_tables(const float *, void *, int64_t, int64_t, int64_t) { GGML_ABORT("q1lut needs NEON"); }
+static void q1lut_gemm(int64_t, const uint8_t *, const char *, size_t, int64_t, char *, size_t, int64_t, int64_t) { GGML_ABORT("q1lut needs NEON"); }
+#endif
+
