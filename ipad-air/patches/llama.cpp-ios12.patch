+// Flash attention over an F16 KV cache for one-token-at-a-time chat on small ARM cores. The stock path does a
+// dot product, expf and a full V accumulate per context token and q head, so a long chat spends most of its time here.
+// This path does all K dots first, reading each K row once for the two q heads that share it; the softmax maximum is
+// then known, so rows with s < M + ln(eps) skip expf and V entirely. V is accumulated in F32 for the survivors.
+// GGML_FA_EPS=0 keeps every row, GGML_FA_PRUNE=0 uses the stock path.
+#if defined(__ARM_NEON)
+// Dot products of one K head against the RK q heads that share it, in one pass over the K row. Four accumulators per
+// q head, so an FMA never waits on the previous one's latency.
+template <int RK>
+static inline void ggml_fa_dots(const __fp16 * kr, const float * const * qp, const int64_t DK, float * out) {
+    float32x4_t acc[RK][4];
+    for (int r = 0; r < RK; r++) {
+        for (int j = 0; j < 4; j++) {
+            acc[r][j] = vdupq_n_f32(0.0f);
+        }
+    }
+    for (int64_t i = 0; i < DK; i += 16) {
+        for (int j = 0; j < 4; j++) {
+            const float32x4_t kv = vcvt_f32_f16(vld1_f16(kr + i + j * 4));
+            for (int r = 0; r < RK; r++) {
+                acc[r][j] = vfmaq_f32(acc[r][j], kv, vld1q_f32(qp[r] + i + j * 4));
+            }
+        }
+    }
+    for (int r = 0; r < RK; r++) {
+        out[r] = vaddvq_f32(vaddq_f32(vaddq_f32(acc[r][0], acc[r][1]), vaddq_f32(acc[r][2], acc[r][3])));
+    }
+}
+
+// One generated token: the KV cache keeps all heads of a context row side by side, so walk the rows once, each read
+// straight through for every head, instead of striding through memory once per head (2 KB stride, a cache miss per row on
+// a 1 MB L2). Dots and V are split across threads by context rows; each thread keeps its own partial V and S per q head.
+static bool ggml_flash_attn_f16_single(const ggml_compute_params * params, ggml_tensor * dst, const float scale, const float eps) {
+    const ggml_tensor * q = dst->src[0], * k = dst->src[1], * v = dst->src[2], * mask = dst->src[3];
+    const int64_t DK = k->ne[0], n_kv = k->ne[1], n_hkv = k->ne[2], n_head = q->ne[2], rk = n_head / n_hkv;
+    if (q->ne[1] != 1 || n_head > 32 || (rk != 2 && rk != 4) || (mask && (mask->ne[2] != 1 || mask->ne[1] != 1)) ||
+        k->nb[1] != k->nb[2] * n_hkv || v->nb[1] != v->nb[2] * n_hkv ||
+        k->nb[2] != (size_t) DK * sizeof(ggml_fp16_t) || v->nb[2] != k->nb[2]) {
+        return false;
+    }
+    static std::vector<float> sv;        // [n_kv][n_head]
+    static std::vector<float> partials;  // [nth][n_head][2 + DK + pad]: M, S, V
+    const int ith = params->ith, nth = params->nth;
+    const int64_t part_stride = 2 + DK + 14;   // 64-byte multiples for DK = 128
+    if (ith == 0) {
+        sv.resize((size_t) n_kv * n_head);
+        partials.resize((size_t) nth * n_head * part_stride);
+        ggml_threadpool_chunk_set(params->threadpool, 0);
+    }
+    ggml_barrier(params->threadpool);
+
+    const ggml_fp16_t * mp = mask ? (const ggml_fp16_t *) mask->data : nullptr;
+    const int64_t step = 32;
+    float mine_M[32];
+    for (int64_t h = 0; h < n_head; h++) {
+        mine_M[h] = -INFINITY;
+    }
+
+    // 1. all K dots
+    while (true) {
+        const int64_t c0 = ggml_threadpool_chunk_add(params->threadpool, (int) step);
+        if (c0 >= n_kv) {
+            break;
+        }
+        const int64_t c1 = std::min(c0 + step, n_kv);
+        for (int64_t ic = c0; ic < c1; ic++) {
+            float * row_s = sv.data() + ic * n_head;
+            const float mv = mp ? GGML_CPU_FP16_TO_FP32(mp[ic]) : 0.0f;
+            if (mv == -INFINITY) {
+                for (int64_t h = 0; h < n_head; h++) {
+                    row_s[h] = -INFINITY;
+                }
+                continue;
+            }
+            const __fp16 * kr = (const __fp16 *) ((const char *) k->data + ic * k->nb[1]);
+            for (int64_t hk = 0; hk < n_hkv; hk++, kr += DK) {
+                const float * qp[4];
+                for (int64_t r = 0; r < rk; r++) {
+                    qp[r] = (const float *) ((const char *) q->data + (hk * rk + r) * q->nb[2]);
+                }
+                float dots[4];
+                if (rk == 2) {
+                    ggml_fa_dots<2>(kr, qp, DK, dots);
+                } else {
+                    ggml_fa_dots<4>(kr, qp, DK, dots);
+                }
+                for (int64_t r = 0; r < rk; r++) {
+                    const float sr = dots[r] * scale + mv;
+                    row_s[hk * rk + r] = sr;
+                    mine_M[hk * rk + r] = std::max(mine_M[hk * rk + r], sr);
+                }
+            }
+        }
+    }
+    float * mine = partials.data() + (size_t) ith * n_head * part_stride;
+    for (int64_t h = 0; h < n_head; h++) {
+        float * p = mine + h * part_stride;
+        p[0] = mine_M[h];
+        p[1] = 0.0f;
+        memset(p + 2, 0, (size_t) DK * sizeof(float));
+    }
+    ggml_barrier(params->threadpool);   // no thread is claiming dot chunks any more
+    if (ith == 0) {
+        ggml_threadpool_chunk_set(params->threadpool, 0);
+    }
+    ggml_barrier(params->threadpool);
+
+    // the maxima are final now; every thread derives the same thresholds
+    float M[32], T[32];
+    const float ln_eps = eps > 0.0f ? logf(eps) : -INFINITY;
+    for (int64_t h = 0; h < n_head; h++) {
+        float m = -INFINITY;
+        for (int t = 0; t < nth; t++) {
+            m = std::max(m, partials[(size_t) t * n_head * part_stride + h * part_stride]);
+        }
+        M[h] = m;
+        T[h] = m + ln_eps;
+    }
+
+    // 2. V for the survivors, four heads at a time through the vector exp
+    while (true) {
+        const int64_t c0 = ggml_threadpool_chunk_add(params->threadpool, (int) step);
+        if (c0 >= n_kv) {
+            break;
+        }
+        const int64_t c1 = std::min(c0 + step, n_kv);
+        for (int64_t ic = c0; ic < c1; ic++) {
+            const float * row_s = sv.data() + ic * n_head;
+            const __fp16 * vr = (const __fp16 *) ((const char *) v->data + ic * v->nb[1]);
+            for (int64_t h0 = 0; h0 < n_head; h0 += 4) {
+                const int n = (int) std::min<int64_t>(4, n_head - h0);
+                float s4[4] = { -INFINITY, -INFINITY, -INFINITY, -INFINITY }, m4[4] = { 0, 0, 0, 0 };
+                int any = 0;
+                for (int j = 0; j < n; j++) {
+                    if (row_s[h0 + j] != -INFINITY && row_s[h0 + j] >= T[h0 + j]) {
+                        s4[j] = row_s[h0 + j];
+                        m4[j] = M[h0 + j];
+                        any |= 1 << j;
+                    }
+                }
+                if (!any) {
+                    continue;
+                }
+                float e4[4];
+                vst1q_f32(e4, ggml_v_expf(vsubq_f32(vld1q_f32(s4), vld1q_f32(m4))));
+                for (int j = 0; j < n; j++) {
+                    if (!(any & (1 << j))) {
+                        continue;
+                    }
+                    const int64_t h = h0 + j;
+                    float * p = mine + h * part_stride;
+                    p[1] += e4[j];
+                    const __fp16 * vh = vr + (h / rk) * DK;
+                    float * acc = p + 2;
+                    for (int64_t i = 0; i < DK; i += 4) {
+                        vst1q_f32(acc + i, vmlaq_n_f32(vld1q_f32(acc + i), vcvt_f32_f16(vld1_f16(vh + i)), e4[j]));
+                    }
+                }
+            }
+        }
+    }
+    ggml_barrier(params->threadpool);
+
+    // 3. reduce: each thread finishes its share of the q heads
+    for (int64_t h = ith; h < n_head; h += nth) {
+        float S = 0.0f;
+        float * out = (float *) ((char *) dst->data + h * dst->nb[1]);
+        memset(out, 0, (size_t) DK * sizeof(float));
+        for (int t = 0; t < nth; t++) {
+            const float * p = partials.data() + (size_t) t * n_head * part_stride + h * part_stride;
+            S += p[1];
+            for (int64_t i = 0; i < DK; i += 4) {
+                vst1q_f32(out + i, vaddq_f32(vld1q_f32(out + i), vld1q_f32(p + 2 + i)));
+            }
+        }
+        const float S_inv = S == 0.0f ? 0.0f : 1.0f / S;
+        for (int64_t i = 0; i < DK; i += 4) {
+            vst1q_f32(out + i, vmulq_n_f32(vld1q_f32(out + i), S_inv));
+        }
+    }
+    return true;
+}
