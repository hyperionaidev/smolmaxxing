+
+// Four-Russians Q1_0 kernel from the TV work (repack-q1lut-tv.inc); NB_COLS = 32 selects it.
+// GGML_Q1_LUT=0 turns it off, for comparisons.
+static bool q1lut_enabled() {
+    static const bool on = getenv("GGML_Q1_LUT") == nullptr || atoi(getenv("GGML_Q1_LUT")) != 0;
+    return on;
+}
+static void q1lut_run_chunks(const ggml_compute_params * params, const uint8_t * lut, int64_t n, int64_t ngroups, const char * wdata, size_t row_bytes, int64_t nact, char * dst, size_t dst_row) {
+    const int nth = params->nth;
+    const int64_t min_g = MAX(1, ngroups / (16 * nth));
+    while (true) {
+        const int64_t seen = ggml_threadpool_chunk_add(params->threadpool, 0);
+        if (seen >= ngroups) {
+            break;
+        }
+        const int64_t size = MAX(min_g, (ngroups - seen) / (2 * nth));
+        const int64_t start = ggml_threadpool_chunk_add(params->threadpool, (int) size);
+        if (start >= ngroups) {
+            break;
+        }
+        q1lut_gemm(n, lut, wdata, row_bytes, nact, dst, dst_row, start, MIN(start + size, ngroups));
+    }
+}
+
+template <> int repack<block_q1_0, 4, 32>(struct ggml_tensor * t, const void * data, size_t data_size) {
+    return repack_q1_0_to_q1lut_tv(t, data, data_size);
+}
