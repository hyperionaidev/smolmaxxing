+        return cur;
+    }
+    const int64_t n_vocab_full = model.tok_embd->ne[1];
+    ggml_tensor * lt   = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+    ggml_tensor * full = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, lt->ne[0], n_vocab_full);
+    full = ggml_fill_inplace(ctx0, full, -INFINITY);
+    full = ggml_set_rows(ctx0, full, lt, model.output_ids);
+    return ggml_cont(ctx0, ggml_transpose(ctx0, full));
