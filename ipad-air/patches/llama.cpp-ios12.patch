+// a pruned LM head outputs [n_keep, n_out]: scatter into [n_vocab, n_out], with -inf for the dropped tokens
+static ggml_tensor * bailingmoe3_scatter_pruned_logits(ggml_context * ctx0, ggml_tensor * cur, const llama_model & model) {
