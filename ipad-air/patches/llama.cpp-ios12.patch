new file mode 100644
index 0000000..16adbb2
--- /dev/null
+++ b/ggml/src/ggml-cpu/moe-pager-ios.inc
@@ -0,0 +1,498 @@
+// ipad-air: expert pager for mixture-of-experts models bigger than the address space (EXPERIMENT.md section 21.8, included in
+// repack.cpp). iOS caps a process at about 1.7 GB of mappings (E136), so experts can't be mapped at all, not even lazily:
+//  * the GGUF has its expert tensors last (tools/gguf_experts_last.py) and llama.cpp maps only the part before them;
+//  * each *_exps tensor gets a pool of GGML_MOE_POOL slots (per layer, shared by gate/up/down: slot s of each holds the same expert);
+//  * MUL_MAT_ID asks for the experts its rows use (ggml_moe_pager_load), in groups of at most a pool's size; missing ones are read
+//    into least recently used slots with pread by GGML_MOE_READERS threads, and the kernel runs on the slots;
+//  * with one group (token generation), the layer's other expert tensors are queued for the same experts right away, so the up and
+//    down reads overlap the gate matmul;
+//  * cache-aware routing (GGML_MOE_BIAS, from the TV's E87/E90): the argsort that picks experts adds a bonus to experts in the pool.
+// GGML_MOE_NOCACHE=0 reads through the page cache (default: F_NOCACHE), GGML_MOE_STATS=1 prints totals at exit,
+// GGML_MOE_VERIFY=1 compares every load with a second read.
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <condition_variable>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <vector>
+#include <fcntl.h>
+#include <time.h>
+#include <unistd.h>
+
+namespace {
+enum : uint8_t { MPI_EMPTY = 0, MPI_PENDING = 1, MPI_FILLED = 2 };
+struct mpi_tensor {
+    const ggml_tensor * t = nullptr; int layer = 0; int rank = 3; int fd = -1; int64_t off = 0; size_t stride = 0; char * pool = nullptr;
+    std::unique_ptr<std::atomic<uint8_t>[]> st;
+};
+struct mpi_layer {
+    int P = 0;
+    std::vector<int> slot_exp, exp_slot; std::vector<uint64_t> slot_use;
+    std::vector<mpi_tensor *> t;
+    const mpi_tensor * first = nullptr;   // the layer's first MUL_MAT_ID (gate): hits and misses are counted there
+    int ranks = 0;                        // tensors of this layer seen so far, in the order the graph runs them
+    const float * router = nullptr; int64_t router_ne0 = 0, router_ne1 = 0; const float * selbias = nullptr;
+    std::vector<uint8_t> pf;              // slot was filled by a prefetch and not used yet
+    std::vector<float> fs; std::vector<uint32_t> ft; uint32_t step = 0;   // GGML_MOE_LFU: per-expert use score, decayed per call
+};
+// Eviction order. Default: least recently used. GGML_MOE_LFU=a (0 < a < 1): least frequently used, each use adding 1 to a score that
+// decays by a per layer call (E153: at pool 14, a = 0.95 misses 10 % less than LRU on a trace of 3,072 tokens). Empty slots go first.
+float mpi_lfu_alpha() { static const float a = getenv("GGML_MOE_LFU") ? (float) atof(getenv("GGML_MOE_LFU")) : 0.0f; return a; }
+double mpi_evict_key(const mpi_layer & L, int x) {
+    const int e = L.slot_exp[x];
+    const float a = mpi_lfu_alpha();
+    if (a <= 0.0f || e < 0 || L.fs.empty()) { return e < 0 ? -1.0 : (double) L.slot_use[x]; }
+    return L.fs[e] * std::pow((double) a, (double) (L.step - L.ft[e])) + 1e-12 * (double) L.slot_use[x];
+}
+struct mpi_job { mpi_tensor * t; int slot, e; int prio; };
+struct mpi_state {
+    std::vector<mpi_layer> layers = std::vector<mpi_layer>(256);
+    std::vector<std::unique_ptr<mpi_tensor>> tensors;
+    std::mutex mu; std::condition_variable cv_work, cv_done;
+    std::deque<mpi_job> q;
+    int pool = 0; bool verify = false; uint64_t stamp = 0; int now_layer = 0;
+    std::vector<const char *> ptrs = std::vector<const char *>(1024);
+    std::atomic<long> rd_bytes{0}, hits{0}, miss{0}, wait_ns{0}, loads{0}, sib{0}, pf_req{0}, pf_used{0}, stale{0};
+};
+mpi_state & mpi_get() { static mpi_state s; return s; }
+int64_t mpi_now() { timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (int64_t) t.tv_sec * 1000000000 + t.tv_nsec; }
+
+void mpi_read(int fd, char * dst, size_t n, int64_t off) {
+    while (n) {
+        const ssize_t r = pread(fd, dst, n, (off_t) off);
+        if (r <= 0) { GGML_ABORT("moe pager: read failed at %lld", (long long) off); }
+        dst += r; n -= (size_t) r; off += r;
+    }
+}
+void mpi_reader() {
+    mpi_state & s = mpi_get();
+    for (;;) {
+        mpi_job j;
+        {
+            std::unique_lock<std::mutex> lk(s.mu);
+            for (;;) {
+                s.cv_work.wait(lk, [&] { return !s.q.empty(); });
+                j = s.q.front(); s.q.pop_front();
+                // a read for a layer the graph has already passed (a wrong prefetch) is dropped; the slot stays assigned but empty,
+                // so a later request for that expert queues the read again
+                if (j.t->layer < s.now_layer) { j.t->st[j.slot].store(MPI_EMPTY, std::memory_order_release); s.stale++; s.cv_done.notify_all(); continue; }
+                break;
+            }
+        }
+        mpi_tensor & t = *j.t;
+        char * dst = t.pool + (size_t) j.slot * t.stride;
+        mpi_read(t.fd, dst, t.stride, t.off + (int64_t) j.e * (int64_t) t.stride);
+        s.rd_bytes += (long) t.stride;
+        if (s.verify) {
+            std::vector<char> ref(t.stride);
+            mpi_read(t.fd, ref.data(), t.stride, t.off + (int64_t) j.e * (int64_t) t.stride);
+            if (memcmp(ref.data(), dst, t.stride) != 0) { GGML_ABORT("moe pager VERIFY: %s expert %d differs", t.t->name, j.e); }
+        }
+        {
+            std::lock_guard<std::mutex> lk(s.mu);
+            t.st[j.slot].store(MPI_FILLED, std::memory_order_release);
+        }
+        s.cv_done.notify_all();
+    }
+}
+void mpi_stats() {
+    mpi_state & s = mpi_get();
+    fprintf(stderr, "moe-pager: pool %d per layer: %ld hits, %ld misses (%.1f %%), %ld loads (%ld ahead of use), read %.1f MB, waited %.2f s; prefetched %ld, %ld used, %ld stale reads dropped\n",
+            s.pool, s.hits.load(), s.miss.load(), 100.0 * s.miss.load() / (s.hits.load() + s.miss.load() + 1e-9), s.loads.load(), s.sib.load(),
+            s.rd_bytes.load() / 1e6, s.wait_ns.load() / 1e9, s.pf_req.load(), s.pf_used.load(), s.stale.load());
+}
+bool mpi_slot_busy(const mpi_layer & L, int slot) {
+    for (auto * t : L.t) { if (t->st[slot].load(std::memory_order_acquire) == MPI_PENDING) { return true; } }
+    return false;
+}
+// queue reads for slot s of tensor t (caller holds s.mu)
+// reads are served in the order the graph will need them: by layer, then by the tensor's place in the layer (gate, up, down), first
+// come first served within that. A prefetch for layer L+1 therefore never delays layer L's up and down reads.
+void mpi_queue(mpi_state & s, mpi_tensor & t, int slot, int e, bool front) {
+    (void) front;
+    if (t.st[slot].load(std::memory_order_acquire) != MPI_EMPTY) { return; }
+    t.st[slot].store(MPI_PENDING, std::memory_order_release);
+    const int prio = t.layer * 4 + t.rank;
+    auto it = s.q.end();
+    while (it != s.q.begin() && std::prev(it)->prio > prio) { --it; }
+    s.q.insert(it, { &t, slot, e, prio });
+    s.loads++;
+}
+void mpi_pregate_one(mpi_state & s, int lt, const float * xv, int64_t xn);
+}  // namespace
+
+extern "C" {
+int ggml_moe_pager_active = 0;
+
+void ggml_backend_cpu_moe_pager_register(struct ggml_tensor * t, int fd, int64_t off) {
+    mpi_state & s = mpi_get();
+    if (s.pool == 0) {
+        s.pool = getenv("GGML_MOE_POOL") ? atoi(getenv("GGML_MOE_POOL")) : 16;
+        s.verify = getenv("GGML_MOE_VERIFY") != nullptr;
+        const int n = getenv("GGML_MOE_READERS") ? atoi(getenv("GGML_MOE_READERS")) : 4;
+        for (int i = 0; i < n; i++) { std::thread(mpi_reader).detach(); }
+        if (getenv("GGML_MOE_STATS")) { atexit(mpi_stats); }
+    }
+    GGML_ASSERT(ggml_n_dims(t) == 3 && strncmp(t->name, "blk.", 4) == 0);
+    auto x = std::make_unique<mpi_tensor>();
+    x->t = t; x->layer = atoi(t->name + 4) & 255; x->off = off; x->stride = t->nb[2];
+    GGML_ASSERT(x->stride * (size_t) t->ne[2] == ggml_nbytes(t));
+    // a separate descriptor per tensor file: F_NOCACHE is per open file, and the model loader keeps reading through its own
+    x->fd = -1;
+#if defined(__APPLE__)
+    char path[PATH_MAX];
+    if (fcntl(fd, F_GETPATH, path) == 0) { x->fd = open(path, O_RDONLY); }
+#endif
+    if (x->fd < 0) { x->fd = dup(fd); }
+    GGML_ASSERT(x->fd >= 0);
+#if defined(__APPLE__)
+    if (!getenv("GGML_MOE_NOCACHE") || atoi(getenv("GGML_MOE_NOCACHE"))) { fcntl(x->fd, F_NOCACHE, 1); }
+#endif
+    mpi_layer & L = s.layers[x->layer];
+    const int P = std::min(s.pool, (int) t->ne[2]);
+    if (L.P == 0) {
+        L.P = P; L.slot_exp.assign(P, -1); L.exp_slot.assign((size_t) t->ne[2], -1); L.slot_use.assign(P, 0); L.pf.assign(P, 0);
+    }
+    GGML_ASSERT(L.P == P && (int) L.exp_slot.size() == (int) t->ne[2]);
+    void * mem = nullptr;
+    GGML_ASSERT(posix_memalign(&mem, 16384, (size_t) P * x->stride) == 0);
+    x->pool = (char *) mem;
+    x->st.reset(new std::atomic<uint8_t>[P]);
+    for (int i = 0; i < P; i++) { x->st[i].store(MPI_EMPTY); }
+    t->data = x->pool;   // only slots < P are ever addressed: MUL_MAT_ID goes through ggml_moe_pager_load
+    L.t.push_back(x.get());
+    s.tensors.push_back(std::move(x));
+    ggml_moe_pager_active = 1;
+}
+
+void * ggml_moe_pager_find(const struct ggml_tensor * t) {
+    for (auto & x : mpi_get().tensors) { if (x->t == t) { return x.get(); } }
+    return nullptr;
+}
+int ggml_moe_pager_pool(const void * pg) { return mpi_get().layers[((const mpi_tensor *) pg)->layer].P; }
+
+// is expert e of layer il in its pool (for cache-aware routing)?
+bool ggml_moe_pager_cached(int il, int e) {
+    const mpi_layer & L = mpi_get().layers[il & 255];
+    return L.P > 0 && e >= 0 && e < (int) L.exp_slot.size() && L.exp_slot[e] >= 0;
+}
+
+// the layer's expert selection bias (exp_probs_b), or null: the adaptive expert count needs the unbiased probabilities
+const float * ggml_moe_pager_selbias_ptr(int il) { return mpi_get().layers[il & 255].selbias; }
+
+// thread 0 of MUL_MAT_ID: make experts[0..n) of tensor pg resident (n <= pool); returns their data pointers.
+// siblings: also queue the layer's other expert tensors for the same experts (token generation).
+const char ** ggml_moe_pager_load(void * pg, const int32_t * experts, int n, bool siblings) {
+    mpi_state & s = mpi_get();
+    if (!pg) { return s.ptrs.data(); }
+    mpi_tensor & T = *(mpi_tensor *) pg;
+    mpi_layer & L = s.layers[T.layer];
+    GGML_ASSERT(n <= L.P);
+    const int64_t t0 = mpi_now();
+    if (!L.first) { L.first = &T; }
+    if (&T == L.first) {   // GGML_MOE_TRACE=file: one line per layer call, "layer e0 e1 ...", for offline cache-policy studies
+        static FILE * tr = getenv("GGML_MOE_TRACE") ? fopen(getenv("GGML_MOE_TRACE"), "w") : nullptr;
+        if (tr) { fprintf(tr, "%d", T.layer); for (int i = 0; i < n; i++) { fprintf(tr, " %d", experts[i]); } fputc('\n', tr); }
+    }
+    std::unique_lock<std::mutex> lk(s.mu);
+    if (T.rank == 3 && L.ranks < 3) { T.rank = L.ranks++; }
+    s.now_layer = T.layer;
+    const uint64_t stamp = ++s.stamp;
+    for (int i = 0; i < n; i++) {
+        const int e = experts[i];
+        if (L.exp_slot[e] >= 0) { L.slot_use[L.exp_slot[e]] = stamp; }
+    }
+    if (&T == L.first && mpi_lfu_alpha() > 0.0f) {
+        if (L.fs.empty()) { L.fs.assign(L.exp_slot.size(), 0.0f); L.ft.assign(L.exp_slot.size(), 0); }
+        L.step++;
+        const double a = mpi_lfu_alpha();
+        for (int i = 0; i < n; i++) {
+            const int e = experts[i];
+            L.fs[e] = (float) (L.fs[e] * std::pow(a, (double) (L.step - L.ft[e])) + 1.0); L.ft[e] = L.step;
+        }
+    }
+    for (int i = 0; i < n; i++) {
+        const int e = experts[i];
+        if (L.exp_slot[e] >= 0) {
+            if (&T == L.first) { s.hits++; }
+            if (L.pf[L.exp_slot[e]]) { L.pf[L.exp_slot[e]] = 0; s.pf_used++; }
+            continue;
+        }
+        if (&T == L.first) { s.miss++; }
+        int v = -1;
+        for (;;) {
+            for (int x = 0; x < L.P; x++) {
+                if (L.slot_use[x] == stamp || mpi_slot_busy(L, x)) { continue; }
+                if (v < 0 || mpi_evict_key(L, x) < mpi_evict_key(L, v)) { v = x; }
+            }
+            if (v >= 0) { break; }
+            s.cv_done.wait(lk);   // every free slot has a read in flight: wait for one
+        }
+        if (L.slot_exp[v] >= 0) { L.exp_slot[L.slot_exp[v]] = -1; }
+        for (auto * t : L.t) { t->st[v].store(MPI_EMPTY, std::memory_order_release); }
+        L.slot_exp[v] = e; L.exp_slot[e] = v; L.slot_use[v] = stamp; L.pf[v] = 0;
+    }
+    // this tensor's reads first (front of the queue, in order), then the siblings' at the back
+    for (int i = n - 1; i >= 0; i--) { mpi_queue(s, T, L.exp_slot[experts[i]], experts[i], true); }
+    if (siblings) {
+        for (auto * t : L.t) {
+            if (t == &T) { continue; }
+            for (int i = 0; i < n; i++) {
+                const long before = s.loads.load();
+                mpi_queue(s, *t, L.exp_slot[experts[i]], experts[i], false);
+                if (s.loads.load() != before) { s.sib++; }
+            }
+        }
+    }
+    lk.unlock();
+    s.cv_work.notify_all();
+    for (int i = 0; i < n; i++) {
+        const int slot = L.exp_slot[experts[i]];
+        if (T.st[slot].load(std::memory_order_acquire) != MPI_FILLED) {
+            std::unique_lock<std::mutex> lw(s.mu);
+            s.cv_done.wait(lw, [&] { return T.st[slot].load(std::memory_order_acquire) == MPI_FILLED; });
+        }
+        s.ptrs[i] = T.pool + (size_t) slot * T.stride;
+    }
+    s.wait_ns += mpi_now() - t0;
+    return s.ptrs.data();
+}
+
+void ggml_moe_pager_selbias(int il, const struct ggml_tensor * b) {
+    mpi_layer & L = mpi_get().layers[il & 255];
+    if (L.P > 0 && b->type == GGML_TYPE_F32 && b->ne[0] == (int64_t) L.exp_slot.size()) { L.selbias = (const float *) b->data; }
+}
+
+// pre-gating (the TV's E103), thread 0 at layer il's router: w is that router, x its input (one token). Layer il+1's router is applied
+// to x with the same decision the model makes (sigmoid, selection bias, group limit, top-k, cache bonus), and its predicted experts
+// that aren't in the pool are read in the background, behind any urgent reads. GGML_MOE_PREFETCH=1 turns it on (off by default; the
+// recommended iPad setting turns it on: once reads are queued in priority order it gains, E146-E147, where E144's first-come queue
+// gained nothing); GGML_MOE_PREFETCH_K=k prefetches only the k most likely, GGML_MOE_PREFETCH_AHEAD=n looks n layers ahead.
+void ggml_moe_pager_pregate(const struct ggml_tensor * w, const struct ggml_tensor * x, int il) {
+    static const int on = getenv("GGML_MOE_PREFETCH") ? atoi(getenv("GGML_MOE_PREFETCH")) : 0;
+    mpi_state & s = mpi_get();
+    mpi_layer & Lc = s.layers[il & 255];
+    if (w->type != GGML_TYPE_F32 || Lc.P == 0) { return; }
+    Lc.router = (const float *) w->data; Lc.router_ne0 = w->ne[0]; Lc.router_ne1 = w->ne[1];
+    { std::lock_guard<std::mutex> lk(s.mu); s.now_layer = il; }   // a new token starts back at the first layers
+    static const int ahead = getenv("GGML_MOE_PREFETCH_AHEAD") ? atoi(getenv("GGML_MOE_PREFETCH_AHEAD")) : 1;
+    if (!on || x->ne[1] != 1 || x->type != GGML_TYPE_F32) { return; }
+    for (int a = 1; a <= ahead && il + a <= 255; a++) { mpi_pregate_one(s, il + a, (const float *) x->data, x->ne[0]); }
+}
+}  // extern "C"
+
+namespace {
+void mpi_pregate_one(mpi_state & s, int lt, const float * xv, int64_t xn) {
+    static const int n_group = getenv("GGML_MOE_GROUPS") ? atoi(getenv("GGML_MOE_GROUPS")) : 8;
+    static const int n_group_used = getenv("GGML_MOE_GROUPS_USED") ? atoi(getenv("GGML_MOE_GROUPS_USED")) : 4;
+    static const int k = getenv("GGML_MOE_USED") ? atoi(getenv("GGML_MOE_USED")) : 8;
+    static const float bonus = getenv("GGML_MOE_BIAS") ? (float) atof(getenv("GGML_MOE_BIAS")) : 0.0f;
+    static const int max_inflight = getenv("GGML_MOE_PREFETCH_INFLIGHT") ? atoi(getenv("GGML_MOE_PREFETCH_INFLIGHT")) : 48;
+    mpi_layer & L = s.layers[lt];
+    if (L.P == 0 || !L.router || L.router_ne0 != xn || L.router_ne1 != (int64_t) L.exp_slot.size()) { return; }
+    const int n_exp = (int) L.router_ne1;
+    std::vector<float> sc(n_exp);
+    for (int e = 0; e < n_exp; e++) {
+        const float * r = L.router + (int64_t) e * L.router_ne0;
+        float a = 0.0f;
+        int64_t j = 0;
+#if defined(__ARM_NEON)
+        float32x4_t s0 = vdupq_n_f32(0), s1 = s0, s2 = s0, s3 = s0;
+        for (; j + 16 <= L.router_ne0; j += 16) {
+            s0 = vfmaq_f32(s0, vld1q_f32(r + j), vld1q_f32(xv + j));         s1 = vfmaq_f32(s1, vld1q_f32(r + j + 4), vld1q_f32(xv + j + 4));
+            s2 = vfmaq_f32(s2, vld1q_f32(r + j + 8), vld1q_f32(xv + j + 8)); s3 = vfmaq_f32(s3, vld1q_f32(r + j + 12), vld1q_f32(xv + j + 12));
+        }
+        a = vaddvq_f32(vaddq_f32(vaddq_f32(s0, s1), vaddq_f32(s2, s3)));
+#endif
+        for (; j < L.router_ne0; j++) { a += r[j] * xv[j]; }
+        float p = 1.0f / (1.0f + expf(-a));
+        if (L.selbias) { p += L.selbias[e]; }
+        if (bonus != 0.0f && L.exp_slot[e] >= 0) { p += bonus; }
+        sc[e] = p;
+    }
+    // group limit: groups ranked by the sum of their two best scores, the best n_group_used kept
+    if (n_group > 1 && n_exp % n_group == 0 && n_group_used < n_group) {
+        const int gs = n_exp / n_group;
+        std::vector<std::pair<float, int>> gscore(n_group);
+        for (int g = 0; g < n_group; g++) {
+            float b1 = -INFINITY, b2 = -INFINITY;
+            for (int e = g * gs; e < (g + 1) * gs; e++) { if (sc[e] > b1) { b2 = b1; b1 = sc[e]; } else if (sc[e] > b2) { b2 = sc[e]; } }
+            gscore[g] = { b1 + b2, g };
+        }
+        std::sort(gscore.begin(), gscore.end(), [](auto & a, auto & b) { return a.first > b.first; });
+        for (int i = n_group_used; i < n_group; i++) { const int g = gscore[i].second; for (int e = g * gs; e < (g + 1) * gs; e++) { sc[e] = -INFINITY; } }
+    }
+    std::vector<int> idx(n_exp);
+    for (int e = 0; e < n_exp; e++) { idx[e] = e; }
+    std::partial_sort(idx.begin(), idx.begin() + k, idx.end(), [&](int a, int b) { return sc[a] > sc[b]; });
+    std::unique_lock<std::mutex> lk(s.mu);
+    const uint64_t stamp = ++s.stamp;
+    for (int i = 0; i < k; i++) { const int e = idx[i]; if (L.exp_slot[e] >= 0) { L.slot_use[L.exp_slot[e]] = stamp; } }
+    bool queued = false;
+    static const int kpf = getenv("GGML_MOE_PREFETCH_K") ? atoi(getenv("GGML_MOE_PREFETCH_K")) : k;   // only the kpf most likely
+    for (int i = 0; i < std::min(k, kpf) && (int) s.q.size() + 3 <= max_inflight; i++) {
+        const int e = idx[i];
+        if (L.exp_slot[e] >= 0) { continue; }
+        int v = -1;
+        for (int x2 = 0; x2 < L.P; x2++) {
+            if (L.slot_use[x2] == stamp || mpi_slot_busy(L, x2)) { continue; }
+            if (v < 0 || mpi_evict_key(L, x2) < mpi_evict_key(L, v)) { v = x2; }
+        }
+        if (v < 0) { break; }
+        if (L.slot_exp[v] >= 0) { L.exp_slot[L.slot_exp[v]] = -1; }
+        for (auto * t : L.t) { t->st[v].store(MPI_EMPTY, std::memory_order_release); }
+        L.slot_exp[v] = e; L.exp_slot[e] = v; L.slot_use[v] = stamp; L.pf[v] = 1;
+        for (auto * t : L.t) { mpi_queue(s, *t, v, e, false); }
+        s.pf_req++; queued = true;
+    }
+    lk.unlock();
+    if (queued) { s.cv_work.notify_all(); }
+}
