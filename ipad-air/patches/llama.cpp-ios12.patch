 }
 
+// Flash attention over an F16 KV cache for one-token-at-a-time chat on small ARM cores. The stock path does a
+// dot product, expf and a full V accumulate per context token and q head, so a long chat spends most of its time here.
+// This path does all K dots first, reading each K row once for the two q heads that share it; the softmax maximum is
+// then known, so rows with s < M + ln(eps) skip expf and V entirely. V is accumulated in F32 for the survivors.
+// GGML_FA_EPS=0 keeps every row, GGML_FA_PRUNE=0 uses the stock path.
+#if defined(__ARM_NEON)
+// One generated token: the KV cache keeps all heads of a context row side by side, so walk the rows once, each read
+// straight through for every head, instead of striding through memory once per head (2 KB stride, a cache miss per row on
+// a 1 MB L2). Dots and V are split across threads by context rows; each thread keeps its own partial V and S per q head.
+static bool ggml_flash_attn_f16_single(const ggml_compute_params * params, ggml_tensor * dst, const float scale, const float eps) {
+    const ggml_tensor * q = dst->src[0], * k = dst->src[1], * v = dst->src[2], * mask = dst->src[3];
+    const int64_t DK = k->ne[0], n_kv = k->ne[1], n_hkv = k->ne[2], n_head = q->ne[2];
+    if (q->ne[1] != 1 || n_head > 32 || (mask && (mask->ne[2] != 1 || mask->ne[1] != 1)) ||
+        k->nb[1] != k->nb[2] * n_hkv || v->nb[1] != v->nb[2] * n_hkv ||
+        k->nb[2] != (size_t) DK * sizeof(ggml_fp16_t) || v->nb[2] != k->nb[2]) {
+        return false;
+    }
+    static std::vector<float> sv;        // [n_kv][n_head]
+    static std::vector<float> partials;  // [nth][n_head][2 + DK + pad]: M, S, V
+    const int ith = params->ith, nth = params->nth;
+    const int64_t part_stride = 2 + DK + 14;   // 64-byte multiples for DK = 128
+    if (ith == 0) {
+        sv.resize((size_t) n_kv * n_head);
+        partials.resize((size_t) nth * n_head * part_stride);
+        ggml_threadpool_chunk_set(params->threadpool, 0);
+    }
+    ggml_barrier(params->threadpool);
+
+    const ggml_fp16_t * mp = mask ? (const ggml_fp16_t *) mask->data : nullptr;
+    const int64_t step = 32;
+    float mine_M[32];
+    for (int64_t h = 0; h < n_head; h++) {
+        mine_M[h] = -INFINITY;
+    }
+
+    // 1. all K dots
+    while (true) {
+        const int64_t c0 = ggml_threadpool_chunk_add(params->threadpool, (int) step);
+        if (c0 >= n_kv) {
+            break;
+        }
+        const int64_t c1 = std::min(c0 + step, n_kv);
+        for (int64_t ic = c0; ic < c1; ic++) {
+            float * row_s = sv.data() + ic * n_head;
+            const float mv = mp ? GGML_CPU_FP16_TO_FP32(mp[ic]) : 0.0f;
+            if (mv == -INFINITY) {
+                for (int64_t h = 0; h < n_head; h++) {
+                    row_s[h] = -INFINITY;
+                }
+                continue;
+            }
+            const __fp16 * kr = (const __fp16 *) ((const char *) k->data + ic * k->nb[1]);
+            for (int64_t hk = 0; hk < n_hkv; hk++, kr += DK) {
+                const float * q0 = (const float *) ((const char *) q->data + (hk * 2 + 0) * q->nb[2]);
+                const float * q1 = (const float *) ((const char *) q->data + (hk * 2 + 1) * q->nb[2]);
+                float32x4_t a0 = vdupq_n_f32(0.0f), a1 = a0, a2 = a0, a3 = a0, b0 = a0, b1 = a0, b2 = a0, b3 = a0;
+                for (int64_t i = 0; i < DK; i += 16) {
+                    const float32x4_t k_0 = vcvt_f32_f16(vld1_f16(kr + i)),     k_1 = vcvt_f32_f16(vld1_f16(kr + i + 4));
+                    const float32x4_t k_2 = vcvt_f32_f16(vld1_f16(kr + i + 8)), k_3 = vcvt_f32_f16(vld1_f16(kr + i + 12));
+                    a0 = vfmaq_f32(a0, k_0, vld1q_f32(q0 + i));      b0 = vfmaq_f32(b0, k_0, vld1q_f32(q1 + i));
+                    a1 = vfmaq_f32(a1, k_1, vld1q_f32(q0 + i + 4));  b1 = vfmaq_f32(b1, k_1, vld1q_f32(q1 + i + 4));
+                    a2 = vfmaq_f32(a2, k_2, vld1q_f32(q0 + i + 8));  b2 = vfmaq_f32(b2, k_2, vld1q_f32(q1 + i + 8));
+                    a3 = vfmaq_f32(a3, k_3, vld1q_f32(q0 + i + 12)); b3 = vfmaq_f32(b3, k_3, vld1q_f32(q1 + i + 12));
+                }
+                const float s0 = vaddvq_f32(vaddq_f32(vaddq_f32(a0, a1), vaddq_f32(a2, a3))) * scale + mv;
+                const float s1 = vaddvq_f32(vaddq_f32(vaddq_f32(b0, b1), vaddq_f32(b2, b3))) * scale + mv;
+                row_s[hk * 2]     = s0;
+                row_s[hk * 2 + 1] = s1;
+                mine_M[hk * 2]     = std::max(mine_M[hk * 2], s0);
+                mine_M[hk * 2 + 1] = std::max(mine_M[hk * 2 + 1], s1);
+            }
+        }
+    }
+    float * mine = partials.data() + (size_t) ith * n_head * part_stride;
+    for (int64_t h = 0; h < n_head; h++) {
+        float * p = mine + h * part_stride;
+        p[0] = mine_M[h];
+        p[1] = 0.0f;
+        memset(p + 2, 0, (size_t) DK * sizeof(float));
+    }
+    ggml_barrier(params->threadpool);   // no thread is claiming dot chunks any more
+    if (ith == 0) {
+        ggml_threadpool_chunk_set(params->threadpool, 0);
+    }
+    ggml_barrier(params->threadpool);
+
+    // the maxima are final now; every thread derives the same thresholds
+    float M[32], T[32];
+    const float ln_eps = eps > 0.0f ? logf(eps) : -INFINITY;
+    for (int64_t h = 0; h < n_head; h++) {
+        float m = -INFINITY;
+        for (int t = 0; t < nth; t++) {
+            m = std::max(m, partials[(size_t) t * n_head * part_stride + h * part_stride]);
+        }
+        M[h] = m;
+        T[h] = m + ln_eps;
+    }
+
+    // 2. V for the survivors, four heads at a time through the vector exp
+    while (true) {
+        const int64_t c0 = ggml_threadpool_chunk_add(params->threadpool, (int) step);
+        if (c0 >= n_kv) {
+            break;
+        }
+        const int64_t c1 = std::min(c0 + step, n_kv);
+        for (int64_t ic = c0; ic < c1; ic++) {
+            const float * row_s = sv.data() + ic * n_head;
+            const __fp16 * vr = (const __fp16 *) ((const char *) v->data + ic * v->nb[1]);
+            for (int64_t h0 = 0; h0 < n_head; h0 += 4) {
+                const int n = (int) std::min<int64_t>(4, n_head - h0);
+                float s4[4] = { -INFINITY, -INFINITY, -INFINITY, -INFINITY }, m4[4] = { 0, 0, 0, 0 };
+                int any = 0;
+                for (int j = 0; j < n; j++) {
+                    if (row_s[h0 + j] != -INFINITY && row_s[h0 + j] >= T[h0 + j]) {
+                        s4[j] = row_s[h0 + j];
+                        m4[j] = M[h0 + j];
+                        any |= 1 << j;
+                    }
+                }
+                if (!any) {
+                    continue;
+                }
+                float e4[4];
+                vst1q_f32(e4, ggml_v_expf(vsubq_f32(vld1q_f32(s4), vld1q_f32(m4))));
+                for (int j = 0; j < n; j++) {
+                    if (!(any & (1 << j))) {
+                        continue;
+                    }
+                    const int64_t h = h0 + j;
+                    float * p = mine + h * part_stride;
+                    p[1] += e4[j];
+                    const __fp16 * vh = vr + (h / 2) * DK;
+                    float * acc = p + 2;
+                    for (int64_t i = 0; i < DK; i += 4) {
+                        vst1q_f32(acc + i, vmlaq_n_f32(vld1q_f32(acc + i), vcvt_f32_f16(vld1_f16(vh + i)), e4[j]));
+                    }
+                }
+            }
+        }
+    }
+    ggml_barrier(params->threadpool);
+
+    // 3. reduce: each thread finishes its share of the q heads
+    for (int64_t h = ith; h < n_head; h += nth) {
+        float S = 0.0f;
+        float * out = (float *) ((char *) dst->data + h * dst->nb[1]);
+        memset(out, 0, (size_t) DK * sizeof(float));
+        for (int t = 0; t < nth; t++) {
+            const float * p = partials.data() + (size_t) t * n_head * part_stride + h * part_stride;
+            S += p[1];
+            for (int64_t i = 0; i < DK; i += 4) {
+                vst1q_f32(out + i, vaddq_f32(vld1q_f32(out + i), vld1q_f32(p + 2 + i)));
+            }
+        }
+        const float S_inv = S == 0.0f ? 0.0f : 1.0f / S;
+        for (int64_t i = 0; i < DK; i += 4) {
+            vst1q_f32(out + i, vmulq_n_f32(vld1q_f32(out + i), S_inv));
+        }
+    }
+    return true;
+}
+
+static bool ggml_flash_attn_f16_pruned(const ggml_compute_params * params, ggml_tensor * dst) {
+    static const bool  on  = getenv("GGML_FA_PRUNE") == nullptr || atoi(getenv("GGML_FA_PRUNE")) != 0;
+    static const float eps = getenv("GGML_FA_EPS") ? (float) atof(getenv("GGML_FA_EPS")) : 1e-3f;
+    const ggml_tensor * q = dst->src[0], * k = dst->src[1], * v = dst->src[2], * mask = dst->src[3], * sinks = dst->src[4], * kv_rows = dst->src[5];
+    float scale = 1.0f, max_bias = 0.0f, softcap = 0.0f;
+    memcpy(&scale,    (float *) dst->op_params + 0, sizeof(float));
+    memcpy(&max_bias, (float *) dst->op_params + 1, sizeof(float));
+    memcpy(&softcap,  (float *) dst->op_params + 2, sizeof(float));
+    if (!on || params->use_ref || sinks || kv_rows || max_bias != 0.0f || softcap != 0.0f ||
+        q->type != GGML_TYPE_F32 || k->type != GGML_TYPE_F16 || v->type != GGML_TYPE_F16 ||
+        q->ne[3] != 1 || k->ne[3] != 1 || v->ne[3] != 1 || k->ne[2] != v->ne[2] || q->ne[2] != 2 * k->ne[2] ||
+        k->ne[0] != v->ne[0] || q->ne[0] != k->ne[0] || k->ne[0] % 16 != 0 || k->ne[0] > 1024) {
+        return false;
+    }
+    if (ggml_flash_attn_f16_single(params, dst, scale, eps)) {
+        return true;
+    }
+    const int64_t DK = k->ne[0], N = q->ne[1], n_kv = k->ne[1], n_hkv = k->ne[2];
+    const int64_t n_chunk = N * n_hkv;
+    if (params->ith == 0) {
+        ggml_threadpool_chunk_set(params->threadpool, 0);
+    }
+    ggml_barrier(params->threadpool);
+
+    static thread_local std::vector<float> sv;
+    sv.resize((size_t) n_kv * 2);
+    const float ln_eps = eps > 0.0f ? logf(eps) : -INFINITY;
+    float32x4_t V[1024 / 4];
+
+    while (true) {
+        const int64_t c = ggml_threadpool_chunk_add(params->threadpool, 1);
+        if (c >= n_chunk) {
+            break;
+        }
+        const int64_t iq1 = c / n_hkv, ik2 = c % n_hkv;
+        const float * q0 = (const float *) ((const char *) q->data + iq1 * q->nb[1] + (ik2 * 2 + 0) * q->nb[2]);
+        const float * q1 = (const float *) ((const char *) q->data + iq1 * q->nb[1] + (ik2 * 2 + 1) * q->nb[2]);
+        const bool mask_shared = mask && mask->ne[2] == 1;
+        const ggml_fp16_t * mp0 = mask_shared ? (const ggml_fp16_t *) ((const char *) mask->data + iq1 * mask->nb[1]) : nullptr;
+
+        // 1. all K dots, one pass over each K row for both q heads
+        const char * k0 = (const char *) k->data + ik2 * k->nb[2];
+        for (int64_t ic = 0; ic < n_kv; ic++) {
+            if (mp0 && GGML_CPU_FP16_TO_FP32(mp0[ic]) == -INFINITY) {
+                sv[ic * 2] = sv[ic * 2 + 1] = -INFINITY;
+                continue;
+            }
+            const __fp16 * kr = (const __fp16 *) (k0 + ic * k->nb[1]);
+            float32x4_t a0 = vdupq_n_f32(0.0f), a1 = a0, a2 = a0, a3 = a0, b0 = a0, b1 = a0, b2 = a0, b3 = a0;
+            for (int64_t i = 0; i < DK; i += 16) {
+                const float32x4_t k_0 = vcvt_f32_f16(vld1_f16(kr + i)),     k_1 = vcvt_f32_f16(vld1_f16(kr + i + 4));
+                const float32x4_t k_2 = vcvt_f32_f16(vld1_f16(kr + i + 8)), k_3 = vcvt_f32_f16(vld1_f16(kr + i + 12));
+                a0 = vfmaq_f32(a0, k_0, vld1q_f32(q0 + i));      b0 = vfmaq_f32(b0, k_0, vld1q_f32(q1 + i));
+                a1 = vfmaq_f32(a1, k_1, vld1q_f32(q0 + i + 4));  b1 = vfmaq_f32(b1, k_1, vld1q_f32(q1 + i + 4));
+                a2 = vfmaq_f32(a2, k_2, vld1q_f32(q0 + i + 8));  b2 = vfmaq_f32(b2, k_2, vld1q_f32(q1 + i + 8));
+                a3 = vfmaq_f32(a3, k_3, vld1q_f32(q0 + i + 12)); b3 = vfmaq_f32(b3, k_3, vld1q_f32(q1 + i + 12));
+            }
+            sv[ic * 2]     = vaddvq_f32(vaddq_f32(vaddq_f32(a0, a1), vaddq_f32(a2, a3))) * scale;
+            sv[ic * 2 + 1] = vaddvq_f32(vaddq_f32(vaddq_f32(b0, b1), vaddq_f32(b2, b3))) * scale;
+        }
+
+                // 2-3. per q head: maximum, then V for the survivors
+        const char * v0 = (const char *) v->data + ik2 * v->nb[2];
+        for (int64_t r = 0; r < 2; r++) {
+            const int64_t h = ik2 * 2 + r;
+            const ggml_fp16_t * mp = mask_shared ? mp0 : (mask ? (const ggml_fp16_t *) ((const char *) mask->data + iq1 * mask->nb[1] + (h % mask->ne[2]) * mask->nb[2]) : nullptr);
+            float M = -INFINITY;
+            for (int64_t ic = 0; ic < n_kv; ic++) {
+                float s = sv[ic * 2 + r];
+                if (mp && s != -INFINITY) {
+                    const float mv = GGML_CPU_FP16_TO_FP32(mp[ic]);
+                    s = mv == -INFINITY ? -INFINITY : s + mv;
+                    sv[ic * 2 + r] = s;
+                }
+                if (s > M) {
+                    M = s;
+                }
+            }
+            float S = 0.0f;
+            for (int64_t i = 0; i < DK / 4; i++) {
+                V[i] = vdupq_n_f32(0.0f);
+            }
+            const float t = M + ln_eps;
+            for (int64_t ic = 0; ic < n_kv; ic++) {
+                const float s = sv[ic * 2 + r];
+                if (s == -INFINITY || !(s >= t)) {
+                    continue;
+                }
+                const float vs = expf(s - M);
+                S += vs;
+                const __fp16 * vr = (const __fp16 *) (v0 + ic * v->nb[1]);
+                for (int64_t i = 0; i < DK / 4; i++) {
+                    V[i] = vmlaq_n_f32(V[i], vcvt_f32_f16(vld1_f16(vr + i * 4)), vs);
+                }
+            }
+            const float S_inv = S == 0.0f ? 0.0f : 1.0f / S;
+            float * out = (float *) ((char *) dst->data + (h + iq1 * dst->ne[1]) * dst->nb[1]);
+            for (int64_t i = 0; i < DK / 4; i++) {
+                vst1q_f32(out + i * 4, vmulq_n_f32(V[i], S_inv));
+            }
+        }
+    }
+    return true;
+}
+#else
+static bool ggml_flash_attn_f16_pruned(const ggml_compute_params *, ggml_tensor *) { return false; }
+#endif
+
 static void ggml_compute_forward_flash_attn_ext_f16(
         const ggml_compute_params * params,
         ggml_tensor * dst) {
 
+    if (ggml_flash_attn_f16_pruned(params, dst)) {
+        return;
+    }
+
     const ggml_tensor * q     = dst->src[0];
     const ggml_tensor * k     = dst->src[1];
     const ggml_tensor * v     = dst->src[2];
