+static bool ggml_flash_attn_f16_pruned(const ggml_compute_params * params, ggml_tensor * dst) {
+    static const bool  on  = getenv("GGML_FA_PRUNE") == nullptr || atoi(getenv("GGML_FA_PRUNE")) != 0;
+    static const float eps = getenv("GGML_FA_EPS") ? (float) atof(getenv("GGML_FA_EPS")) : 1e-3f;
+    const ggml_tensor * q = dst->src[0], * k = dst->src[1], * v = dst->src[2], * mask = dst->src[3], * sinks = dst->src[4], * kv_rows = dst->src[5];
+    float scale = 1.0f, max_bias = 0.0f, softcap = 0.0f;
