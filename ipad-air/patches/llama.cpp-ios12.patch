+    const ggml_tensor * src1 = op->src[1];
+    const int64_t n = src0->ne[0], nrow = src0->ne[1];
+    if (src1->type != GGML_TYPE_F32 || src1->ne[1] * src1->ne[2] != 1 || src0->ne[2] != 1 || n != src1->ne[0] ||
+        n % 128 != 0 || n < 512 || nrow < 1024 || !ggml_cpu_has_neon() || ggml_cpu_has_dotprod() || !q1lut_enabled()) {
+        return false;
+    }
+    auto & h = g_q1lut_head;
+    if (h.ready && h.src != src0->data) {
+        return false;
+    }
+    const int ith = params->ith, nth = params->nth;
+    const int nb128 = (int) (n / 128);
+    const int64_t ngroups = nrow / 32;
+    const size_t row_bytes = q1lut_row_bytes(n);
+    if (!h.ready) {
+        if (ith == 0) {
+            h.src  = src0->data;
+            h.lut  = (uint8_t *) ggml_aligned_malloc((size_t) ngroups * q1lut_group_bytes(n));
+            h.wrow = (char *) ggml_aligned_malloc(row_bytes);
+            GGML_ASSERT(h.lut && h.wrow);
+        }
+        ggml_barrier(params->threadpool);
+        q1lut_build_groups(h.lut, (const block_q1_0 *) src0->data, nb128, ngroups * ith / nth, ngroups * (ith + 1) / nth);
+        ggml_barrier(params->threadpool);
+        if (ith == 0) {
+            h.ready = true;
+        }
+    }
+    q1lut_tables((const float *) src1->data, h.wrow, n, nb128 * ith / nth, nb128 * (ith + 1) / nth);
+    if (ith == 0) {
+        ggml_threadpool_chunk_set(params->threadpool, 0);
+    }
+    ggml_barrier(params->threadpool);
+    q1lut_run_chunks(params, h.lut, n, ngroups, h.wrow, row_bytes, 1, (char *) op->data, op->nb[1]);
+    if (ith == 0) {   // the rows after the last whole group
+        const float * x = (const float *) src1->data;
+        float * out = (float *) op->data;
+        for (int64_t r = ngroups * 32; r < nrow; r++) {
+            const block_q1_0 * row = (const block_q1_0 *) src0->data + (size_t) r * nb128;
+            float sum = 0.0f;
+            for (int b = 0; b < nb128; b++) {
