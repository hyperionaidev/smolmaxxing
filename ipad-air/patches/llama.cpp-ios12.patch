+        q->ne[3] != 1 || k->ne[3] != 1 || v->ne[3] != 1 || k->ne[2] != v->ne[2] || q->ne[2] % k->ne[2] != 0 ||
+        k->ne[0] != v->ne[0] || q->ne[0] != k->ne[0] || k->ne[0] % 16 != 0 || k->ne[0] > 1024) {
