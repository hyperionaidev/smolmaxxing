diff --git a/ggml/src/ggml-cpu/stream-tv.inc b/ggml/src/ggml-cpu/stream-tv.inc
new file mode 100644
index 0000000..3471c83
--- /dev/null
+++ b/ggml/src/ggml-cpu/stream-tv.inc
@@ -0,0 +1,274 @@
+// tvbox: weight streaming engine for models bigger than RAM (included in repack.cpp).
+//
+// A "zone" is a range of weight memory that is backed by a file but not kept resident: the part of the model
+// that doesn't fit. Left to the kernel (plain mmap), a cyclic scan larger than the page cache is the LRU's
+// worst case (it evicts exactly the pages needed next, so everything is re-read each token) and the compute
+// threads stall in 4 KB page faults. Measured eMMC: ~150 MB/s that way vs 278 MB/s for parallel 8 MB O_DIRECT
+// reads (tools/kbench/flashbench.c). So here:
+//   * the zone's address range is remapped to anonymous memory, empty;
+//   * the first pass records the order in which matmuls use zone tensors (the trace);
+//   * GGML_STREAM_READERS threads (default 3) read zone tensors with O_DIRECT, in 8 MB chunks, straight into
+//     their own addresses, in trace order starting at the tensor in use, up to GGML_STREAM_WINDOW_MB ahead;
+//   * every compute thread waits until the weight of its MUL_MAT is completely loaded (so correctness never
+//     depends on the prediction: an unexpected tensor is just loaded on demand);
+//   * when the next zone matmul starts, the previous zone tensor is finished (graph nodes are separated by a
+//     barrier) and its pages are freed (MADV_DONTNEED): RAM use stays at about the window.
+// Zones are registered by the repack cache (GGML_REPACK_RESIDENT_MB) and by llama's model mmap
+// (LLAMA_STREAM_RESIDENT_MB). Pages shared with a neighbouring tensor at a tensor's edges are loaded with it
+// and never freed, so their content is always valid.
+#if defined(__linux__)
+#include <sys/mman.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sched.h>
+#include <time.h>
+#include <atomic>
+#include <condition_variable>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+namespace {
+constexpr uintptr_t ST_PG = 4096;
+constexpr size_t    ST_CHUNK = (size_t) 8 << 20;
+struct stream_zone { char * base; size_t len; int fd; int bfd; int64_t foff; char * ov_beg; char * ov_end; bool direct; };
+struct stream_ent {
+    char * p; size_t len; int z;
+    char * rd_beg; char * rd_end;          // page-aligned read range, clipped to the zone's anonymous overlay
+    int nchunks;
+    int claimed = 0, done = 0;             // chunks handed to readers / finished (guarded by mu)
+    std::atomic<bool> loaded{false};
+};
+struct stream_state {
+    std::vector<stream_zone> zones;
+    std::vector<stream_ent *> trace;
+    std::unordered_map<char *, int> index;   // tensor data pointer -> trace entry
+    bool trace_done = false;
+    int cur = -1, prev = -1;
+    size_t window = (size_t) 96 << 20;
+    int readers = 3;
+    std::mutex mu;
+    std::condition_variable cv_work, cv_ready;
+    bool started = false;
+    std::atomic<int64_t> rd_bytes{0}, drop_bytes{0}, wait_ns{0}, sync_loads{0}, hooks{0};
+};
+static stream_state & st_get() { static stream_state s; return s; }
+static int64_t st_now() { timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (int64_t) t.tv_sec * 1000000000 + t.tv_nsec; }
+
+// next chunk to read: entries in trace order from the one in use, within the window (caller holds mu)
+static bool st_pick(stream_state & s, stream_ent *& e, int & c) {
+    const int n = (int) s.trace.size();
+    if (n == 0 || s.cur < 0) { return false; }
+    const int span = s.trace_done ? n : 1;
+    size_t ahead = 0;
+    for (int k = 0; k < span; k++) {
+        stream_ent * x = s.trace[(s.cur + k) % n];
+        if (k > 0 && ahead + x->len > s.window) { break; }
+        ahead += x->len;
+        if (!x->loaded.load(std::memory_order_relaxed) && x->claimed < x->nchunks) {
+            e = x; c = x->claimed++; return true;
+        }
+    }
+    return false;
+}
+
+static void st_reader() {
+    stream_state & s = st_get();
+    for (;;) {
+        stream_ent * e = nullptr; int c = 0;
+        {
+            std::unique_lock<std::mutex> lk(s.mu);
+            s.cv_work.wait(lk, [&] { return st_pick(s, e, c); });
+        }
+        const stream_zone & zn = s.zones[e->z];
+        char * a = e->rd_beg + (size_t) c * ST_CHUNK;
+        size_t left = std::min((size_t) (e->rd_end - a), ST_CHUNK);
+        int64_t off = zn.foff + (a - zn.base);
+        static thread_local std::vector<char> scratch;
+        if (!zn.direct && scratch.empty()) { scratch.resize(ST_CHUNK); }
+        while (left) {
+            // direct: O_DIRECT straight into the tensor's (anonymous) pages; cache: a buffered read into scratch
+            // fills the page cache that backs the file mapping
+            const ssize_t r = zn.direct ? pread(zn.fd, a, left, off) : pread(zn.bfd, scratch.data(), left, off);
+            if (r <= 0) { break; }   // short read at end of file: the rest is past the data
+            a += r; off += r; left -= (size_t) r; s.rd_bytes += r;
+        }
+        {
+            std::lock_guard<std::mutex> lk(s.mu);
+            if (++e->done == e->nchunks) { e->loaded.store(true, std::memory_order_release); s.cv_ready.notify_all(); }
+        }
+        s.cv_work.notify_all();
+    }
+}
+
+static int st_find_zone(stream_state & s, char *& p, size_t & len) {
+    for (size_t i = 0; i < s.zones.size(); i++) {
+        const stream_zone & zn = s.zones[i];
+        if (p + len > zn.base && p < zn.base + zn.len) {
+            if (p < zn.base) { len -= zn.base - p; p = zn.base; }   // tensor straddles the resident/zone edge
+            if (p + len > zn.base + zn.len) { len = zn.base + zn.len - p; }
+            return (int) i;
+        }
+    }
+    return -1;
+}
+
+static stream_ent * st_entry(stream_state & s, char * p, size_t len, int z) {   // caller holds mu
+    auto it = s.index.find(p);
+    if (it != s.index.end()) { return s.trace[it->second]; }
+    const stream_zone & zn = s.zones[z];
+    stream_ent * e = new stream_ent();
+    e->p = p; e->len = len; e->z = z;
+    // O_DIRECT reads cover only the pages wholly inside this tensor. Its first / last partial pages are shared
+    // with the neighbouring tensors: two O_DIRECT reads into one page at the same time were seen to corrupt it
+    // (GGML_STREAM_VERIFY), so edge pages are read once here, with a plain pread, and never freed.
+    char * ia = std::max((char *) (((uintptr_t) p + ST_PG - 1) & ~(ST_PG - 1)), zn.ov_beg);
+    char * ib = std::min((char *) (((uintptr_t) p + len) & ~(ST_PG - 1)), zn.ov_end);
+    if (ib < ia) { ib = ia; }
+    char * ea = std::max((char *) ((uintptr_t) p & ~(ST_PG - 1)), zn.ov_beg);
+    char * eb = std::min((char *) (((uintptr_t) p + len + ST_PG - 1) & ~(ST_PG - 1)), zn.ov_end);
+    auto edge = [&](char * a, char * b) {
+        if (b > a && pread(zn.bfd, a, b - a, zn.foff + (a - zn.base)) != (ssize_t) (b - a)) { GGML_LOG_ERROR("stream: edge read failed\n"); }
+    };
+    if (!zn.direct) {   // file-backed mapping: every page is valid at any time, the reads only warm the cache
+        ia = ea; ib = eb;
+    } else if (ib > ia) { edge(ea, ia); edge(ib, eb); } else { edge(ea, eb); }
+    e->rd_beg = ia; e->rd_end = ib;
+    e->nchunks = (int) ((e->rd_end - e->rd_beg + ST_CHUNK - 1) / ST_CHUNK);
+    if (e->nchunks == 0) { e->loaded = true; }
+    s.index[p] = (int) s.trace.size();
+    s.trace.push_back(e);
+    static const bool dbg = getenv("GGML_STREAM_DEBUG") != nullptr;
+    if (dbg) {
+        GGML_LOG_INFO("stream entry %zu: %p +%zu (zone %d) read [%p, %p) %d chunks\n", s.trace.size() - 1, (void *) p, len, z,
+                      (void *) e->rd_beg, (void *) e->rd_end, e->nchunks);
+    }
+    return e;
+}
+
+static void st_drop(stream_state & s, stream_ent * e) {   // caller holds mu; only whole pages inside the tensor
+    char * a = (char *) (((uintptr_t) e->p + ST_PG - 1) & ~(ST_PG - 1));
+    char * b = (char *) (((uintptr_t) e->p + e->len) & ~(ST_PG - 1));
+    a = std::max(a, s.zones[e->z].ov_beg); b = std::min(b, s.zones[e->z].ov_end);
+    if (b <= a || e->claimed != e->done) { return; }   // never free pages a reader is still writing
+    madvise(a, b - a, MADV_DONTNEED);
+    if (!s.zones[e->z].direct) { posix_fadvise(s.zones[e->z].bfd, s.zones[e->z].foff + (a - s.zones[e->z].base), b - a, POSIX_FADV_DONTNEED); }
+    s.drop_bytes += b - a;
+    e->loaded = false; e->claimed = e->done = 0;
+}
+}  // namespace
+
+extern "C" int ggml_cpu_stream_active = 0;
+extern "C" void ggml_cpu_stream_stats(void);
+
+extern "C" void ggml_cpu_stream_register(void * base, size_t len, int fd, int64_t file_off) {
+    stream_state & s = st_get();
+    std::lock_guard<std::mutex> lk(s.mu);
+    // O_DIRECT descriptor of the same file (bypasses the page cache)
+    const int dfd = open(("/proc/self/fd/" + std::to_string(fd)).c_str(), O_RDONLY | O_DIRECT);
+    char * b = (char *) base;
+    char * ov_beg = (char *) (((uintptr_t) b + ST_PG - 1) & ~(ST_PG - 1));
+    char * ov_end = (char *) (((uintptr_t) b + len) & ~(ST_PG - 1));
+    if (dfd < 0 || ov_end <= ov_beg) { GGML_LOG_ERROR("%s: cannot stream %.1f MB zone\n", __func__, len / 1e6); return; }
+    // GGML_STREAM_MODE=cache keeps the zone file-backed (page cache) instead of anonymous + O_DIRECT: better when the
+    // zone is small enough for the page cache to hold the prefetch window without pushing out anything else
+    const char * mode = getenv("GGML_STREAM_MODE");
+    const bool direct = !(mode && strcmp(mode, "cache") == 0);
+    if (direct) {
+        void * q = mmap(ov_beg, ov_end - ov_beg, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+        GGML_ASSERT(q == ov_beg);
+    }
+    const int bfd = open(("/proc/self/fd/" + std::to_string(fd)).c_str(), O_RDONLY);
+    s.zones.push_back({ b, len, dfd, bfd, file_off, ov_beg, ov_end, direct });
+    if (const char * w = getenv("GGML_STREAM_WINDOW_MB")) { s.window = (size_t) atoll(w) << 20; }
+    if (const char * r = getenv("GGML_STREAM_READERS"))   { s.readers = std::max(1, atoi(r)); }
+    if (!s.started) {
+        s.started = true;
+        for (int i = 0; i < s.readers; i++) { std::thread(st_reader).detach(); }
+        if (getenv("GGML_STREAM_STATS")) { atexit([] { ggml_cpu_stream_stats(); }); }
+    }
+    ggml_cpu_stream_active = 1;
+    GGML_LOG_INFO("%s: stream zone %.1f MB (file offset %lld), window %zu MB, %d %s readers\n", __func__, len / 1e6,
+                  (long long) file_off, s.window >> 20, s.readers, direct ? "O_DIRECT" : "page-cache");
+}
+
+// every compute thread calls this when a MUL_MAT starts (t = its weight); thread 0 also does the bookkeeping.
+// Returns once the weight is completely in memory.
+extern "C" void ggml_cpu_stream_hook(const struct ggml_tensor * t, int ith) {
+    stream_state & s = st_get();
+    char * p = (char *) t->data;
+    size_t len = t->buffer ? ggml_backend_buffer_get_alloc_size(t->buffer, t) : ggml_nbytes(t);
+    const int z = st_find_zone(s, p, len);
+    if (getenv("GGML_STREAM_DEBUG") && ith == 0 && strncmp(t->name, "output", 6) == 0) {
+        static int nout = 0;
+        if (nout++ < 3) {
+            GGML_LOG_INFO("stream: %s at %p +%zu, zone %d, zones[0] = [%p, +%zu), first bytes %02x %02x %02x %02x\n", t->name, t->data, len, z,
+                          s.zones.empty() ? nullptr : (void *) s.zones[0].base, s.zones.empty() ? 0 : s.zones[0].len,
+                          ((unsigned char *) t->data)[0], ((unsigned char *) t->data)[1], ((unsigned char *) t->data)[64], ((unsigned char *) t->data)[1000]);
+        }
+    }
+    if (z < 0) { return; }
+    static const bool dbg = getenv("GGML_STREAM_DEBUG") != nullptr;
+    if (dbg && ith == 0 && s.hooks < 400) { GGML_LOG_INFO("stream hook %s %p +%zu\n", t->name, (void *) p, len); }
+    if (ith == 0) {
+        const int64_t t0 = st_now();
+        {
+            std::unique_lock<std::mutex> lk(s.mu);
+            stream_ent * e = st_entry(s, p, len, z);
+            const int j = s.index[p];
+            if (!s.trace_done && s.trace.size() > 1 && j == 0 && s.cur != 0) {
+                s.trace_done = true;
+                GGML_LOG_INFO("%s: trace of %zu zone tensors recorded\n", __func__, s.trace.size());
+            }
+            if (s.prev >= 0 && s.prev != j) { st_drop(s, s.trace[s.prev]); }
+            s.prev = j; s.cur = j; s.hooks++;
+            if (!e->loaded.load(std::memory_order_acquire)) { s.sync_loads++; }
+            s.cv_work.notify_all();
+            s.cv_ready.wait(lk, [&] { return e->loaded.load(std::memory_order_acquire); });
+            static const bool verify = getenv("GGML_STREAM_VERIFY") != nullptr;
+            if (verify) {   // debug: compare the tensor with the file
+                const stream_zone & zn = s.zones[e->z];
+                static int vfd = -1;
+                if (vfd < 0) { vfd = open(("/proc/self/fd/" + std::to_string(zn.fd)).c_str(), O_RDONLY); }
+                std::vector<char> ref(len);
+                const ssize_t r = pread(vfd, ref.data(), len, zn.foff + (p - zn.base));
+                size_t bad = 0, first = 0;
+                for (size_t i = 0; i < len && r == (ssize_t) len; i++) { if (ref[i] != p[i]) { if (!bad) { first = i; } bad++; } }
+                if (bad) {
+                    GGML_LOG_ERROR("stream VERIFY %s: %zu of %zu bytes differ, first at +%zu (page +%zu), entry %d, loaded by %d chunks\n",
+                                   t->name, bad, len, first, (size_t) ((uintptr_t) (p + first) & ~(ST_PG - 1)) - (size_t) ((uintptr_t) p & ~(ST_PG - 1)), j, e->nchunks);
+                }
+            }
+        }
+        s.wait_ns += st_now() - t0;
+        return;
+    }
+    // other threads: wait until thread 0 has made this tensor current and it is loaded
+    for (;;) {
+        {
+            std::unique_lock<std::mutex> lk(s.mu);
+            auto it = s.index.find(p);
+            if (it != s.index.end() && s.cur == it->second) {
+                stream_ent * x = s.trace[it->second];
+                s.cv_ready.wait(lk, [&] { return x->loaded.load(std::memory_order_acquire); });
+                return;
+            }
+        }
+        sched_yield();
+    }
+}
+
+extern "C" void ggml_cpu_stream_stats(void) {
+    stream_state & s = st_get();
+    if (!s.started) { return; }
+    GGML_LOG_INFO("stream: read %.1f MB, freed %.1f MB, trace %zu tensors, %lld matmuls, %lld not ready on arrival, thread-0 wait %.2f s\n",
+                  s.rd_bytes / 1e6, s.drop_bytes / 1e6, s.trace.size(), (long long) s.hooks.load(), (long long) s.sync_loads.load(), s.wait_ns / 1e9);
+}
+#else
+extern "C" int ggml_cpu_stream_active = 0;
+extern "C" void ggml_cpu_stream_register(void *, size_t, int, int64_t) {}
+extern "C" void ggml_cpu_stream_hook(const struct ggml_tensor *, int) {}
+extern "C" void ggml_cpu_stream_stats(void) {}
+#endif
