+    if (head->type != embd->type || (!plain && !rep4k)) {
+        LLAMA_LOG_INFO("%s: embedding from head: off (head %s in %s)\n", __func__, ggml_type_name(head->type), bname);
+        return nullptr;
+    }
+    const int64_t n_keep = ids->ne[0];
+    const int32_t * iv = (const int32_t *) ids->data;
+    const size_t rs = ggml_row_size(head->type, head->ne[0]);
+    std::vector<uint8_t> tmp(rs);
+    bool ok = false;
+    for (int il : plain ? std::vector<int>{0} : std::vector<int>{4, 8}) {
+        ok = true;
+        for (int64_t k = 0; k < 8 && ok; k++) {
+            const int64_t r = k * (n_keep - 1) / 7;
+            if (iv[r] < 0 || iv[r] >= embd->ne[1]) {
+                ok = false;
+                break;
+            }
+            const uint8_t * hr = (const uint8_t *) head->data + r * head->nb[1];
+            if (il) {
+                tv_q4kx8_row((const uint8_t *) head->data, r, head->ne[0] / 256, il, tmp.data());
+                hr = tmp.data();
