diff --git a/ggml/src/ggml-cpu/repack-q1-tv.inc b/ggml/src/ggml-cpu/repack-q1-tv.inc
new file mode 100644
index 0000000..a021850
--- /dev/null
+++ b/ggml/src/ggml-cpu/repack-q1-tv.inc
@@ -0,0 +1,180 @@
+// tvbox patch: repacked 1-bit Q1_0 (PrismML Bonsai, group 128, w = d * (+1 | -1)) kernel for ARM dotprod
+// without i8mm (Cortex-A55), against Q8_K activations.
+// Upstream's Q1_0 path expands every 8 sign bits through a 256-entry table (a scalar load + vector insert per
+// byte) before each vdot. Here the bits are stored as bit planes: one 16-byte vector holds 8 chunks of
+// 4 rows x 4 weights, and vtstq_u8 against (1 << k) turns plane k straight into a 0 / -1 mask for
+// vdotq_laneq. With T = sum over set bits of (-1) * a, the dot is d * (2 * sum_set a - sum a) = d * (-2T - S),
+// S = the 128-group's activation sum (from bsums). Two NEON ops per 16 multiply-adds (gemv), no table.
+//
+// Compact scales: Bonsai's per-128 scales are all positive and within 0.44-1.0x of their row's largest
+// (measured on 5 tensors of Bonsai-8B), so each is stored as 1 byte, d = dmin_row + q * dstep_row, with the two
+// fp16 row parameters once per row: mean error 0.1 % of the scale, about fp16's own rounding. 17 bytes per 128
+// weights instead of 18 (-5.6 %), which is what makes Bonsai-8B fit in this box's RAM.
+// Layout, per group of 8 rows (q1tv_group_bytes = 32 + K/256 * 272 bytes):
+//   ggml_half dmin[8], dstep[8]                   row j's scale parameters
+//   then K/256 blocks of block_q1_0x8c:
+//     d[g*8 + j]                    = row j's 8-bit scale code of 128-group g (g = 0, 1)
+//     qs[(q*2 + h)*16 + jj*4 + i]   bit k = sign of row h*4 + jj, element 32q + 4k + i   (q = 0..7, k = 0..7)
+struct block_q1_0x8c { uint8_t d[16]; uint8_t qs[256]; };
+static_assert(sizeof(block_q1_0x8c) == 272, "q1_0x8c size");
+
+static inline size_t q1tv_group_bytes(int64_t k) { return 32 + (size_t) (k / QK_K) * sizeof(block_q1_0x8c); }
+
+static int repack_q1_0_to_q1x8_tv(struct ggml_tensor * t, const void * GGML_RESTRICT data, size_t data_size) {
+    GGML_ASSERT(t->type == GGML_TYPE_Q1_0);
+    const int nrow = ggml_nrows(t);
+    const int nb128 = t->ne[0] / 128, nb = t->ne[0] / QK_K;
+    GGML_ASSERT(data_size == (size_t) nrow * nb128 * sizeof(block_q1_0));
+    if (t->ne[1] % 8 != 0 || t->ne[0] % QK_K != 0) {
+        return -1;
+    }
+    const block_q1_0 * src = (const block_q1_0 *) data;
+    uint8_t * dst = (uint8_t *) t->data;
+    for (int r = 0; r < nrow; r += 8) {
+        ggml_half * hdr = (ggml_half *) dst;
+        float mn[8], st[8];
+        for (int j = 0; j < 8; j++) {
+            float lo = INFINITY, hi = -INFINITY;
+            for (int b = 0; b < nb128; b++) {
+                const float d = GGML_CPU_FP16_TO_FP32(src[(size_t) (r + j) * nb128 + b].d);
+                lo = std::min(lo, d); hi = std::max(hi, d);
+            }
+            hdr[j]     = GGML_CPU_FP32_TO_FP16(lo);
+            hdr[8 + j] = GGML_CPU_FP32_TO_FP16((hi - lo) / 255.0f);
+            mn[j] = GGML_CPU_FP16_TO_FP32(hdr[j]);
+            st[j] = GGML_CPU_FP16_TO_FP32(hdr[8 + j]);
+        }
+        block_q1_0x8c * out = (block_q1_0x8c *) (dst + 32);
+        for (int b = 0; b < nb; b++) {
+            block_q1_0x8c o;
+            memset(o.qs, 0, sizeof o.qs);
+            for (int j = 0; j < 8; j++) {
+                for (int g = 0; g < 2; g++) {
+                    const block_q1_0 * in = &src[(size_t) (r + j) * nb128 + b * 2 + g];
+                    const float d = GGML_CPU_FP16_TO_FP32(in->d);
+                    const int q = st[j] > 0 ? (int) lroundf((d - mn[j]) / st[j]) : 0;
+                    o.d[g * 8 + j] = (uint8_t) std::max(0, std::min(255, q));
+                    for (int m = 0; m < 128; m++) {
+                        if (!((in->qs[m / 8] >> (m % 8)) & 1)) {
+                            continue;
+                        }
+                        const int e = g * 128 + m, qq = e / 32, k = (e % 32) / 4, i = e % 4;
+                        o.qs[(qq * 2 + j / 4) * 16 + (j % 4) * 4 + i] |= (uint8_t) (1u << k);
+                    }
+                }
+            }
+            out[b] = o;
+        }
+        dst += q1tv_group_bytes(t->ne[0]);
+    }
+    return 0;
+}
+
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+#define Q1TV_M(B, K) vreinterpretq_s8_u8(vtstq_u8((B), vdupq_n_u8(1u << (K))))
+// row scales of 128-group g of block w for rows 0-3 / 4-7: dmin + code * dstep
+#define Q1TV_SCALES(W, G, D0, D1) \
+    const uint16x8_t dq16 = vmovl_u8(vld1_u8((W).d + (G) * 8)); \
+    const float32x4_t D0 = vfmaq_f32(mn0, vcvtq_f32_u32(vmovl_u16(vget_low_u16(dq16))), st0); \
+    const float32x4_t D1 = vfmaq_f32(mn1, vcvtq_f32_u32(vmovl_u16(vget_high_u16(dq16))), st1);
+
+static void ggml_gemv_q1_0_8x4_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    GGML_UNUSED(bs); GGML_UNUSED(nr);
+    const int nb = n / QK_K;
+    const block_q8_K * y = (const block_q8_K *) vy;
+    for (int x = 0; x < nc / 8; x++) {
+        const uint8_t * grp = (const uint8_t *) vx + (size_t) x * q1tv_group_bytes(n);
+        const __fp16 * hdr = (const __fp16 *) grp;
+        const float32x4_t mn0 = vcvt_f32_f16(vld1_f16(hdr)), mn1 = vcvt_f32_f16(vld1_f16(hdr + 4));
+        const float32x4_t st0 = vcvt_f32_f16(vld1_f16(hdr + 8)), st1 = vcvt_f32_f16(vld1_f16(hdr + 12));
+        const block_q1_0x8c * w = (const block_q1_0x8c *) (grp + 32);
+        float32x4_t f0 = vdupq_n_f32(0), f1 = vdupq_n_f32(0);
+        for (int b = 0; b < nb; b++) {
+            const int8_t * q8 = y[b].qs;
+            const uint8_t * qs = w[b].qs;
+            const float yd = y[b].d;
+            for (int g = 0; g < 2; g++) {
+                // 4 accumulator chains (even / odd bit planes) to hide the vdot latency
+                int32x4_t c0 = vdupq_n_s32(0), c1 = vdupq_n_s32(0), e0 = vdupq_n_s32(0), e1 = vdupq_n_s32(0);
+                for (int q = 4 * g; q < 4 * g + 4; q++) {
+                    const int8x16_t a0 = vld1q_s8(q8 + 32 * q), a1 = vld1q_s8(q8 + 32 * q + 16);
+                    const uint8x16_t b0 = vld1q_u8(qs + q * 32), b1 = vld1q_u8(qs + q * 32 + 16);
+                    c0 = vdotq_laneq_s32(c0, Q1TV_M(b0, 0), a0, 0); c1 = vdotq_laneq_s32(c1, Q1TV_M(b1, 0), a0, 0);
+                    e0 = vdotq_laneq_s32(e0, Q1TV_M(b0, 1), a0, 1); e1 = vdotq_laneq_s32(e1, Q1TV_M(b1, 1), a0, 1);
+                    c0 = vdotq_laneq_s32(c0, Q1TV_M(b0, 2), a0, 2); c1 = vdotq_laneq_s32(c1, Q1TV_M(b1, 2), a0, 2);
+                    e0 = vdotq_laneq_s32(e0, Q1TV_M(b0, 3), a0, 3); e1 = vdotq_laneq_s32(e1, Q1TV_M(b1, 3), a0, 3);
+                    c0 = vdotq_laneq_s32(c0, Q1TV_M(b0, 4), a1, 0); c1 = vdotq_laneq_s32(c1, Q1TV_M(b1, 4), a1, 0);
+                    e0 = vdotq_laneq_s32(e0, Q1TV_M(b0, 5), a1, 1); e1 = vdotq_laneq_s32(e1, Q1TV_M(b1, 5), a1, 1);
+                    c0 = vdotq_laneq_s32(c0, Q1TV_M(b0, 6), a1, 2); c1 = vdotq_laneq_s32(c1, Q1TV_M(b1, 6), a1, 2);
+                    e0 = vdotq_laneq_s32(e0, Q1TV_M(b0, 7), a1, 3); e1 = vdotq_laneq_s32(e1, Q1TV_M(b1, 7), a1, 3);
+                }
+                c0 = vaddq_s32(c0, e0); c1 = vaddq_s32(c1, e1);
+                const int16x8_t bsv = vld1q_s16(y[b].bsums + 8 * g);
+                const int32x4_t ys = vdupq_n_s32(vaddlvq_s16(bsv));
+                // -2T - S
+                const int32x4_t i0 = vnegq_s32(vaddq_s32(vshlq_n_s32(c0, 1), ys)), i1 = vnegq_s32(vaddq_s32(vshlq_n_s32(c1, 1), ys));
+                Q1TV_SCALES(w[b], g, wd0, wd1)
+                f0 = vfmaq_f32(f0, vmulq_n_f32(wd0, yd), vcvtq_f32_s32(i0));
+                f1 = vfmaq_f32(f1, vmulq_n_f32(wd1, yd), vcvtq_f32_s32(i1));
+            }
+        }
+        vst1q_f32(s + x * 8, f0);
+        vst1q_f32(s + x * 8 + 4, f1);
+    }
+}
+
+// gemm: 4 activation rows in the block_q8_Kx4 layout (elements 4c..4c+3 of the 4 rows = 16 bytes at qs + 16c,
+// row r = lane r; bsums[(sb/4)*16 + r*4 + sb%4]). Each mask vector feeds 4 dot products.
+static void ggml_gemm_q1_0_8x4_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int nb = n / QK_K;
+    for (int yb = 0; yb < nr / 4; yb++) {
+        const block_q8_Kx4 * a = (const block_q8_Kx4 *) vy + (size_t) yb * nb;
+        for (int x = 0; x < nc / 8; x++) {
+            const uint8_t * grp = (const uint8_t *) vx + (size_t) x * q1tv_group_bytes(n);
+            const __fp16 * hdr = (const __fp16 *) grp;
+            const float32x4_t mn0 = vcvt_f32_f16(vld1_f16(hdr)), mn1 = vcvt_f32_f16(vld1_f16(hdr + 4));
+            const float32x4_t st0 = vcvt_f32_f16(vld1_f16(hdr + 8)), st1 = vcvt_f32_f16(vld1_f16(hdr + 12));
+            const block_q1_0x8c * w = (const block_q1_0x8c *) (grp + 32);
+            float32x4_t f[4][2];
+            for (int r = 0; r < 4; r++) { f[r][0] = vdupq_n_f32(0); f[r][1] = vdupq_n_f32(0); }
+            for (int b = 0; b < nb; b++) {
+                const int8_t * q8 = a[b].qs;
+                const uint8_t * qs = w[b].qs;
+                for (int g = 0; g < 2; g++) {
+                    int32x4_t c[4][2];
+                    for (int r = 0; r < 4; r++) { c[r][0] = vdupq_n_s32(0); c[r][1] = vdupq_n_s32(0); }
+                    for (int q = 4 * g; q < 4 * g + 4; q++) {
+                        const uint8x16_t b0 = vld1q_u8(qs + q * 32), b1 = vld1q_u8(qs + q * 32 + 16);
+#define Q1TV_G(K) { const int8x16_t m0 = Q1TV_M(b0, K), m1 = Q1TV_M(b1, K); const int8x16_t av = vld1q_s8(q8 + 16 * (8 * q + (K))); \
+                        c[0][0] = vdotq_laneq_s32(c[0][0], m0, av, 0); c[0][1] = vdotq_laneq_s32(c[0][1], m1, av, 0); \
+                        c[1][0] = vdotq_laneq_s32(c[1][0], m0, av, 1); c[1][1] = vdotq_laneq_s32(c[1][1], m1, av, 1); \
+                        c[2][0] = vdotq_laneq_s32(c[2][0], m0, av, 2); c[2][1] = vdotq_laneq_s32(c[2][1], m1, av, 2); \
+                        c[3][0] = vdotq_laneq_s32(c[3][0], m0, av, 3); c[3][1] = vdotq_laneq_s32(c[3][1], m1, av, 3); }
+                        Q1TV_G(0) Q1TV_G(1) Q1TV_G(2) Q1TV_G(3) Q1TV_G(4) Q1TV_G(5) Q1TV_G(6) Q1TV_G(7)
+#undef Q1TV_G
+                    }
+                    Q1TV_SCALES(w[b], g, wd0, wd1)
+                    for (int r = 0; r < 4; r++) {
+                        int32_t ysum = 0;
+                        for (int sb = 8 * g; sb < 8 * g + 8; sb++) { ysum += a[b].bsums[(sb / 4) * 16 + r * 4 + sb % 4]; }
+                        const int32x4_t ys = vdupq_n_s32(ysum);
+                        const int32x4_t i0 = vnegq_s32(vaddq_s32(vshlq_n_s32(c[r][0], 1), ys));
+                        const int32x4_t i1 = vnegq_s32(vaddq_s32(vshlq_n_s32(c[r][1], 1), ys));
+                        f[r][0] = vfmaq_f32(f[r][0], vmulq_n_f32(wd0, a[b].d[r]), vcvtq_f32_s32(i0));
+                        f[r][1] = vfmaq_f32(f[r][1], vmulq_n_f32(wd1, a[b].d[r]), vcvtq_f32_s32(i1));
+                    }
+                }
+            }
+            for (int r = 0; r < 4; r++) {
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8,     f[r][0]);
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8 + 4, f[r][1]);
+            }
+        }
+    }
+}
+#undef Q1TV_SCALES
+#undef Q1TV_M
+#else
+static void ggml_gemv_q1_0_8x4_q8_K_tv(int, float *, size_t, const void *, const void *, int, int) { GGML_ABORT("q1 8x4 needs dotprod"); }
+static void ggml_gemm_q1_0_8x4_q8_K_tv(int, float *, size_t, const void *, const void *, int, int) { GGML_ABORT("q1 8x4 needs dotprod"); }
+#endif
diff --git a/ggml/src/ggml-cpu/repack-q2k-tv.inc b/ggml/src/ggml-cpu/repack-q2k-tv.inc
new file mode 100644
index 0000000..b50247e
--- /dev/null
+++ b/ggml/src/ggml-cpu/repack-q2k-tv.inc
@@ -0,0 +1,192 @@
+// tvbox patch: repacked Q2_K kernels for ARM dotprod without i8mm (Cortex-A55).
+// Upstream only repacks Q2_K for x86 AVX-512 and RISC-V; on ARM it runs the per-row vec_dot, which spends most of
+// its time in horizontal adds (vaddvq) and a scalar scale multiply per 16 weights.
+// Layout (same size as block_q2_Kx8, different order), 8 rows per block:
+//   scales[sb*8 + j] = row j's scales[sb]            (low nibble scale, high nibble min), sb = 0..15
+//   qs[c*32 + j*4 + i] = row j's qs[c*4 + i]         c = 0..15, so one 16-byte load = 4 rows x 4 bytes
+// Byte qs[b] of a row holds elements (b/32)*128 + b%32 + 32*s at bits 2s..2s+1; chunk c = 8h + 4g + lane covers
+// elements h*128 + 32s + 16g + 4*lane .. +3, all in sub-block 8h + 2s + g.
+// Measured by tools/kbench/kbench_q2k.c on the TV: 13-14 G weights/s from DRAM with 3 threads vs 7-8 for vec_dot.
+
+static int repack_q2_K_to_q2_K_8x4_tv(struct ggml_tensor * t, const void * GGML_RESTRICT data, size_t data_size) {
+    GGML_ASSERT(t->type == GGML_TYPE_Q2_K);
+    const int nrow = ggml_nrows(t);
+    const int nblocks = t->ne[0] / QK_K;
+    GGML_ASSERT(data_size == (size_t) nrow * nblocks * sizeof(block_q2_K));
+    if (t->ne[1] % 8 != 0) {
+        return -1;
+    }
+    const block_q2_K * src = (const block_q2_K *) data;
+    block_q2_Kx8 * dst = (block_q2_Kx8 *) t->data;
+    for (int r = 0; r < nrow; r += 8) {
+        for (int b = 0; b < nblocks; b++) {
+            block_q2_Kx8 o;
+            for (int j = 0; j < 8; j++) {
+                const block_q2_K * in = &src[(size_t) (r + j) * nblocks + b];
+                o.d[j]    = in->GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.d;
+                o.dmin[j] = in->GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.dmin;
+                for (int sb = 0; sb < 16; sb++) {
+                    o.scales[sb * 8 + j] = in->scales[sb];
+                }
+                for (int c = 0; c < 16; c++) {
+                    memcpy(&o.qs[c * 32 + j * 4], &in->qs[c * 4], 4);
+                }
+            }
+            *dst++ = o;
+        }
+    }
+    return 0;
+}
+
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+static void ggml_gemv_q2_K_8x4_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    GGML_UNUSED(bs); GGML_UNUSED(nr);
+    const int nb = n / QK_K;
+    const block_q8_K * y = (const block_q8_K *) vy;
+    const uint8x16_t m03 = vdupq_n_u8(0x03), m0c = vdupq_n_u8(0x0C), m30 = vdupq_n_u8(0x30);
+    const uint8x8_t m4 = vdup_n_u8(0x0F);
+    for (int x = 0; x < nc / 8; x++) {
+        const block_q2_Kx8 * w = (const block_q2_Kx8 *) vx + (size_t) x * nb;
+        float32x4_t f0 = vdupq_n_f32(0), f1 = vdupq_n_f32(0);
+        for (int b = 0; b < nb; b++) {
+            const int8_t * q8 = y[b].qs;
+            const uint8_t * qs = w[b].qs;
+            const uint8_t * sc = w[b].scales;
+            int32x4_t t0 = vdupq_n_s32(0), t1 = vdupq_n_s32(0);
+            for (int h = 0; h < 2; h++) {
+                for (int g = 0; g < 2; g++) {
+                    const int8x16_t a0 = vld1q_s8(q8 + h * 128 + 16 * g),      a1 = vld1q_s8(q8 + h * 128 + 32 + 16 * g),
+                                    a2 = vld1q_s8(q8 + h * 128 + 64 + 16 * g), a3 = vld1q_s8(q8 + h * 128 + 96 + 16 * g);
+                    int32x4_t c00 = vdupq_n_s32(0), c01 = c00, c10 = c00, c11 = c00, c20 = c00, c21 = c00, c30 = c00, c31 = c00;
+                    const uint8_t * qc = qs + (h * 8 + g * 4) * 32;
+#define Q2TV_LANE(L) { \
+                    const uint8x16_t w0 = vld1q_u8(qc + (L) * 32), w1 = vld1q_u8(qc + (L) * 32 + 16); \
+                    c00 = vdotq_laneq_s32(c00, vreinterpretq_s8_u8(vandq_u8(w0, m03)), a0, L); \
+                    c01 = vdotq_laneq_s32(c01, vreinterpretq_s8_u8(vandq_u8(w1, m03)), a0, L); \
+                    c10 = vdotq_laneq_s32(c10, vreinterpretq_s8_u8(vandq_u8(w0, m0c)), a1, L); \
+                    c11 = vdotq_laneq_s32(c11, vreinterpretq_s8_u8(vandq_u8(w1, m0c)), a1, L); \
+                    c20 = vdotq_laneq_s32(c20, vreinterpretq_s8_u8(vandq_u8(w0, m30)), a2, L); \
+                    c21 = vdotq_laneq_s32(c21, vreinterpretq_s8_u8(vandq_u8(w1, m30)), a2, L); \
+                    c30 = vdotq_laneq_s32(c30, vreinterpretq_s8_u8(vshrq_n_u8(w0, 6)), a3, L); \
+                    c31 = vdotq_laneq_s32(c31, vreinterpretq_s8_u8(vshrq_n_u8(w1, 6)), a3, L); }
+                    Q2TV_LANE(0) Q2TV_LANE(1) Q2TV_LANE(2) Q2TV_LANE(3)
+#undef Q2TV_LANE
+                    const int base = 8 * h + g;   // sub-block of shift S is base + 2S; per-row dots fit in int16
+#define Q2TV_SCALE(S, D0, D1) { \
+                    const int16x8_t sc16 = vreinterpretq_s16_u16(vmovl_u8(vand_u8(vld1_u8(sc + (base + 2 * (S)) * 8), m4))); \
+                    const int16x8_t dd = vcombine_s16(D0, D1); \
+                    t0 = vmlal_s16(t0, vget_low_s16(dd), vget_low_s16(sc16)); t1 = vmlal_high_s16(t1, dd, sc16); }
+                    Q2TV_SCALE(0, vmovn_s32(c00), vmovn_s32(c01))
+                    Q2TV_SCALE(1, vshrn_n_s32(c10, 2), vshrn_n_s32(c11, 2))
+                    Q2TV_SCALE(2, vshrn_n_s32(c20, 4), vshrn_n_s32(c21, 4))
+                    Q2TV_SCALE(3, vmovn_s32(c30), vmovn_s32(c31))
+#undef Q2TV_SCALE
+                }
+            }
+            int32x4_t b0 = vdupq_n_s32(0), b1 = vdupq_n_s32(0);
+            const int16x8_t bs0 = vld1q_s16(y[b].bsums), bs1 = vld1q_s16(y[b].bsums + 8);
+#define Q2TV_MINS(P, BS, L0, L1) { \
+            const uint8x16_t mn = vshrq_n_u8(vld1q_u8(sc + (P) * 16), 4); \
+            const int16x8_t m0 = vreinterpretq_s16_u16(vmovl_u8(vget_low_u8(mn))), m1 = vreinterpretq_s16_u16(vmovl_high_u8(mn)); \
+            b0 = vmlal_laneq_s16(b0, vget_low_s16(m0), BS, L0); b1 = vmlal_high_laneq_s16(b1, m0, BS, L0); \
+            b0 = vmlal_laneq_s16(b0, vget_low_s16(m1), BS, L1); b1 = vmlal_high_laneq_s16(b1, m1, BS, L1); }
+            Q2TV_MINS(0, bs0, 0, 1) Q2TV_MINS(1, bs0, 2, 3) Q2TV_MINS(2, bs0, 4, 5) Q2TV_MINS(3, bs0, 6, 7)
+            Q2TV_MINS(4, bs1, 0, 1) Q2TV_MINS(5, bs1, 2, 3) Q2TV_MINS(6, bs1, 4, 5) Q2TV_MINS(7, bs1, 6, 7)
+#undef Q2TV_MINS
+            const float32x4_t yd = vdupq_n_f32(y[b].d);
+            const float32x4_t d0 = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d)), yd);
+            const float32x4_t d1 = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + 4)), yd);
+            const float32x4_t n0 = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].dmin)), yd);
+            const float32x4_t n1 = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].dmin + 4)), yd);
+            f0 = vfmaq_f32(f0, d0, vcvtq_f32_s32(t0)); f1 = vfmaq_f32(f1, d1, vcvtq_f32_s32(t1));
+            f0 = vfmsq_f32(f0, n0, vcvtq_f32_s32(b0)); f1 = vfmsq_f32(f1, n1, vcvtq_f32_s32(b1));
+        }
+        vst1q_f32(s + x * 8, f0);
+        vst1q_f32(s + x * 8 + 4, f1);
+    }
+}
+
+// 4 activation rows (block_q8_Kx4, 4-byte interleave from ggml_quantize_mat_q8_K_4x4): each decoded weight vector
+// feeds 4 dot products (one per row, vdotq_laneq picks the row's 4 bytes).
+static void ggml_gemm_q2_K_8x4_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int nb = n / QK_K;
+    const uint8x16_t m03 = vdupq_n_u8(0x03), m0c = vdupq_n_u8(0x0C), m30 = vdupq_n_u8(0x30);
+    const uint8x8_t m4 = vdup_n_u8(0x0F);
+    for (int yb = 0; yb < nr / 4; yb++) {
+        const block_q8_Kx4 * a = (const block_q8_Kx4 *) vy + (size_t) yb * nb;
+        for (int x = 0; x < nc / 8; x++) {
+            const block_q2_Kx8 * w = (const block_q2_Kx8 *) vx + (size_t) x * nb;
+            float32x4_t f[4][2];
+            for (int r = 0; r < 4; r++) { f[r][0] = vdupq_n_f32(0); f[r][1] = vdupq_n_f32(0); }
+            for (int b = 0; b < nb; b++) {
+                const int8_t * q8 = a[b].qs;
+                const uint8_t * qs = w[b].qs;
+                const uint8_t * sc = w[b].scales;
+                int32x4_t t[4][2];
+                for (int r = 0; r < 4; r++) { t[r][0] = vdupq_n_s32(0); t[r][1] = vdupq_n_s32(0); }
+                for (int h = 0; h < 2; h++) {
+                    for (int g = 0; g < 2; g++) {
+                        const uint8_t * qc = qs + (h * 8 + g * 4) * 32;
+#define Q2TV_GEMM_S(S, DEC0, DEC1, NARROW) { \
+                        int32x4_t c[4][2]; \
+                        for (int r = 0; r < 4; r++) { c[r][0] = vdupq_n_s32(0); c[r][1] = vdupq_n_s32(0); } \
+                        for (int L = 0; L < 4; L++) { \
+                            const uint8x16_t w0 = vld1q_u8(qc + L * 32), w1 = vld1q_u8(qc + L * 32 + 16); \
+                            const int8x16_t d0 = vreinterpretq_s8_u8(DEC0), d1 = vreinterpretq_s8_u8(DEC1); \
+                            const int8x16_t av = vld1q_s8(q8 + (h * 128 + 32 * (S) + 16 * g + 4 * L) * 4); \
+                            c[0][0] = vdotq_laneq_s32(c[0][0], d0, av, 0); c[0][1] = vdotq_laneq_s32(c[0][1], d1, av, 0); \
+                            c[1][0] = vdotq_laneq_s32(c[1][0], d0, av, 1); c[1][1] = vdotq_laneq_s32(c[1][1], d1, av, 1); \
+                            c[2][0] = vdotq_laneq_s32(c[2][0], d0, av, 2); c[2][1] = vdotq_laneq_s32(c[2][1], d1, av, 2); \
+                            c[3][0] = vdotq_laneq_s32(c[3][0], d0, av, 3); c[3][1] = vdotq_laneq_s32(c[3][1], d1, av, 3); \
+                        } \
+                        const int16x8_t sc16 = vreinterpretq_s16_u16(vmovl_u8(vand_u8(vld1_u8(sc + (8 * h + g + 2 * (S)) * 8), m4))); \
+                        for (int r = 0; r < 4; r++) { \
+                            const int16x8_t dd = vcombine_s16(NARROW(c[r][0]), NARROW(c[r][1])); \
+                            t[r][0] = vmlal_s16(t[r][0], vget_low_s16(dd), vget_low_s16(sc16)); \
+                            t[r][1] = vmlal_high_s16(t[r][1], dd, sc16); \
+                        } }
+#define Q2TV_N0(v) vmovn_s32(v)
+#define Q2TV_N2(v) vshrn_n_s32(v, 2)
+#define Q2TV_N4(v) vshrn_n_s32(v, 4)
+                        Q2TV_GEMM_S(0, vandq_u8(w0, m03), vandq_u8(w1, m03), Q2TV_N0)
+                        Q2TV_GEMM_S(1, vandq_u8(w0, m0c), vandq_u8(w1, m0c), Q2TV_N2)
+                        Q2TV_GEMM_S(2, vandq_u8(w0, m30), vandq_u8(w1, m30), Q2TV_N4)
+                        Q2TV_GEMM_S(3, vshrq_n_u8(w0, 6), vshrq_n_u8(w1, 6), Q2TV_N0)
+#undef Q2TV_GEMM_S
+#undef Q2TV_N0
+#undef Q2TV_N2
+#undef Q2TV_N4
+                    }
+                }
+                // mins: bsums of row r, sub-block sb live at bsums[(sb/4)*16 + r*4 + sb%4]
+                int32x4_t bi[4][2];
+                for (int r = 0; r < 4; r++) { bi[r][0] = vdupq_n_s32(0); bi[r][1] = vdupq_n_s32(0); }
+                for (int sb = 0; sb < 16; sb++) {
+                    const int16x8_t mn = vreinterpretq_s16_u16(vmovl_u8(vshr_n_u8(vld1_u8(sc + sb * 8), 4)));
+                    for (int r = 0; r < 4; r++) {
+                        const int16_t bsv = a[b].bsums[(sb / 4) * 16 + r * 4 + sb % 4];
+                        bi[r][0] = vmlal_n_s16(bi[r][0], vget_low_s16(mn), bsv);
+                        bi[r][1] = vmlal_n_s16(bi[r][1], vget_high_s16(mn), bsv);
+                    }
+                }
+                const float32x4_t wd0 = vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d)),    wd1 = vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + 4));
+                const float32x4_t wm0 = vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].dmin)), wm1 = vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].dmin + 4));
+                for (int r = 0; r < 4; r++) {
+                    const float ad = a[b].d[r];
+                    f[r][0] = vfmaq_f32(f[r][0], vmulq_n_f32(wd0, ad), vcvtq_f32_s32(t[r][0]));
+                    f[r][1] = vfmaq_f32(f[r][1], vmulq_n_f32(wd1, ad), vcvtq_f32_s32(t[r][1]));
+                    f[r][0] = vfmsq_f32(f[r][0], vmulq_n_f32(wm0, ad), vcvtq_f32_s32(bi[r][0]));
+                    f[r][1] = vfmsq_f32(f[r][1], vmulq_n_f32(wm1, ad), vcvtq_f32_s32(bi[r][1]));
+                }
+            }
+            for (int r = 0; r < 4; r++) {
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8,     f[r][0]);
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8 + 4, f[r][1]);
+            }
+        }
+    }
+}
+#else
+static void ggml_gemv_q2_K_8x4_q8_K_tv(int, float *, size_t, const void *, const void *, int, int) { GGML_ABORT("q2_K 8x4 needs dotprod"); }
+static void ggml_gemm_q2_K_8x4_q8_K_tv(int, float *, size_t, const void *, const void *, int, int) { GGML_ABORT("q2_K 8x4 needs dotprod"); }
+#endif
diff --git a/ggml/src/ggml-cpu/repack-tq-tv.inc b/ggml/src/ggml-cpu/repack-tq-tv.inc
new file mode 100644
index 0000000..ab5dc8d
--- /dev/null
+++ b/ggml/src/ggml-cpu/repack-tq-tv.inc
@@ -0,0 +1,446 @@
+// tvbox patch: repacked ternary TQ1_0 / TQ2_0 kernels for ARM dotprod without i8mm (Cortex-A55).
+// Upstream has no repacked kernel for the TQ types; the per-row vec_dot reloads the activation for every
+// 16 weights. Here 8 rows are interleaved 4 bytes at a time, so one decoded 16-byte vector feeds a
+// vdotq_laneq for 4 rows (gemv) or 4 rows x 4 activation rows (gemm). Same sizes as 8 plain blocks.
+// Measured by tools/kbench/kbench_tq.c on the TV (DRAM-sized matrix, 3 threads): TQ1_0 9.5 -> 14.4,
+// TQ2_0 11.9 -> 19.1 G weights/s.
+//   TQ1_0: qs[c*32 + j*4 + i] = row j's byte 4c+i of (qs[48] | qh[4]), c = 0..12
+//          chunk c < 8: trit k -> elements 32k + 4c + i;  8 <= c < 12: 160 + 16k + 4(c-8) + i;  c = 12: 240 + 4k + i
+//   TQ2_0: qs[c*32 + j*4 + i] = row j's qs[4c+i], c = 8h + 4g + lane: crumb s -> elements h*128 + 32s + 16g + 4*lane + i
+
+struct block_tq1_0x8 { ggml_half d[8]; uint8_t qs[416]; };
+struct block_tq2_0x8 { ggml_half d[8]; uint8_t qs[512]; };
+static_assert(sizeof(block_tq1_0x8) == 8 * sizeof(block_tq1_0), "tq1_0x8 size");
+static_assert(sizeof(block_tq2_0x8) == 8 * sizeof(block_tq2_0), "tq2_0x8 size");
+
+template <typename BIN, typename BOUT, int NCH>
+static int repack_tq_8x4_tv(struct ggml_tensor * t, const void * GGML_RESTRICT data, size_t data_size) {
+    const int nrow = ggml_nrows(t);
+    const int nblocks = t->ne[0] / QK_K;
+    GGML_ASSERT(data_size == (size_t) nrow * nblocks * sizeof(BIN));
+    if (t->ne[1] % 8 != 0) {
+        return -1;
+    }
+    const BIN * src = (const BIN *) data;
+    BOUT * dst = (BOUT *) t->data;
+    for (int r = 0; r < nrow; r += 8) {
+        for (int b = 0; b < nblocks; b++) {
+            BOUT o;
+            for (int j = 0; j < 8; j++) {
+                const BIN * in = &src[(size_t) (r + j) * nblocks + b];
+                o.d[j] = in->d;
+                const uint8_t * bytes = (const uint8_t *) in;   // qs (| qh) are the leading bytes of the block
+                for (int c = 0; c < NCH; c++) {
+                    memcpy(&o.qs[c * 32 + j * 4], bytes + c * 4, 4);
+                }
+            }
+            *dst++ = o;
+        }
+    }
+    return 0;
+}
+static_assert(offsetof(block_tq1_0, qh) == 48 && offsetof(block_tq1_0, d) == 52, "tq1_0 layout");
+static_assert(offsetof(block_tq2_0, d) == 64, "tq2_0 layout");
+
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+// trit of a pre-multiplied byte: (x * 3) >> 8, as in ggml's tq1_0 vec_dot
+#define TQTV_T3(v) vreinterpretq_s8_u8(vshrq_n_u8(vhaddq_u8((v), vshrq_n_u8((v), 1)), 6))
+
+static inline int32_t tqtv_row_sum(const block_q8_K * y) {
+    return vaddlvq_s16(vaddq_s16(vld1q_s16(y->bsums), vld1q_s16(y->bsums + 8)));
+}
+
+static void ggml_gemv_tq1_0_8x4_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    GGML_UNUSED(bs); GGML_UNUSED(nr);
+    const int nb = n / QK_K;
+    const block_q8_K * y = (const block_q8_K *) vy;
+    for (int x = 0; x < nc / 8; x++) {
+        const block_tq1_0x8 * w = (const block_tq1_0x8 *) vx + (size_t) x * nb;
+        float32x4_t f0 = vdupq_n_f32(0), f1 = vdupq_n_f32(0);
+        for (int b = 0; b < nb; b++) {
+            const int8_t * q8 = y[b].qs;
+            const uint8_t * qs = w[b].qs;
+            int32x4_t a0 = vdupq_n_s32(0), a1 = a0, e0 = a0, e1 = a0;
+#define TQ1TV_CH(QC, A, L) { const uint8x16_t u0 = vld1q_u8(QC), u1 = vld1q_u8((QC) + 16); \
+            a0 = vdotq_laneq_s32(a0, TQTV_T3(u0), A[0], L); a1 = vdotq_laneq_s32(a1, TQTV_T3(u1), A[0], L); \
+            uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(3)), v1 = vmulq_u8(u1, vdupq_n_u8(3)); \
+            e0 = vdotq_laneq_s32(e0, TQTV_T3(v0), A[1], L); e1 = vdotq_laneq_s32(e1, TQTV_T3(v1), A[1], L); \
+            v0 = vmulq_u8(u0, vdupq_n_u8(9)); v1 = vmulq_u8(u1, vdupq_n_u8(9)); \
+            a0 = vdotq_laneq_s32(a0, TQTV_T3(v0), A[2], L); a1 = vdotq_laneq_s32(a1, TQTV_T3(v1), A[2], L); \
+            v0 = vmulq_u8(u0, vdupq_n_u8(27)); v1 = vmulq_u8(u1, vdupq_n_u8(27)); \
+            e0 = vdotq_laneq_s32(e0, TQTV_T3(v0), A[3], L); e1 = vdotq_laneq_s32(e1, TQTV_T3(v1), A[3], L); \
+            v0 = vmulq_u8(u0, vdupq_n_u8(81)); v1 = vmulq_u8(u1, vdupq_n_u8(81)); \
+            a0 = vdotq_laneq_s32(a0, TQTV_T3(v0), A[4], L); a1 = vdotq_laneq_s32(a1, TQTV_T3(v1), A[4], L); }
+            for (int g = 0; g < 2; g++) {
+                int8x16_t A[5];
+                for (int k = 0; k < 5; k++) { A[k] = vld1q_s8(q8 + 32 * k + 16 * g); }
+                const uint8_t * qc = qs + g * 4 * 32;
+                TQ1TV_CH(qc, A, 0) TQ1TV_CH(qc + 32, A, 1) TQ1TV_CH(qc + 64, A, 2) TQ1TV_CH(qc + 96, A, 3)
+            }
+            {
+                int8x16_t A[5];
+                for (int k = 0; k < 5; k++) { A[k] = vld1q_s8(q8 + 160 + 16 * k); }
+                const uint8_t * qc = qs + 8 * 32;
+                TQ1TV_CH(qc, A, 0) TQ1TV_CH(qc + 32, A, 1) TQ1TV_CH(qc + 64, A, 2) TQ1TV_CH(qc + 96, A, 3)
+            }
+#undef TQ1TV_CH
+            {
+                const int8x16_t A = vld1q_s8(q8 + 240);
+                const uint8x16_t u0 = vld1q_u8(qs + 12 * 32), u1 = vld1q_u8(qs + 12 * 32 + 16);
+                a0 = vdotq_laneq_s32(a0, TQTV_T3(u0), A, 0); a1 = vdotq_laneq_s32(a1, TQTV_T3(u1), A, 0);
+                uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(3)), v1 = vmulq_u8(u1, vdupq_n_u8(3));
+                e0 = vdotq_laneq_s32(e0, TQTV_T3(v0), A, 1); e1 = vdotq_laneq_s32(e1, TQTV_T3(v1), A, 1);
+                v0 = vmulq_u8(u0, vdupq_n_u8(9)); v1 = vmulq_u8(u1, vdupq_n_u8(9));
+                a0 = vdotq_laneq_s32(a0, TQTV_T3(v0), A, 2); a1 = vdotq_laneq_s32(a1, TQTV_T3(v1), A, 2);
+                v0 = vmulq_u8(u0, vdupq_n_u8(27)); v1 = vmulq_u8(u1, vdupq_n_u8(27));
+                e0 = vdotq_laneq_s32(e0, TQTV_T3(v0), A, 3); e1 = vdotq_laneq_s32(e1, TQTV_T3(v1), A, 3);
+            }
+            const int32x4_t ys = vdupq_n_s32(tqtv_row_sum(&y[b]));
+            const float32x4_t yd = vdupq_n_f32(y[b].d);
+            f0 = vfmaq_f32(f0, vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d)),     yd), vcvtq_f32_s32(vsubq_s32(vaddq_s32(a0, e0), ys)));
+            f1 = vfmaq_f32(f1, vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + 4)), yd), vcvtq_f32_s32(vsubq_s32(vaddq_s32(a1, e1), ys)));
+        }
+        vst1q_f32(s + x * 8, f0);
+        vst1q_f32(s + x * 8 + 4, f1);
+    }
+}
+
+static void ggml_gemv_tq2_0_8x4_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    GGML_UNUSED(bs); GGML_UNUSED(nr);
+    const int nb = n / QK_K;
+    const block_q8_K * y = (const block_q8_K *) vy;
+    const uint8x16_t m03 = vdupq_n_u8(0x03), m0c = vdupq_n_u8(0x0C), m30 = vdupq_n_u8(0x30);
+    for (int x = 0; x < nc / 8; x++) {
+        const block_tq2_0x8 * w = (const block_tq2_0x8 *) vx + (size_t) x * nb;
+        float32x4_t f0 = vdupq_n_f32(0), f1 = vdupq_n_f32(0);
+        for (int b = 0; b < nb; b++) {
+            const int8_t * q8 = y[b].qs;
+            const uint8_t * qs = w[b].qs;
+            int32x4_t c00 = vdupq_n_s32(0), c01 = c00, c10 = c00, c11 = c00, c20 = c00, c21 = c00, c30 = c00, c31 = c00;
+            for (int h = 0; h < 2; h++) {
+                for (int g = 0; g < 2; g++) {
+                    const int8x16_t a0 = vld1q_s8(q8 + h * 128 + 16 * g),      a1 = vld1q_s8(q8 + h * 128 + 32 + 16 * g),
+                                    a2 = vld1q_s8(q8 + h * 128 + 64 + 16 * g), a3 = vld1q_s8(q8 + h * 128 + 96 + 16 * g);
+                    const uint8_t * qc = qs + (h * 8 + g * 4) * 32;
+#define TQ2TV_L(L) { const uint8x16_t w0 = vld1q_u8(qc + (L) * 32), w1 = vld1q_u8(qc + (L) * 32 + 16); \
+                    c00 = vdotq_laneq_s32(c00, vreinterpretq_s8_u8(vandq_u8(w0, m03)), a0, L); c01 = vdotq_laneq_s32(c01, vreinterpretq_s8_u8(vandq_u8(w1, m03)), a0, L); \
+                    c10 = vdotq_laneq_s32(c10, vreinterpretq_s8_u8(vandq_u8(w0, m0c)), a1, L); c11 = vdotq_laneq_s32(c11, vreinterpretq_s8_u8(vandq_u8(w1, m0c)), a1, L); \
+                    c20 = vdotq_laneq_s32(c20, vreinterpretq_s8_u8(vandq_u8(w0, m30)), a2, L); c21 = vdotq_laneq_s32(c21, vreinterpretq_s8_u8(vandq_u8(w1, m30)), a2, L); \
+                    c30 = vdotq_laneq_s32(c30, vreinterpretq_s8_u8(vshrq_n_u8(w0, 6)), a3, L); c31 = vdotq_laneq_s32(c31, vreinterpretq_s8_u8(vshrq_n_u8(w1, 6)), a3, L); }
+                    TQ2TV_L(0) TQ2TV_L(1) TQ2TV_L(2) TQ2TV_L(3)
+#undef TQ2TV_L
+                }
+            }
+            // crumb s was masked in place (value * 4^s): c1/c2 are exact multiples of 4 / 16
+            const int32x4_t ys = vdupq_n_s32(tqtv_row_sum(&y[b]));
+            const int32x4_t t0 = vsubq_s32(vaddq_s32(vaddq_s32(c00, c30), vaddq_s32(vshrq_n_s32(c10, 2), vshrq_n_s32(c20, 4))), ys);
+            const int32x4_t t1 = vsubq_s32(vaddq_s32(vaddq_s32(c01, c31), vaddq_s32(vshrq_n_s32(c11, 2), vshrq_n_s32(c21, 4))), ys);
+            const float32x4_t yd = vdupq_n_f32(y[b].d);
+            f0 = vfmaq_f32(f0, vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d)),     yd), vcvtq_f32_s32(t0));
+            f1 = vfmaq_f32(f1, vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + 4)), yd), vcvtq_f32_s32(t1));
+        }
+        vst1q_f32(s + x * 8, f0);
+        vst1q_f32(s + x * 8 + 4, f1);
+    }
+}
+
+// gemm: 4 activation rows in the block_q8_Kx4 layout (4-byte interleave): element group e (4 elements) of the
+// 4 rows is the 16 bytes at qs + e*4, row r = lane r. Row sums from bsums[(sb/4)*16 + r*4 + sb%4].
+#define TQTV_GEMM_DOT(D0, D1, E) { const int8x16_t av = vld1q_s8(q8 + (E) * 4); \
+    c[0][0] = vdotq_laneq_s32(c[0][0], D0, av, 0); c[0][1] = vdotq_laneq_s32(c[0][1], D1, av, 0); \
+    c[1][0] = vdotq_laneq_s32(c[1][0], D0, av, 1); c[1][1] = vdotq_laneq_s32(c[1][1], D1, av, 1); \
+    c[2][0] = vdotq_laneq_s32(c[2][0], D0, av, 2); c[2][1] = vdotq_laneq_s32(c[2][1], D1, av, 2); \
+    c[3][0] = vdotq_laneq_s32(c[3][0], D0, av, 3); c[3][1] = vdotq_laneq_s32(c[3][1], D1, av, 3); }
+
+static inline void tqtv_gemm_finish(float32x4_t f[4][2], int32x4_t c[4][2], const block_q8_Kx4 * a, const ggml_half * wd) {
+    const float32x4_t d0 = vcvt_f32_f16(vld1_f16((const __fp16 *) wd)), d1 = vcvt_f32_f16(vld1_f16((const __fp16 *) wd + 4));
+    for (int r = 0; r < 4; r++) {
+        int32_t ysum = 0;
+        for (int sb = 0; sb < 16; sb++) { ysum += a->bsums[(sb / 4) * 16 + r * 4 + sb % 4]; }
+        const int32x4_t ys = vdupq_n_s32(ysum);
+        f[r][0] = vfmaq_f32(f[r][0], vmulq_n_f32(d0, a->d[r]), vcvtq_f32_s32(vsubq_s32(c[r][0], ys)));
+        f[r][1] = vfmaq_f32(f[r][1], vmulq_n_f32(d1, a->d[r]), vcvtq_f32_s32(vsubq_s32(c[r][1], ys)));
+    }
+}
+
+static void ggml_gemm_tq1_0_8x4_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int nb = n / QK_K;
+    static const uint8_t mul[5] = { 1, 3, 9, 27, 81 };
+    for (int yb = 0; yb < nr / 4; yb++) {
+        const block_q8_Kx4 * a = (const block_q8_Kx4 *) vy + (size_t) yb * nb;
+        for (int x = 0; x < nc / 8; x++) {
+            const block_tq1_0x8 * w = (const block_tq1_0x8 *) vx + (size_t) x * nb;
+            float32x4_t f[4][2];
+            for (int r = 0; r < 4; r++) { f[r][0] = vdupq_n_f32(0); f[r][1] = vdupq_n_f32(0); }
+            for (int b = 0; b < nb; b++) {
+                const int8_t * q8 = a[b].qs;
+                const uint8_t * qs = w[b].qs;
+                int32x4_t c[4][2];
+                for (int r = 0; r < 4; r++) { c[r][0] = vdupq_n_s32(0); c[r][1] = vdupq_n_s32(0); }
+                for (int ch = 0; ch < 13; ch++) {
+                    const uint8x16_t u0 = vld1q_u8(qs + ch * 32), u1 = vld1q_u8(qs + ch * 32 + 16);
+                    const int ntrit = ch < 12 ? 5 : 4;
+                    for (int k = 0; k < ntrit; k++) {
+                        const uint8x16_t v0 = k ? vmulq_u8(u0, vdupq_n_u8(mul[k])) : u0;
+                        const uint8x16_t v1 = k ? vmulq_u8(u1, vdupq_n_u8(mul[k])) : u1;
+                        const int e = ch < 8 ? 32 * k + 4 * ch : ch < 12 ? 160 + 16 * k + 4 * (ch - 8) : 240 + 4 * k;
+                        const int8x16_t d0 = TQTV_T3(v0), d1 = TQTV_T3(v1);
+                        TQTV_GEMM_DOT(d0, d1, e)
+                    }
+                }
+                tqtv_gemm_finish(f, c, &a[b], w[b].d);
+            }
+            for (int r = 0; r < 4; r++) {
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8,     f[r][0]);
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8 + 4, f[r][1]);
+            }
+        }
+    }
+}
+
+static void ggml_gemm_tq2_0_8x4_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int nb = n / QK_K;
+    const uint8x16_t m3 = vdupq_n_u8(3);
+    for (int yb = 0; yb < nr / 4; yb++) {
+        const block_q8_Kx4 * a = (const block_q8_Kx4 *) vy + (size_t) yb * nb;
+        for (int x = 0; x < nc / 8; x++) {
+            const block_tq2_0x8 * w = (const block_tq2_0x8 *) vx + (size_t) x * nb;
+            float32x4_t f[4][2];
+            for (int r = 0; r < 4; r++) { f[r][0] = vdupq_n_f32(0); f[r][1] = vdupq_n_f32(0); }
+            for (int b = 0; b < nb; b++) {
+                const int8_t * q8 = a[b].qs;
+                const uint8_t * qs = w[b].qs;
+                int32x4_t c[4][2];
+                for (int r = 0; r < 4; r++) { c[r][0] = vdupq_n_s32(0); c[r][1] = vdupq_n_s32(0); }
+                for (int ch = 0; ch < 16; ch++) {
+                    const uint8x16_t u0 = vld1q_u8(qs + ch * 32), u1 = vld1q_u8(qs + ch * 32 + 16);
+                    const int h = ch / 8, g = (ch / 4) % 2, lane = ch % 4;
+                    { const int8x16_t d0 = vreinterpretq_s8_u8(vandq_u8(u0, m3)), d1 = vreinterpretq_s8_u8(vandq_u8(u1, m3));
+                      TQTV_GEMM_DOT(d0, d1, h * 128 + 16 * g + 4 * lane) }
+                    { const int8x16_t d0 = vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(u0, 2), m3)), d1 = vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(u1, 2), m3));
+                      TQTV_GEMM_DOT(d0, d1, h * 128 + 32 + 16 * g + 4 * lane) }
+                    { const int8x16_t d0 = vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(u0, 4), m3)), d1 = vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(u1, 4), m3));
+                      TQTV_GEMM_DOT(d0, d1, h * 128 + 64 + 16 * g + 4 * lane) }
+                    { const int8x16_t d0 = vreinterpretq_s8_u8(vshrq_n_u8(u0, 6)), d1 = vreinterpretq_s8_u8(vshrq_n_u8(u1, 6));
+                      TQTV_GEMM_DOT(d0, d1, h * 128 + 96 + 16 * g + 4 * lane) }
+                }
+                tqtv_gemm_finish(f, c, &a[b], w[b].d);
+            }
+            for (int r = 0; r < 4; r++) {
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8,     f[r][0]);
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8 + 4, f[r][1]);
+            }
+        }
+    }
+}
+#undef TQTV_GEMM_DOT
+#undef TQTV_T3
+#else
+static void ggml_gemv_tq1_0_8x4_q8_K_tv(int, float *, size_t, const void *, const void *, int, int) { GGML_ABORT("tq 8x4 needs dotprod"); }
+static void ggml_gemv_tq2_0_8x4_q8_K_tv(int, float *, size_t, const void *, const void *, int, int) { GGML_ABORT("tq 8x4 needs dotprod"); }
+static void ggml_gemm_tq1_0_8x4_q8_K_tv(int, float *, size_t, const void *, const void *, int, int) { GGML_ABORT("tq 8x4 needs dotprod"); }
+static void ggml_gemm_tq2_0_8x4_q8_K_tv(int, float *, size_t, const void *, const void *, int, int) { GGML_ABORT("tq 8x4 needs dotprod"); }
+#endif
+
+// ---- Q2_0 (group 64) holding ternary weights (PrismML Ternary-Bonsai) -> TQ1_0-style base-3 packing that keeps
+// the 4 per-64 scales: 480 bytes per 8 rows x 256 instead of 576 (1.875 bits/weight, lossless for ternary data).
+// Same 13-chunk trit layout as block_tq1_0x8; d[g*8 + j] = scale of row j's 64-group g. Each (chunk, trit) pair
+// lies inside one 64-group: chunks 0-7: trits 0,1 -> g0, 2,3 -> g1, 4 -> g2; chunks 8-11: 0,1 -> g2, 2-4 -> g3;
+// chunk 12 (4 trits) -> g3. The tensor is allocated at 5/6 of its file size (see the buffer type's get_alloc_size)
+// and row offsets inside it are scaled the same way (repack_rows_bytes).
+struct block_tq1g64x8 { ggml_half d[32]; uint8_t qs[416]; };
+static_assert(sizeof(block_tq1g64x8) * 6 == 8 * 4 * sizeof(block_q2_0) * 5, "tq1g64x8 size");
+
+static int repack_q2_0_to_tq1g64_tv(struct ggml_tensor * t, const void * GGML_RESTRICT data, size_t data_size) {
+    GGML_ASSERT(t->type == GGML_TYPE_Q2_0);
+    const int nrow = ggml_nrows(t);
+    const int nb64 = t->ne[0] / 64, nb = t->ne[0] / QK_K;
+    GGML_ASSERT(data_size == (size_t) nrow * nb64 * sizeof(block_q2_0));
+    if (t->ne[1] % 8 != 0 || t->ne[0] % QK_K != 0) {
+        return -1;
+    }
+    const block_q2_0 * src = (const block_q2_0 *) data;
+    block_tq1g64x8 * dst = (block_tq1g64x8 *) t->data;
+    for (int r = 0; r < nrow; r += 8) {
+        for (int b = 0; b < nb; b++) {
+            block_tq1g64x8 o;
+            for (int j = 0; j < 8; j++) {
+                uint8_t tr[QK_K];   // trit + 1 in {0, 1, 2}
+                for (int g = 0; g < 4; g++) {
+                    const block_q2_0 * in = &src[(size_t) (r + j) * nb64 + b * 4 + g];
+                    o.d[g * 8 + j] = in->d;
+                    for (int e = 0; e < 64; e++) {
+                        const uint8_t q = (in->qs[e / 4] >> (2 * (e % 4))) & 3;   // value q - 1
+                        if (q == 3) {
+                            GGML_ABORT("Q2_0 tensor %s is not ternary (value +2 found); run with GGML_Q2_0_TERNARY=0", t->name);
+                        }
+                        tr[g * 64 + e] = q;
+                    }
+                }
+                uint8_t bytes[52];   // packed exactly like quantize_row_tq1_0_ref
+                for (int m = 0; m < 32; m++) {
+                    unsigned q = 0;
+                    for (int k = 0; k < 5; k++) { q = q * 3 + tr[m + 32 * k]; }
+                    bytes[m] = (uint8_t) ((q * 256 + 242) / 243);
+                }
+                for (int m = 0; m < 16; m++) {
+                    unsigned q = 0;
+                    for (int k = 0; k < 5; k++) { q = q * 3 + tr[160 + m + 16 * k]; }
+                    bytes[32 + m] = (uint8_t) ((q * 256 + 242) / 243);
+                }
+                for (int m = 0; m < 4; m++) {
+                    unsigned q = 0;
+                    for (int k = 0; k < 4; k++) { q = q * 3 + tr[240 + m + 4 * k]; }
+                    q *= 3;
+                    bytes[48 + m] = (uint8_t) ((q * 256 + 242) / 243);
+                }
+                for (int c = 0; c < 13; c++) {
+                    memcpy(&o.qs[c * 32 + j * 4], bytes + c * 4, 4);
+                }
+            }
+            *dst++ = o;
+        }
+    }
+    return 0;
+}
+
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+#define TQTV_T3(v) vreinterpretq_s8_u8(vshrq_n_u8(vhaddq_u8((v), vshrq_n_u8((v), 1)), 6))
+
+static void ggml_gemv_q2_0_tq1g64_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    GGML_UNUSED(bs); GGML_UNUSED(nr);
+    const int nb = n / QK_K;
+    const block_q8_K * y = (const block_q8_K *) vy;
+    for (int x = 0; x < nc / 8; x++) {
+        const block_tq1g64x8 * w = (const block_tq1g64x8 *) vx + (size_t) x * nb;
+        float32x4_t f0 = vdupq_n_f32(0), f1 = vdupq_n_f32(0);
+        for (int b = 0; b < nb; b++) {
+            const int8_t * q8 = y[b].qs;
+            const uint8_t * qs = w[b].qs;
+            int32x4_t g00 = vdupq_n_s32(0), g01 = g00, g10 = g00, g11 = g00, g20 = g00, g21 = g00, g30 = g00, g31 = g00;
+            // one (chunk, trit) pair: decode + dot into the accumulators of its 64-group
+#define Q20TV_P(V0, V1, ACC0, ACC1, A, L) ACC0 = vdotq_laneq_s32(ACC0, TQTV_T3(V0), A, L); ACC1 = vdotq_laneq_s32(ACC1, TQTV_T3(V1), A, L);
+#define Q20TV_R1(QC, L) { const uint8x16_t u0 = vld1q_u8(QC), u1 = vld1q_u8((QC) + 16); \
+            Q20TV_P(u0, u1, g00, g01, A[0], L) \
+            { const uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(3)),  v1 = vmulq_u8(u1, vdupq_n_u8(3));  Q20TV_P(v0, v1, g00, g01, A[1], L) } \
+            { const uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(9)),  v1 = vmulq_u8(u1, vdupq_n_u8(9));  Q20TV_P(v0, v1, g10, g11, A[2], L) } \
+            { const uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(27)), v1 = vmulq_u8(u1, vdupq_n_u8(27)); Q20TV_P(v0, v1, g10, g11, A[3], L) } \
+            { const uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(81)), v1 = vmulq_u8(u1, vdupq_n_u8(81)); Q20TV_P(v0, v1, g20, g21, A[4], L) } }
+#define Q20TV_R2(QC, L) { const uint8x16_t u0 = vld1q_u8(QC), u1 = vld1q_u8((QC) + 16); \
+            Q20TV_P(u0, u1, g20, g21, A[0], L) \
+            { const uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(3)),  v1 = vmulq_u8(u1, vdupq_n_u8(3));  Q20TV_P(v0, v1, g20, g21, A[1], L) } \
+            { const uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(9)),  v1 = vmulq_u8(u1, vdupq_n_u8(9));  Q20TV_P(v0, v1, g30, g31, A[2], L) } \
+            { const uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(27)), v1 = vmulq_u8(u1, vdupq_n_u8(27)); Q20TV_P(v0, v1, g30, g31, A[3], L) } \
+            { const uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(81)), v1 = vmulq_u8(u1, vdupq_n_u8(81)); Q20TV_P(v0, v1, g30, g31, A[4], L) } }
+            for (int h = 0; h < 2; h++) {
+                int8x16_t A[5];
+                for (int k = 0; k < 5; k++) { A[k] = vld1q_s8(q8 + 32 * k + 16 * h); }
+                const uint8_t * qc = qs + h * 4 * 32;
+                Q20TV_R1(qc, 0) Q20TV_R1(qc + 32, 1) Q20TV_R1(qc + 64, 2) Q20TV_R1(qc + 96, 3)
+            }
+            {
+                int8x16_t A[5];
+                for (int k = 0; k < 5; k++) { A[k] = vld1q_s8(q8 + 160 + 16 * k); }
+                const uint8_t * qc = qs + 8 * 32;
+                Q20TV_R2(qc, 0) Q20TV_R2(qc + 32, 1) Q20TV_R2(qc + 64, 2) Q20TV_R2(qc + 96, 3)
+            }
+            {
+                const int8x16_t A = vld1q_s8(q8 + 240);
+                const uint8x16_t u0 = vld1q_u8(qs + 12 * 32), u1 = vld1q_u8(qs + 12 * 32 + 16);
+                Q20TV_P(u0, u1, g30, g31, A, 0)
+                { const uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(3)),  v1 = vmulq_u8(u1, vdupq_n_u8(3));  Q20TV_P(v0, v1, g30, g31, A, 1) }
+                { const uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(9)),  v1 = vmulq_u8(u1, vdupq_n_u8(9));  Q20TV_P(v0, v1, g30, g31, A, 2) }
+                { const uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(27)), v1 = vmulq_u8(u1, vdupq_n_u8(27)); Q20TV_P(v0, v1, g30, g31, A, 3) }
+            }
+#undef Q20TV_R1
+#undef Q20TV_R2
+#undef Q20TV_P
+            // per group: d_g * (sum t*a - sum a) with the group's activation sum from bsums[4g .. 4g+3]
+            int32_t ysum[4];
+            for (int g = 0; g < 4; g++) {
+                ysum[g] = y[b].bsums[4 * g] + y[b].bsums[4 * g + 1] + y[b].bsums[4 * g + 2] + y[b].bsums[4 * g + 3];
+            }
+            const float yd = y[b].d;
+#define Q20TV_G(G, A0, A1) { \
+            const float32x4_t d0 = vmulq_n_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + (G) * 8)), yd); \
+            const float32x4_t d1 = vmulq_n_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + (G) * 8 + 4)), yd); \
+            const int32x4_t ys = vdupq_n_s32(ysum[G]); \
+            f0 = vfmaq_f32(f0, d0, vcvtq_f32_s32(vsubq_s32(A0, ys))); f1 = vfmaq_f32(f1, d1, vcvtq_f32_s32(vsubq_s32(A1, ys))); }
+            Q20TV_G(0, g00, g01) Q20TV_G(1, g10, g11) Q20TV_G(2, g20, g21) Q20TV_G(3, g30, g31)
+#undef Q20TV_G
+        }
+        vst1q_f32(s + x * 8, f0);
+        vst1q_f32(s + x * 8 + 4, f1);
+    }
+}
+
+// gemm: one 64-group at a time (its 16 (chunk, trit) pairs written out), 4 activation rows per decoded vector.
+static void ggml_gemm_q2_0_tq1g64_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int nb = n / QK_K;
+    for (int yb = 0; yb < nr / 4; yb++) {
+        const block_q8_Kx4 * a = (const block_q8_Kx4 *) vy + (size_t) yb * nb;
+        for (int x = 0; x < nc / 8; x++) {
+            const block_tq1g64x8 * w = (const block_tq1g64x8 *) vx + (size_t) x * nb;
+            float32x4_t f[4][2];
+            for (int r = 0; r < 4; r++) { f[r][0] = vdupq_n_f32(0); f[r][1] = vdupq_n_f32(0); }
+            for (int b = 0; b < nb; b++) {
+                const int8_t * q8 = a[b].qs;
+                const uint8_t * qs = w[b].qs;
+                int32x4_t c[4][2];
+#define Q20G_ZERO() for (int r = 0; r < 4; r++) { c[r][0] = vdupq_n_s32(0); c[r][1] = vdupq_n_s32(0); }
+#define Q20G_DOT(V0, V1, E) { const int8x16_t d0 = TQTV_T3(V0), d1 = TQTV_T3(V1); const int8x16_t av = vld1q_s8(q8 + (E) * 4); \
+                c[0][0] = vdotq_laneq_s32(c[0][0], d0, av, 0); c[0][1] = vdotq_laneq_s32(c[0][1], d1, av, 0); \
+                c[1][0] = vdotq_laneq_s32(c[1][0], d0, av, 1); c[1][1] = vdotq_laneq_s32(c[1][1], d1, av, 1); \
+                c[2][0] = vdotq_laneq_s32(c[2][0], d0, av, 2); c[2][1] = vdotq_laneq_s32(c[2][1], d1, av, 2); \
+                c[3][0] = vdotq_laneq_s32(c[3][0], d0, av, 3); c[3][1] = vdotq_laneq_s32(c[3][1], d1, av, 3); }
+#define Q20G_MUL(U, M) vmulq_u8(U, vdupq_n_u8(M))
+#define Q20G_LOAD(CH) const uint8x16_t u0 = vld1q_u8(qs + (CH) * 32), u1 = vld1q_u8(qs + (CH) * 32 + 16);
+#define Q20G_FINISH(G) { \
+                const float32x4_t wd0 = vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + (G) * 8)); \
+                const float32x4_t wd1 = vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + (G) * 8 + 4)); \
+                for (int r = 0; r < 4; r++) { \
+                    const int16_t * bsr = a[b].bsums + (G) * 16 + r * 4; \
+                    const int32x4_t ys = vdupq_n_s32(bsr[0] + bsr[1] + bsr[2] + bsr[3]); \
+                    f[r][0] = vfmaq_f32(f[r][0], vmulq_n_f32(wd0, a[b].d[r]), vcvtq_f32_s32(vsubq_s32(c[r][0], ys))); \
+                    f[r][1] = vfmaq_f32(f[r][1], vmulq_n_f32(wd1, a[b].d[r]), vcvtq_f32_s32(vsubq_s32(c[r][1], ys))); \
+                } }
+                // g0: chunks 0-7, trits 0, 1
+                Q20G_ZERO()
+                for (int ch = 0; ch < 8; ch++) { Q20G_LOAD(ch) Q20G_DOT(u0, u1, 4 * ch) Q20G_DOT(Q20G_MUL(u0, 3), Q20G_MUL(u1, 3), 32 + 4 * ch) }
+                Q20G_FINISH(0)
+                // g1: chunks 0-7, trits 2, 3
+                Q20G_ZERO()
+                for (int ch = 0; ch < 8; ch++) { Q20G_LOAD(ch) Q20G_DOT(Q20G_MUL(u0, 9), Q20G_MUL(u1, 9), 64 + 4 * ch) Q20G_DOT(Q20G_MUL(u0, 27), Q20G_MUL(u1, 27), 96 + 4 * ch) }
+                Q20G_FINISH(1)
+                // g2: chunks 0-7 trit 4; chunks 8-11 trits 0, 1
+                Q20G_ZERO()
+                for (int ch = 0; ch < 8; ch++) { Q20G_LOAD(ch) Q20G_DOT(Q20G_MUL(u0, 81), Q20G_MUL(u1, 81), 128 + 4 * ch) }
+                for (int ch = 8; ch < 12; ch++) { Q20G_LOAD(ch) Q20G_DOT(u0, u1, 160 + 4 * (ch - 8)) Q20G_DOT(Q20G_MUL(u0, 3), Q20G_MUL(u1, 3), 176 + 4 * (ch - 8)) }
+                Q20G_FINISH(2)
+                // g3: chunks 8-11 trits 2-4; chunk 12 (qh) trits 0-3
+                Q20G_ZERO()
+                for (int ch = 8; ch < 12; ch++) { Q20G_LOAD(ch)
+                    Q20G_DOT(Q20G_MUL(u0, 9), Q20G_MUL(u1, 9), 192 + 4 * (ch - 8))
+                    Q20G_DOT(Q20G_MUL(u0, 27), Q20G_MUL(u1, 27), 208 + 4 * (ch - 8))
+                    Q20G_DOT(Q20G_MUL(u0, 81), Q20G_MUL(u1, 81), 224 + 4 * (ch - 8)) }
+                { Q20G_LOAD(12) Q20G_DOT(u0, u1, 240) Q20G_DOT(Q20G_MUL(u0, 3), Q20G_MUL(u1, 3), 244)
+                  Q20G_DOT(Q20G_MUL(u0, 9), Q20G_MUL(u1, 9), 248) Q20G_DOT(Q20G_MUL(u0, 27), Q20G_MUL(u1, 27), 252) }
+                Q20G_FINISH(3)
+#undef Q20G_ZERO
+#undef Q20G_DOT
+#undef Q20G_MUL
+#undef Q20G_LOAD
+#undef Q20G_FINISH
+            }
+            for (int r = 0; r < 4; r++) {
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8,     f[r][0]);
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8 + 4, f[r][1]);
+            }
+        }
+    }
+}
+#undef TQTV_T3
+#else
+static void ggml_gemv_q2_0_tq1g64_q8_K_tv(int, float *, size_t, const void *, const void *, int, int) { GGML_ABORT("needs dotprod"); }
+static void ggml_gemm_q2_0_tq1g64_q8_K_tv(int, float *, size_t, const void *, const void *, int, int) { GGML_ABORT("needs dotprod"); }
+#endif
