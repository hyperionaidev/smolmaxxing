+    const uint8x16_t m3 = vdupq_n_u8(3);
+#define Q20C_FIN64(G) { \
+    const float32x4_t wd0 = vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + (G) * 8)); \
+    const float32x4_t wd1 = vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + (G) * 8 + 4)); \
+    for (int r = 0; r < 4; r++) { \
+        const int16_t * bsr = a[b].bsums + (G) * 16 + r * 4; \
+        const int32x4_t ys = vdupq_n_s32(bsr[0] + bsr[1] + bsr[2] + bsr[3]); \
+        f[r][0] = vfmaq_f32(f[r][0], vmulq_n_f32(wd0, a[b].d[r]), vcvtq_f32_s32(vsubq_s32(c[r][0], ys))); \
+        f[r][1] = vfmaq_f32(f[r][1], vmulq_n_f32(wd1, a[b].d[r]), vcvtq_f32_s32(vsubq_s32(c[r][1], ys))); \
+    } }
+    for (int yb = 0; yb < nr / 4; yb++) {
+        const block_q8_Kx4 * a = (const block_q8_Kx4 *) vy + (size_t) yb * nb;
+        for (int x = 0; x < nc / 8; x++) {
+            const block_t2g64x8 * w = (const block_t2g64x8 *) vx + (size_t) x * nb;
+            float32x4_t f[4][2];
+            for (int r = 0; r < 4; r++) { f[r][0] = vdupq_n_f32(0); f[r][1] = vdupq_n_f32(0); }
+            for (int b = 0; b < nb; b++) {
+                const int8_t * q8 = a[b].qs;
+                const uint8_t * qs = w[b].qs;
+                int32x4_t c[4][2];
+                for (int h = 0; h < 2; h++) {
+                    Q20C_ZERO()
+                    for (int ch = 8 * h; ch < 8 * h + 8; ch++) {
+                        const uint8x16_t u0 = vld1q_u8(qs + ch * 32), u1 = vld1q_u8(qs + ch * 32 + 16);
+                        const int g = (ch / 4) % 2, lane = ch % 4;
+                        { const int8x16_t d0 = vreinterpretq_s8_u8(vandq_u8(u0, m3)), d1 = vreinterpretq_s8_u8(vandq_u8(u1, m3));
+                          Q20C_DOT(d0, d1, h * 128 + 16 * g + 4 * lane) }
+                        { const int8x16_t d0 = vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(u0, 2), m3)), d1 = vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(u1, 2), m3));
+                          Q20C_DOT(d0, d1, h * 128 + 32 + 16 * g + 4 * lane) }
+                    }
+                    Q20C_FIN64(2 * h)
+                    Q20C_ZERO()
+                    for (int ch = 8 * h; ch < 8 * h + 8; ch++) {
+                        const uint8x16_t u0 = vld1q_u8(qs + ch * 32), u1 = vld1q_u8(qs + ch * 32 + 16);
+                        const int g = (ch / 4) % 2, lane = ch % 4;
+                        { const int8x16_t d0 = vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(u0, 4), m3)), d1 = vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(u1, 4), m3));
+                          Q20C_DOT(d0, d1, h * 128 + 64 + 16 * g + 4 * lane) }
+                        { const int8x16_t d0 = vreinterpretq_s8_u8(vshrq_n_u8(u0, 6)), d1 = vreinterpretq_s8_u8(vshrq_n_u8(u1, 6));
