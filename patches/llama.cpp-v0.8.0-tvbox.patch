+                const int32x4_t t1 = vsubq_s32(vaddq_s32(vaddq_s32(c01, c31), vaddq_s32(vshrq_n_s32(c11, 2), vshrq_n_s32(c21, 4))), ys);
+                f0 = vfmaq_f32(f0, vmulq_n_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + h * 8)),     yd), vcvtq_f32_s32(t0));
+                f1 = vfmaq_f32(f1, vmulq_n_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + h * 8 + 4)), yd), vcvtq_f32_s32(t1));
+            }
+        }
+        vst1q_f32(s + x * 8, f0);
+        vst1q_f32(s + x * 8 + 4, f1);
+    }
+}
+
+// crumbs s = 0, 1 of half h are 64-group 2h; s = 2, 3 are group 2h + 1
+static void ggml_gemv_q2_0_f2g64_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    GGML_UNUSED(bs); GGML_UNUSED(nr);
+    const int nb = n / QK_K;
+    const block_q8_K * y = (const block_q8_K *) vy;
+    const uint8x16_t m03 = vdupq_n_u8(0x03), m0c = vdupq_n_u8(0x0C), m30 = vdupq_n_u8(0x30);
+    for (int x = 0; x < nc / 8; x++) {
+        const block_t2g64x8 * w = (const block_t2g64x8 *) vx + (size_t) x * nb;
+        float32x4_t f0 = vdupq_n_f32(0), f1 = vdupq_n_f32(0);
+        for (int b = 0; b < nb; b++) {
+            const int8_t * q8 = y[b].qs;
+            const uint8_t * qs = w[b].qs;
+            const float yd = y[b].d;
+            for (int h = 0; h < 2; h++) {
+                int32x4_t c00 = vdupq_n_s32(0), c01 = c00, c10 = c00, c11 = c00, c20 = c00, c21 = c00, c30 = c00, c31 = c00;
+                for (int g = 0; g < 2; g++) {
+                    const int8x16_t a0 = vld1q_s8(q8 + h * 128 + 16 * g),      a1 = vld1q_s8(q8 + h * 128 + 32 + 16 * g),
+                                    a2 = vld1q_s8(q8 + h * 128 + 64 + 16 * g), a3 = vld1q_s8(q8 + h * 128 + 96 + 16 * g);
+                    const uint8_t * qc = qs + (h * 8 + g * 4) * 32;
+#define Q20C_L(L) { const uint8x16_t w0 = vld1q_u8(qc + (L) * 32), w1 = vld1q_u8(qc + (L) * 32 + 16); \
+                    c00 = vdotq_laneq_s32(c00, vreinterpretq_s8_u8(vandq_u8(w0, m03)), a0, L); c01 = vdotq_laneq_s32(c01, vreinterpretq_s8_u8(vandq_u8(w1, m03)), a0, L); \
+                    c10 = vdotq_laneq_s32(c10, vreinterpretq_s8_u8(vandq_u8(w0, m0c)), a1, L); c11 = vdotq_laneq_s32(c11, vreinterpretq_s8_u8(vandq_u8(w1, m0c)), a1, L); \
+                    c20 = vdotq_laneq_s32(c20, vreinterpretq_s8_u8(vandq_u8(w0, m30)), a2, L); c21 = vdotq_laneq_s32(c21, vreinterpretq_s8_u8(vandq_u8(w1, m30)), a2, L); \
+                    c30 = vdotq_laneq_s32(c30, vreinterpretq_s8_u8(vshrq_n_u8(w0, 6)), a3, L); c31 = vdotq_laneq_s32(c31, vreinterpretq_s8_u8(vshrq_n_u8(w1, 6)), a3, L); }
+                    Q20C_L(0) Q20C_L(1) Q20C_L(2) Q20C_L(3)
+#undef Q20C_L
+                }
+                int32_t ya = 0, yb = 0;
+                for (int g = 0; g < 4; g++) { ya += y[b].bsums[h * 8 + g]; yb += y[b].bsums[h * 8 + 4 + g]; }
+                const int32x4_t ysa = vdupq_n_s32(ya), ysb = vdupq_n_s32(yb);
+                const int32x4_t ta0 = vsubq_s32(vaddq_s32(c00, vshrq_n_s32(c10, 2)), ysa), ta1 = vsubq_s32(vaddq_s32(c01, vshrq_n_s32(c11, 2)), ysa);
+                const int32x4_t tb0 = vsubq_s32(vaddq_s32(vshrq_n_s32(c20, 4), c30), ysb), tb1 = vsubq_s32(vaddq_s32(vshrq_n_s32(c21, 4), c31), ysb);
+                const __fp16 * wd = (const __fp16 *) w[b].d + h * 16;
+                f0 = vfmaq_f32(f0, vmulq_n_f32(vcvt_f32_f16(vld1_f16(wd)),      yd), vcvtq_f32_s32(ta0));
+                f1 = vfmaq_f32(f1, vmulq_n_f32(vcvt_f32_f16(vld1_f16(wd + 4)),  yd), vcvtq_f32_s32(ta1));
+                f0 = vfmaq_f32(f0, vmulq_n_f32(vcvt_f32_f16(vld1_f16(wd + 8)),  yd), vcvtq_f32_s32(tb0));
+                f1 = vfmaq_f32(f1, vmulq_n_f32(vcvt_f32_f16(vld1_f16(wd + 12)), yd), vcvtq_f32_s32(tb1));
+            }
+        }
+        vst1q_f32(s + x * 8, f0);
+        vst1q_f32(s + x * 8 + 4, f1);
+    }
+}
+
+// gemm: 4 activation rows per decoded vector (block_q8_Kx4: element group e is the 16 bytes at qs + e*4)
+#define Q20C_DOT(D0, D1, E) { const int8x16_t av = vld1q_s8(q8 + (E) * 4); \
+    c[0][0] = vdotq_laneq_s32(c[0][0], D0, av, 0); c[0][1] = vdotq_laneq_s32(c[0][1], D1, av, 0); \
+    c[1][0] = vdotq_laneq_s32(c[1][0], D0, av, 1); c[1][1] = vdotq_laneq_s32(c[1][1], D1, av, 1); \
+    c[2][0] = vdotq_laneq_s32(c[2][0], D0, av, 2); c[2][1] = vdotq_laneq_s32(c[2][1], D1, av, 2); \
+    c[3][0] = vdotq_laneq_s32(c[3][0], D0, av, 3); c[3][1] = vdotq_laneq_s32(c[3][1], D1, av, 3); }
+#define Q20C_ZERO() for (int r = 0; r < 4; r++) { c[r][0] = vdupq_n_s32(0); c[r][1] = vdupq_n_s32(0); }
+// bsums of block_q8_Kx4: 4 per row per 64-group, group G at bsums + G*16 + r*4
+#define Q20C_FINISH(H) { \
+    const float32x4_t wd0 = vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + (H) * 8)); \
+    const float32x4_t wd1 = vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + (H) * 8 + 4)); \
+    for (int r = 0; r < 4; r++) { \
+        int32_t ysum = 0; \
+        for (int G = 2 * (H); G < 2 * (H) + 2; G++) { const int16_t * bsr = a[b].bsums + G * 16 + r * 4; ysum += bsr[0] + bsr[1] + bsr[2] + bsr[3]; } \
+        const int32x4_t ys = vdupq_n_s32(ysum); \
+        f[r][0] = vfmaq_f32(f[r][0], vmulq_n_f32(wd0, a[b].d[r]), vcvtq_f32_s32(vsubq_s32(c[r][0], ys))); \
+        f[r][1] = vfmaq_f32(f[r][1], vmulq_n_f32(wd1, a[b].d[r]), vcvtq_f32_s32(vsubq_s32(c[r][1], ys))); \
+    } }
+
+static void ggml_gemm_q2_0_g128_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int nb = n / QK_K;
+    for (int yb = 0; yb < nr / 4; yb++) {
+        const block_q8_Kx4 * a = (const block_q8_Kx4 *) vy + (size_t) yb * nb;
+        for (int x = 0; x < nc / 8; x++) {
+            const block_tq1g128x8 * w = (const block_tq1g128x8 *) vx + (size_t) x * nb;
+            float32x4_t f[4][2];
+            for (int r = 0; r < 4; r++) { f[r][0] = vdupq_n_f32(0); f[r][1] = vdupq_n_f32(0); }
+            for (int b = 0; b < nb; b++) {
+                const int8_t * q8 = a[b].qs;
+                const uint8_t * qs = w[b].qs;
+                int32x4_t c[4][2];
+#define Q20C_T(U, M) Q20C_T3(vmulq_u8(U, vdupq_n_u8(M)))
+                Q20C_ZERO()
+                for (int ch = 0; ch < 8; ch++) {
+                    const uint8x16_t u0 = vld1q_u8(qs + ch * 32), u1 = vld1q_u8(qs + ch * 32 + 16);
+                    { const int8x16_t d0 = Q20C_T3(u0), d1 = Q20C_T3(u1); Q20C_DOT(d0, d1, 4 * ch) }
+                    { const int8x16_t d0 = Q20C_T(u0, 3), d1 = Q20C_T(u1, 3); Q20C_DOT(d0, d1, 32 + 4 * ch) }
+                    { const int8x16_t d0 = Q20C_T(u0, 9), d1 = Q20C_T(u1, 9); Q20C_DOT(d0, d1, 64 + 4 * ch) }
+                    { const int8x16_t d0 = Q20C_T(u0, 27), d1 = Q20C_T(u1, 27); Q20C_DOT(d0, d1, 96 + 4 * ch) }
+                }
+                Q20C_FINISH(0)
+                Q20C_ZERO()
+                for (int ch = 0; ch < 8; ch++) {
+                    const uint8x16_t u0 = vld1q_u8(qs + ch * 32), u1 = vld1q_u8(qs + ch * 32 + 16);
+                    const int8x16_t d0 = Q20C_T(u0, 81), d1 = Q20C_T(u1, 81); Q20C_DOT(d0, d1, 128 + 4 * ch)
+                }
+                for (int ch = 8; ch < 12; ch++) {
+                    const uint8x16_t u0 = vld1q_u8(qs + ch * 32), u1 = vld1q_u8(qs + ch * 32 + 16);
+                    const int e = 4 * (ch - 8);
+                    { const int8x16_t d0 = Q20C_T3(u0), d1 = Q20C_T3(u1); Q20C_DOT(d0, d1, 160 + e) }
+                    { const int8x16_t d0 = Q20C_T(u0, 3), d1 = Q20C_T(u1, 3); Q20C_DOT(d0, d1, 176 + e) }
+                    { const int8x16_t d0 = Q20C_T(u0, 9), d1 = Q20C_T(u1, 9); Q20C_DOT(d0, d1, 192 + e) }
+                    { const int8x16_t d0 = Q20C_T(u0, 27), d1 = Q20C_T(u1, 27); Q20C_DOT(d0, d1, 208 + e) }
+                    { const int8x16_t d0 = Q20C_T(u0, 81), d1 = Q20C_T(u1, 81); Q20C_DOT(d0, d1, 224 + e) }
+                }
+                {
+                    const uint8x16_t u0 = vld1q_u8(qs + 12 * 32), u1 = vld1q_u8(qs + 12 * 32 + 16);
+                    { const int8x16_t d0 = Q20C_T3(u0), d1 = Q20C_T3(u1); Q20C_DOT(d0, d1, 240) }
+                    { const int8x16_t d0 = Q20C_T(u0, 3), d1 = Q20C_T(u1, 3); Q20C_DOT(d0, d1, 244) }
+                    { const int8x16_t d0 = Q20C_T(u0, 9), d1 = Q20C_T(u1, 9); Q20C_DOT(d0, d1, 248) }
+                    { const int8x16_t d0 = Q20C_T(u0, 27), d1 = Q20C_T(u1, 27); Q20C_DOT(d0, d1, 252) }
+                }
+                Q20C_FINISH(1)
+#undef Q20C_T
+            }
+            for (int r = 0; r < 4; r++) {
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8,     f[r][0]);
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8 + 4, f[r][1]);
+            }
+        }
+    }
+}
