+// tvbox: activation-sparsity simulation (TEAL / CATS style, training-free). LLAMA_SPARSE_SIM="a,d,g": before every
+// layer mat-mul, keep only the largest-magnitude (1-a) fraction of the input entries per token (d for ffn_down,
+// whose input is the SwiGLU output), counted in groups of g consecutive input dims (by group L2 norm; g=1 =
+// single entries). Zeroed inputs mean the matching weight columns need not be read: this measures the quality cost.
+struct tvbox_sparse_cfg { float frac; int group; };
+static void tvbox_sparse_op(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * ud) {
+    const tvbox_sparse_cfg * c = (const tvbox_sparse_cfg *) ud;
+    const int64_t n = a->ne[0], rows = ggml_nrows(a), g = c->group, ng = n / g;
+    std::vector<float> nrm(ng), tmp(ng);
+    for (int64_t r = ith; r < rows; r += nth) {
+        const float * x = (const float *) ((const char *) a->data + r * a->nb[1]);
+        float * y = (float *) ((char *) dst->data + r * dst->nb[1]);
+        for (int64_t j = 0; j < ng; j++) { float s = 0; for (int64_t k = 0; k < g; k++) s += x[j*g+k]*x[j*g+k]; nrm[j] = s; }
+        const int64_t kill = (int64_t) (c->frac * ng);
+        float thr = -1.0f;
+        if (kill > 0) { tmp = nrm; std::nth_element(tmp.begin(), tmp.begin() + (kill - 1), tmp.end()); thr = tmp[kill - 1]; }
+        int64_t killed = 0;
+        for (int64_t j = 0; j < ng; j++) {
+            const bool z = nrm[j] <= thr && killed < kill;
+            killed += z;
+            for (int64_t k = 0; k < g; k++) y[j*g+k] = z ? 0.0f : x[j*g+k];
+        }
+        for (int64_t i = ng * g; i < n; i++) y[i] = x[i];
+    }
+}
