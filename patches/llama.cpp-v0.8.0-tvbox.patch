+static void tv_head_embd_rows(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    const auto * m = (const tv_head_embd_map *) userdata;
+    const ggml_tensor * embd = dst->src[0];
+    const ggml_tensor * head = dst->src[1];
+    const ggml_tensor * toks = dst->src[2];
+    const auto to_float = ggml_get_type_traits(embd->type)->to_float;
+    uint8_t tmp[64 * 144];
+    const int64_t n = toks->ne[0];
+    for (int64_t i = ith; i < n; i += nth) {
+        const int32_t t = ((const int32_t *) toks->data)[i];
+        const int32_t r = (t >= 0 && (size_t) t < m->inv.size()) ? m->inv[t] : -1;
+        const char * src;
+        if (r < 0) {
+            src = (const char *) embd->data + (int64_t) t * embd->nb[1];
+        } else if (m->il) {
+            tv_q4kx8_row((const uint8_t *) head->data, r, head->ne[0] / 256, m->il, tmp);
+            src = (const char *) tmp;
+        } else {
+            src = (const char *) head->data + (int64_t) r * head->nb[1];
+        }
+        to_float(src, (float *) ((char *) dst->data + i * dst->nb[1]), dst->ne[0]);
+    }
