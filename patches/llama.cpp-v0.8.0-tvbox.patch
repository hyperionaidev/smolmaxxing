+// tvbox: the one-token decode step of the DeltaNet causal conv as one op. Stock: GET_ROWS (state gather) + CONCAT
+// (state | new column, transposed) + CPY (shifted state back into the cache) + SSM_CONV = 4 nodes and 4 barriers for
+// a 4-tap filter over 6,144 channels (~110 us). Here each channel reads its K-1 old values at row s_copy[0] of the
+// cache, writes the shifted window to the destination row (src[0], a view at rs_head; in place when the rows are
+// the same, which is safe per channel) and sums the taps in SSM_CONV's order, so the result is bit-identical.
+// SILU stays a separate (column-split) op. LLAMA_CONV_FUSED=0 = stock.
+static void qwen35_conv_step(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(userdata);
+    const ggml_tensor * dstate = dst->src[0]; // cache view at the destination row
+    const ggml_tensor * cache  = dst->src[1]; // whole conv cache {n_embd_r, rs_size}
+    const ggml_tensor * xin    = dst->src[2]; // new column {C}
+    const ggml_tensor * kern   = dst->src[3]; // {K, C}
+    const ggml_tensor * ids    = dst->src[4]; // s_copy_main {1}
+    const int64_t C  = dst->ne[0];
+    const int     nc = (int) kern->ne[0];
+    const int     ns = nc - 1;
+    const int32_t row = ((const int32_t *) ids->data)[0];
+    const float * sp = (const float *) ((const char *) cache->data + (int64_t) row * cache->nb[1]);
+    float       * dp = (float *) dstate->data;
+    const float * x  = (const float *) xin->data;
+    float       * y  = (float *) dst->data;
+    const int64_t per = (C + nth - 1) / nth;
+    const int64_t c0  = per * ith;
+    const int64_t c1  = std::min(C, c0 + per);
+    int64_t c = c0;
