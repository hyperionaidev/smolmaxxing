+                        f[r][1] = vfmaq_f32(f[r][1], vmulq_n_f32(wd1, a[b].d[r]), vcvtq_f32_s32(i1));
+                    }
+                }
+            }
+            for (int r = 0; r < 4; r++) {
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8,     f[r][0]);
+                vst1q_f32(s + (size_t) (yb * 4 + r) * bs + x * 8 + 4, f[r][1]);
