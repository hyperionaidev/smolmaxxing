+            }
+        }
+    }
+}
+#else
+static void ggml_gemv_q2_K_8x4_q8_K_tv(int, float *, size_t, const void *, const void *, int, int) { GGML_ABORT("q2_K 8x4 needs dotprod"); }
+static void ggml_gemm_q2_K_8x4_q8_K_tv(int, float *, size_t, const void *, const void *, int, int) { GGML_ABORT("q2_K 8x4 needs dotprod"); }
+#endif
diff --git a/ggml/src/ggml-cpu/repack-tq-tv.inc b/ggml/src/ggml-cpu/repack-tq-tv.inc
new file mode 100644
index 0000000..ab5dc8d
--- /dev/null
+++ b/ggml/src/ggml-cpu/repack-tq-tv.inc
@@ -0,0 +1,446 @@
+// tvbox patch: repacked ternary TQ1_0 / TQ2_0 kernels for ARM dotprod without i8mm (Cortex-A55).
+// Upstream has no repacked kernel for the TQ types; the per-row vec_dot reloads the activation for every
+// 16 weights. Here 8 rows are interleaved 4 bytes at a time, so one decoded 16-byte vector feeds a
+// vdotq_laneq for 4 rows (gemv) or 4 rows x 4 activation rows (gemm). Same sizes as 8 plain blocks.
+// Measured by tools/kbench/kbench_tq.c on the TV (DRAM-sized matrix, 3 threads): TQ1_0 9.5 -> 14.4,
+// TQ2_0 11.9 -> 19.1 G weights/s.
+//   TQ1_0: qs[c*32 + j*4 + i] = row j's byte 4c+i of (qs[48] | qh[4]), c = 0..12
+//          chunk c < 8: trit k -> elements 32k + 4c + i;  8 <= c < 12: 160 + 16k + 4(c-8) + i;  c = 12: 240 + 4k + i
+//   TQ2_0: qs[c*32 + j*4 + i] = row j's qs[4c+i], c = 8h + 4g + lane: crumb s -> elements h*128 + 32s + 16g + 4*lane + i
+
+struct block_tq1_0x8 { ggml_half d[8]; uint8_t qs[416]; };
+struct block_tq2_0x8 { ggml_half d[8]; uint8_t qs[512]; };
+static_assert(sizeof(block_tq1_0x8) == 8 * sizeof(block_tq1_0), "tq1_0x8 size");
+static_assert(sizeof(block_tq2_0x8) == 8 * sizeof(block_tq2_0), "tq2_0x8 size");
+
+template <typename BIN, typename BOUT, int NCH>
+static int repack_tq_8x4_tv(struct ggml_tensor * t, const void * GGML_RESTRICT data, size_t data_size) {
+    const int nrow = ggml_nrows(t);
+    const int nblocks = t->ne[0] / QK_K;
+    GGML_ASSERT(data_size == (size_t) nrow * nblocks * sizeof(BIN));
+    if (t->ne[1] % 8 != 0) {
+        return -1;
+    }
+    const BIN * src = (const BIN *) data;
+    BOUT * dst = (BOUT *) t->data;
+    for (int r = 0; r < nrow; r += 8) {
+        for (int b = 0; b < nblocks; b++) {
+            BOUT o;
+            for (int j = 0; j < 8; j++) {
+                const BIN * in = &src[(size_t) (r + j) * nblocks + b];
+                o.d[j] = in->d;
+                const uint8_t * bytes = (const uint8_t *) in;   // qs (| qh) are the leading bytes of the block
+                for (int c = 0; c < NCH; c++) {
+                    memcpy(&o.qs[c * 32 + j * 4], bytes + c * 4, 4);
+                }
+            }
+            *dst++ = o;
+        }
+    }
+    return 0;
+}
+static_assert(offsetof(block_tq1_0, qh) == 48 && offsetof(block_tq1_0, d) == 52, "tq1_0 layout");
+static_assert(offsetof(block_tq2_0, d) == 64, "tq2_0 layout");
+
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+// trit of a pre-multiplied byte: (x * 3) >> 8, as in ggml's tq1_0 vec_dot
+#define TQTV_T3(v) vreinterpretq_s8_u8(vshrq_n_u8(vhaddq_u8((v), vshrq_n_u8((v), 1)), 6))
+
+static inline int32_t tqtv_row_sum(const block_q8_K * y) {
+    return vaddlvq_s16(vaddq_s16(vld1q_s16(y->bsums), vld1q_s16(y->bsums + 8)));
+}
+
+static void ggml_gemv_tq1_0_8x4_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    GGML_UNUSED(bs); GGML_UNUSED(nr);
+    const int nb = n / QK_K;
+    const block_q8_K * y = (const block_q8_K *) vy;
+    for (int x = 0; x < nc / 8; x++) {
+        const block_tq1_0x8 * w = (const block_tq1_0x8 *) vx + (size_t) x * nb;
+        float32x4_t f0 = vdupq_n_f32(0), f1 = vdupq_n_f32(0);
+        for (int b = 0; b < nb; b++) {
+            const int8_t * q8 = y[b].qs;
+            const uint8_t * qs = w[b].qs;
+            int32x4_t a0 = vdupq_n_s32(0), a1 = a0, e0 = a0, e1 = a0;
+#define TQ1TV_CH(QC, A, L) { const uint8x16_t u0 = vld1q_u8(QC), u1 = vld1q_u8((QC) + 16); \
+            a0 = vdotq_laneq_s32(a0, TQTV_T3(u0), A[0], L); a1 = vdotq_laneq_s32(a1, TQTV_T3(u1), A[0], L); \
+            uint8x16_t v0 = vmulq_u8(u0, vdupq_n_u8(3)), v1 = vmulq_u8(u1, vdupq_n_u8(3)); \
+            e0 = vdotq_laneq_s32(e0, TQTV_T3(v0), A[1], L); e1 = vdotq_laneq_s32(e1, TQTV_T3(v1), A[1], L); \
+            v0 = vmulq_u8(u0, vdupq_n_u8(9)); v1 = vmulq_u8(u1, vdupq_n_u8(9)); \
+            a0 = vdotq_laneq_s32(a0, TQTV_T3(v0), A[2], L); a1 = vdotq_laneq_s32(a1, TQTV_T3(v1), A[2], L); \
+            v0 = vmulq_u8(u0, vdupq_n_u8(27)); v1 = vmulq_u8(u1, vdupq_n_u8(27)); \
+            e0 = vdotq_laneq_s32(e0, TQTV_T3(v0), A[3], L); e1 = vdotq_laneq_s32(e1, TQTV_T3(v1), A[3], L); \
+            v0 = vmulq_u8(u0, vdupq_n_u8(81)); v1 = vmulq_u8(u1, vdupq_n_u8(81)); \
+            a0 = vdotq_laneq_s32(a0, TQTV_T3(v0), A[4], L); a1 = vdotq_laneq_s32(a1, TQTV_T3(v1), A[4], L); }
+            for (int g = 0; g < 2; g++) {
