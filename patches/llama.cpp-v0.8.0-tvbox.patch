+            break;
+        }
+    }
+    if (!ok) {
+        LLAMA_LOG_INFO("%s: embedding from head: off (head rows differ from token_embd rows, %s)\n", __func__, bname);
+        return nullptr;
+    }
+    m.inv.assign(embd->ne[1], -1);
+    for (int64_t r = 0; r < n_keep; r++) {
+        if (iv[r] >= 0 && iv[r] < embd->ne[1]) {
+            m.inv[iv[r]] = (int32_t) r;
+        }
+    }
+    m.ok = true;
+    LLAMA_LOG_INFO("%s: embedding from head: on (%lld of %lld rows resident, %s%s)\n", __func__, (long long) n_keep,
+                   (long long) embd->ne[1], bname, m.il ? (m.il == 4 ? ", 8x4 repack" : ", 8x8 repack") : "");
+    return &m;
