+
+// rebuild plain Q4_K row r (n_blk blocks of 144 bytes: d, dmin, scales[12], qs[128]) from a block_q4_Kx8 tensor
+// (per 8-row group and 256 columns: d[8], dmin[8], scales[96], qs[1024] = 1152 bytes)
+static void tv_q4kx8_row(const uint8_t * base, int64_t r, int64_t n_blk, int il, uint8_t * out) {
+    const int64_t g = r / 8;
+    const int     j = (int) (r % 8);
+    for (int64_t b = 0; b < n_blk; b++) {
+        const uint8_t * x = base + (g * n_blk + b) * 1152;
+        uint8_t * o = out + b * 144;
+        memcpy(o + 0, x + 2 * j, 2);       // d
+        memcpy(o + 2, x + 16 + 2 * j, 2);  // dmin
+        const uint8_t * sc = x + 32;
+        uint8_t sv[8], mv[8];
+        for (int sb = 0; sb < 8; sb++) {
+            const uint8_t * q = sc + (sb < 4 ? sb * 12 : 48 + (sb - 4) * 12);
+            if (j < 4) {
+                sv[sb] = q[j] & 63;
+                mv[sb] = q[4 + j] & 63;
+            } else {
+                sv[sb] = (q[8 + j - 4] & 15) | ((q[j - 4] >> 6) << 4);
+                mv[sb] = (q[8 + j - 4] >> 4) | ((q[4 + j - 4] >> 6) << 4);
+            }
+        }
+        uint8_t * os = o + 4;
+        for (int k = 0; k < 4; k++) {
+            os[k]     = sv[k] | ((sv[k + 4] >> 4) << 6);
+            os[k + 4] = mv[k] | ((mv[k + 4] >> 4) << 6);
+            os[k + 8] = (sv[k + 4] & 15) | ((mv[k + 4] & 15) << 4);
