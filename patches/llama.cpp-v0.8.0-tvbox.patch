+static const tv_head_embd_map * tv_head_embd_get(const ggml_tensor * embd, const ggml_tensor * head, const ggml_tensor * ids) {
+    static std::mutex mu;
+    static std::unordered_map<const ggml_tensor *, tv_head_embd_map> cache;
+    std::lock_guard<std::mutex> lock(mu);
+    auto it = cache.find(ids);
+    if (it != cache.end()) {
+        return it->second.ok ? &it->second : nullptr;
+    }
+    if (!embd->data || !head->data || !ids->data || ids->type != GGML_TYPE_I32 ||
+        !head->buffer || !ids->buffer || !ggml_backend_buffer_is_host(ids->buffer) ||
+        !embd->buffer || !ggml_backend_buffer_is_host(embd->buffer) || head->ne[0] != embd->ne[0] ||
