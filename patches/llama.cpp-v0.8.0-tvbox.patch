+// tvbox patch: repacked 1-bit Q1_0 (PrismML Bonsai, group 128, w = d * (+1 | -1)) kernel for ARM dotprod
+// without i8mm (Cortex-A55), against Q8_K activations.
+// Upstream's Q1_0 path expands every 8 sign bits through a 256-entry table (a scalar load + vector insert per
+// byte) before each vdot. Here the bits are stored as bit planes: one 16-byte vector holds 8 chunks of
+// 4 rows x 4 weights, and vtstq_u8 against (1 << k) turns plane k straight into a 0 / -1 mask for
+// vdotq_laneq. With T = sum over set bits of (-1) * a, the dot is d * (2 * sum_set a - sum a) = d * (-2T - S),
+// S = the 128-group's activation sum (from bsums). Two NEON ops per 16 multiply-adds (gemv), no table.
+//
+// Compact scales: Bonsai's per-128 scales are all positive and within 0.44-1.0x of their row's largest
+// (measured on 5 tensors of Bonsai-8B), so each is stored as 1 byte, d = dmin_row + q * dstep_row, with the two
+// fp16 row parameters once per row: mean error 0.1 % of the scale, about fp16's own rounding. 17 bytes per 128
+// weights instead of 18 (-5.6 %), which is what makes Bonsai-8B fit in this box's RAM.
+// Layout, per group of 8 rows (q1tv_group_bytes = 32 + K/256 * 272 bytes):
+//   ggml_half dmin[8], dstep[8]                   row j's scale parameters
+//   then K/256 blocks of block_q1_0x8c:
+//     d[g*8 + j]                    = row j's 8-bit scale code of 128-group g (g = 0, 1)
+//     qs[(q*2 + h)*16 + jj*4 + i]   bit k = sign of row h*4 + jj, element 32q + 4k + i   (q = 0..7, k = 0..7)
+struct block_q1_0x8c { uint8_t d[16]; uint8_t qs[256]; };
+static_assert(sizeof(block_q1_0x8c) == 272, "q1_0x8c size");
+
+static inline size_t q1tv_group_bytes(int64_t k) { return 32 + (size_t) (k / QK_K) * sizeof(block_q1_0x8c); }
+
+static int repack_q1_0_to_q1x8_tv(struct ggml_tensor * t, const void * GGML_RESTRICT data, size_t data_size) {
+    GGML_ASSERT(t->type == GGML_TYPE_Q1_0);
+    const int nrow = ggml_nrows(t);
+    const int nb128 = t->ne[0] / 128, nb = t->ne[0] / QK_K;
+    GGML_ASSERT(data_size == (size_t) nrow * nb128 * sizeof(block_q1_0));
+    if (t->ne[1] % 8 != 0 || t->ne[0] % QK_K != 0) {
+        return -1;
+    }
+    const block_q1_0 * src = (const block_q1_0 *) data;
+    uint8_t * dst = (uint8_t *) t->data;
+    for (int r = 0; r < nrow; r += 8) {
+        ggml_half * hdr = (ggml_half *) dst;
+        float mn[8], st[8];
+        for (int j = 0; j < 8; j++) {
+            float lo = INFINITY, hi = -INFINITY;
+            for (int b = 0; b < nb128; b++) {
+                const float d = GGML_CPU_FP16_TO_FP32(src[(size_t) (r + j) * nb128 + b].d);
+                lo = std::min(lo, d); hi = std::max(hi, d);
+            }
+            hdr[j]     = GGML_CPU_FP32_TO_FP16(lo);
+            hdr[8 + j] = GGML_CPU_FP32_TO_FP16((hi - lo) / 255.0f);
+            mn[j] = GGML_CPU_FP16_TO_FP32(hdr[j]);
+            st[j] = GGML_CPU_FP16_TO_FP32(hdr[8 + j]);
+        }
+        block_q1_0x8c * out = (block_q1_0x8c *) (dst + 32);
