@@ -0,0 +1,192 @@
+// tvbox patch: repacked Q2_K kernels for ARM dotprod without i8mm (Cortex-A55).
+// Upstream only repacks Q2_K for x86 AVX-512 and RISC-V; on ARM it runs the per-row vec_dot, which spends most of
+// its time in horizontal adds (vaddvq) and a scalar scale multiply per 16 weights.
+// Layout (same size as block_q2_Kx8, different order), 8 rows per block:
+//   scales[sb*8 + j] = row j's scales[sb]            (low nibble scale, high nibble min), sb = 0..15
+//   qs[c*32 + j*4 + i] = row j's qs[c*4 + i]         c = 0..15, so one 16-byte load = 4 rows x 4 bytes
+// Byte qs[b] of a row holds elements (b/32)*128 + b%32 + 32*s at bits 2s..2s+1; chunk c = 8h + 4g + lane covers
+// elements h*128 + 32s + 16g + 4*lane .. +3, all in sub-block 8h + 2s + g.
+// Measured by tools/kbench/kbench_q2k.c on the TV: 13-14 G weights/s from DRAM with 3 threads vs 7-8 for vec_dot.
+
+static int repack_q2_K_to_q2_K_8x4_tv(struct ggml_tensor * t, const void * GGML_RESTRICT data, size_t data_size) {
+    GGML_ASSERT(t->type == GGML_TYPE_Q2_K);
+    const int nrow = ggml_nrows(t);
+    const int nblocks = t->ne[0] / QK_K;
+    GGML_ASSERT(data_size == (size_t) nrow * nblocks * sizeof(block_q2_K));
+    if (t->ne[1] % 8 != 0) {
+        return -1;
+    }
+    const block_q2_K * src = (const block_q2_K *) data;
+    block_q2_Kx8 * dst = (block_q2_Kx8 *) t->data;
+    for (int r = 0; r < nrow; r += 8) {
+        for (int b = 0; b < nblocks; b++) {
+            block_q2_Kx8 o;
+            for (int j = 0; j < 8; j++) {
+                const block_q2_K * in = &src[(size_t) (r + j) * nblocks + b];
+                o.d[j]    = in->GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.d;
+                o.dmin[j] = in->GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.dmin;
+                for (int sb = 0; sb < 16; sb++) {
+                    o.scales[sb * 8 + j] = in->scales[sb];
+                }
+                for (int c = 0; c < 16; c++) {
+                    memcpy(&o.qs[c * 32 + j * 4], &in->qs[c * 4], 4);
+                }
+            }
+            *dst++ = o;
+        }
+    }
+    return 0;
+}
+
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+static void ggml_gemv_q2_K_8x4_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    GGML_UNUSED(bs); GGML_UNUSED(nr);
+    const int nb = n / QK_K;
+    const block_q8_K * y = (const block_q8_K *) vy;
+    const uint8x16_t m03 = vdupq_n_u8(0x03), m0c = vdupq_n_u8(0x0C), m30 = vdupq_n_u8(0x30);
+    const uint8x8_t m4 = vdup_n_u8(0x0F);
+    for (int x = 0; x < nc / 8; x++) {
+        const block_q2_Kx8 * w = (const block_q2_Kx8 *) vx + (size_t) x * nb;
+        float32x4_t f0 = vdupq_n_f32(0), f1 = vdupq_n_f32(0);
+        for (int b = 0; b < nb; b++) {
+            const int8_t * q8 = y[b].qs;
+            const uint8_t * qs = w[b].qs;
+            const uint8_t * sc = w[b].scales;
+            int32x4_t t0 = vdupq_n_s32(0), t1 = vdupq_n_s32(0);
+            for (int h = 0; h < 2; h++) {
+                for (int g = 0; g < 2; g++) {
+                    const int8x16_t a0 = vld1q_s8(q8 + h * 128 + 16 * g),      a1 = vld1q_s8(q8 + h * 128 + 32 + 16 * g),
+                                    a2 = vld1q_s8(q8 + h * 128 + 64 + 16 * g), a3 = vld1q_s8(q8 + h * 128 + 96 + 16 * g);
+                    int32x4_t c00 = vdupq_n_s32(0), c01 = c00, c10 = c00, c11 = c00, c20 = c00, c21 = c00, c30 = c00, c31 = c00;
+                    const uint8_t * qc = qs + (h * 8 + g * 4) * 32;
+#define Q2TV_LANE(L) { \
+                    const uint8x16_t w0 = vld1q_u8(qc + (L) * 32), w1 = vld1q_u8(qc + (L) * 32 + 16); \
+                    c00 = vdotq_laneq_s32(c00, vreinterpretq_s8_u8(vandq_u8(w0, m03)), a0, L); \
+                    c01 = vdotq_laneq_s32(c01, vreinterpretq_s8_u8(vandq_u8(w1, m03)), a0, L); \
+                    c10 = vdotq_laneq_s32(c10, vreinterpretq_s8_u8(vandq_u8(w0, m0c)), a1, L); \
+                    c11 = vdotq_laneq_s32(c11, vreinterpretq_s8_u8(vandq_u8(w1, m0c)), a1, L); \
+                    c20 = vdotq_laneq_s32(c20, vreinterpretq_s8_u8(vandq_u8(w0, m30)), a2, L); \
+                    c21 = vdotq_laneq_s32(c21, vreinterpretq_s8_u8(vandq_u8(w1, m30)), a2, L); \
+                    c30 = vdotq_laneq_s32(c30, vreinterpretq_s8_u8(vshrq_n_u8(w0, 6)), a3, L); \
+                    c31 = vdotq_laneq_s32(c31, vreinterpretq_s8_u8(vshrq_n_u8(w1, 6)), a3, L); }
+                    Q2TV_LANE(0) Q2TV_LANE(1) Q2TV_LANE(2) Q2TV_LANE(3)
+#undef Q2TV_LANE
+                    const int base = 8 * h + g;   // sub-block of shift S is base + 2S; per-row dots fit in int16
+#define Q2TV_SCALE(S, D0, D1) { \
+                    const int16x8_t sc16 = vreinterpretq_s16_u16(vmovl_u8(vand_u8(vld1_u8(sc + (base + 2 * (S)) * 8), m4))); \
+                    const int16x8_t dd = vcombine_s16(D0, D1); \
+                    t0 = vmlal_s16(t0, vget_low_s16(dd), vget_low_s16(sc16)); t1 = vmlal_high_s16(t1, dd, sc16); }
+                    Q2TV_SCALE(0, vmovn_s32(c00), vmovn_s32(c01))
+                    Q2TV_SCALE(1, vshrn_n_s32(c10, 2), vshrn_n_s32(c11, 2))
+                    Q2TV_SCALE(2, vshrn_n_s32(c20, 4), vshrn_n_s32(c21, 4))
+                    Q2TV_SCALE(3, vmovn_s32(c30), vmovn_s32(c31))
+#undef Q2TV_SCALE
+                }
+            }
+            int32x4_t b0 = vdupq_n_s32(0), b1 = vdupq_n_s32(0);
+            const int16x8_t bs0 = vld1q_s16(y[b].bsums), bs1 = vld1q_s16(y[b].bsums + 8);
+#define Q2TV_MINS(P, BS, L0, L1) { \
+            const uint8x16_t mn = vshrq_n_u8(vld1q_u8(sc + (P) * 16), 4); \
+            const int16x8_t m0 = vreinterpretq_s16_u16(vmovl_u8(vget_low_u8(mn))), m1 = vreinterpretq_s16_u16(vmovl_high_u8(mn)); \
+            b0 = vmlal_laneq_s16(b0, vget_low_s16(m0), BS, L0); b1 = vmlal_high_laneq_s16(b1, m0, BS, L0); \
+            b0 = vmlal_laneq_s16(b0, vget_low_s16(m1), BS, L1); b1 = vmlal_high_laneq_s16(b1, m1, BS, L1); }
+            Q2TV_MINS(0, bs0, 0, 1) Q2TV_MINS(1, bs0, 2, 3) Q2TV_MINS(2, bs0, 4, 5) Q2TV_MINS(3, bs0, 6, 7)
+            Q2TV_MINS(4, bs1, 0, 1) Q2TV_MINS(5, bs1, 2, 3) Q2TV_MINS(6, bs1, 4, 5) Q2TV_MINS(7, bs1, 6, 7)
+#undef Q2TV_MINS
+            const float32x4_t yd = vdupq_n_f32(y[b].d);
+            const float32x4_t d0 = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d)), yd);
+            const float32x4_t d1 = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].d + 4)), yd);
+            const float32x4_t n0 = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].dmin)), yd);
+            const float32x4_t n1 = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) w[b].dmin + 4)), yd);
+            f0 = vfmaq_f32(f0, d0, vcvtq_f32_s32(t0)); f1 = vfmaq_f32(f1, d1, vcvtq_f32_s32(t1));
+            f0 = vfmsq_f32(f0, n0, vcvtq_f32_s32(b0)); f1 = vfmsq_f32(f1, n1, vcvtq_f32_s32(b1));
+        }
+        vst1q_f32(s + x * 8, f0);
+        vst1q_f32(s + x * 8 + 4, f1);
+    }
+}
+
+// 4 activation rows (block_q8_Kx4, 4-byte interleave from ggml_quantize_mat_q8_K_4x4): each decoded weight vector
+// feeds 4 dot products (one per row, vdotq_laneq picks the row's 4 bytes).
+static void ggml_gemm_q2_K_8x4_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int nb = n / QK_K;
+    const uint8x16_t m03 = vdupq_n_u8(0x03), m0c = vdupq_n_u8(0x0C), m30 = vdupq_n_u8(0x30);
+    const uint8x8_t m4 = vdup_n_u8(0x0F);
+    for (int yb = 0; yb < nr / 4; yb++) {
+        const block_q8_Kx4 * a = (const block_q8_Kx4 *) vy + (size_t) yb * nb;
+        for (int x = 0; x < nc / 8; x++) {
+            const block_q2_Kx8 * w = (const block_q2_Kx8 *) vx + (size_t) x * nb;
+            float32x4_t f[4][2];
+            for (int r = 0; r < 4; r++) { f[r][0] = vdupq_n_f32(0); f[r][1] = vdupq_n_f32(0); }
+            for (int b = 0; b < nb; b++) {
+                const int8_t * q8 = a[b].qs;
+                const uint8_t * qs = w[b].qs;
+                const uint8_t * sc = w[b].scales;
+                int32x4_t t[4][2];
+                for (int r = 0; r < 4; r++) { t[r][0] = vdupq_n_s32(0); t[r][1] = vdupq_n_s32(0); }
+                for (int h = 0; h < 2; h++) {
+                    for (int g = 0; g < 2; g++) {
+                        const uint8_t * qc = qs + (h * 8 + g * 4) * 32;
+#define Q2TV_GEMM_S(S, DEC0, DEC1, NARROW) { \
+                        int32x4_t c[4][2]; \
+                        for (int r = 0; r < 4; r++) { c[r][0] = vdupq_n_s32(0); c[r][1] = vdupq_n_s32(0); } \
+                        for (int L = 0; L < 4; L++) { \
+                            const uint8x16_t w0 = vld1q_u8(qc + L * 32), w1 = vld1q_u8(qc + L * 32 + 16); \
+                            const int8x16_t d0 = vreinterpretq_s8_u8(DEC0), d1 = vreinterpretq_s8_u8(DEC1); \
+                            const int8x16_t av = vld1q_s8(q8 + (h * 128 + 32 * (S) + 16 * g + 4 * L) * 4); \
+                            c[0][0] = vdotq_laneq_s32(c[0][0], d0, av, 0); c[0][1] = vdotq_laneq_s32(c[0][1], d1, av, 0); \
+                            c[1][0] = vdotq_laneq_s32(c[1][0], d0, av, 1); c[1][1] = vdotq_laneq_s32(c[1][1], d1, av, 1); \
+                            c[2][0] = vdotq_laneq_s32(c[2][0], d0, av, 2); c[2][1] = vdotq_laneq_s32(c[2][1], d1, av, 2); \
+                            c[3][0] = vdotq_laneq_s32(c[3][0], d0, av, 3); c[3][1] = vdotq_laneq_s32(c[3][1], d1, av, 3); \
+                        } \
+                        const int16x8_t sc16 = vreinterpretq_s16_u16(vmovl_u8(vand_u8(vld1_u8(sc + (8 * h + g + 2 * (S)) * 8), m4))); \
+                        for (int r = 0; r < 4; r++) { \
+                            const int16x8_t dd = vcombine_s16(NARROW(c[r][0]), NARROW(c[r][1])); \
+                            t[r][0] = vmlal_s16(t[r][0], vget_low_s16(dd), vget_low_s16(sc16)); \
+                            t[r][1] = vmlal_high_s16(t[r][1], dd, sc16); \
+                        } }
+#define Q2TV_N0(v) vmovn_s32(v)
+#define Q2TV_N2(v) vshrn_n_s32(v, 2)
+#define Q2TV_N4(v) vshrn_n_s32(v, 4)
+                        Q2TV_GEMM_S(0, vandq_u8(w0, m03), vandq_u8(w1, m03), Q2TV_N0)
+                        Q2TV_GEMM_S(1, vandq_u8(w0, m0c), vandq_u8(w1, m0c), Q2TV_N2)
+                        Q2TV_GEMM_S(2, vandq_u8(w0, m30), vandq_u8(w1, m30), Q2TV_N4)
+                        Q2TV_GEMM_S(3, vshrq_n_u8(w0, 6), vshrq_n_u8(w1, 6), Q2TV_N0)
+#undef Q2TV_GEMM_S
+#undef Q2TV_N0
+#undef Q2TV_N2
+#undef Q2TV_N4
+                    }
+                }
+                // mins: bsums of row r, sub-block sb live at bsums[(sb/4)*16 + r*4 + sb%4]
+                int32x4_t bi[4][2];
+                for (int r = 0; r < 4; r++) { bi[r][0] = vdupq_n_s32(0); bi[r][1] = vdupq_n_s32(0); }
+                for (int sb = 0; sb < 16; sb++) {
+                    const int16x8_t mn = vreinterpretq_s16_u16(vmovl_u8(vshr_n_u8(vld1_u8(sc + sb * 8), 4)));
+                    for (int r = 0; r < 4; r++) {
+                        const int16_t bsv = a[b].bsums[(sb / 4) * 16 + r * 4 + sb % 4];
