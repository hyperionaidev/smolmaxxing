+// tvbox: file-backed repack cache. GGML_REPACK_CACHE=<prefix> puts the repacked weights in a MAP_SHARED file
+// <prefix>.<bytes> instead of anonymous RAM. The first run repacks into it (each tensor is written back and its
+// pages released as it goes) and marks it complete (<prefix>.<bytes>.ok) when the buffer is freed; later runs map
+// it read-only and skip the repack. The weights are then page cache, not anonymous memory: the kernel can drop
+// and re-read pages under pressure instead of the process being killed, and the model loads in seconds.
+// GGML_REPACK_STREAM_MB=<n> additionally treats the last <n> MB of the cache as a stream zone (see
+// ggml_repack_stream_*): those tensors are prefetched ahead of use and dropped after use, so they never push
+// the resident part out of the page cache.
+#if defined(__linux__)
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <map>
+#include <string>
+struct repack_cache_info { size_t size; std::string path; bool loaded; };
+static std::map<void *, repack_cache_info> & repack_caches() { static std::map<void *, repack_cache_info> m; return m; }
+static bool repack_cache_loaded(ggml_backend_buffer_t b) {
+    auto & m = repack_caches(); auto it = m.find(b->context);
+    return it != m.end() && it->second.loaded;
+}
+static bool repack_cache_building(ggml_backend_buffer_t b) {
+    auto & m = repack_caches(); auto it = m.find(b->context);
+    return it != m.end() && !it->second.loaded;
+}
+static void repack_cache_free(ggml_backend_buffer_t b) {
+    auto & m = repack_caches(); auto it = m.find(b->context);
+    if (it == m.end()) { return; }
+    if (!it->second.loaded) {
