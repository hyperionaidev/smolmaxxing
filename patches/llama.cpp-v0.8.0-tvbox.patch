+    }
+    // tvbox: compact Q1_0 (8-bit scales): 17 bytes per 128 weights + 4 bytes per row
+    if (tensor->type == GGML_TYPE_Q1_0 && ggml::cpu::repack::q1tv_enabled() && ggml_repack_get_optimal_repack_type(tensor) != nullptr) {
+        return (size_t) (ggml_nrows(tensor) / 8) * ggml::cpu::repack::q1tv_group_bytes(tensor->ne[0]);
+    }
+    return ggml_nbytes(tensor);
+}
