+// tvbox patch: two more in-RAM layouts for ternary Q2_0 whose adjacent 64-groups share a scale (Ternary-Bonsai-2: true for
+// every tensor, checked at repack). Both keep one fp16 scale per 128 weights and are lossless.
+//  - g128: the 13-chunk base-3 packing of block_tq1g64x8 with half the scales: 448 bytes per 8 rows x 256 = 1.75 bits/weight.
+//  - f2:   TQ2_0's 2-bit fields with the same scales: 544 bytes = 2.125 bits/weight. On the in-order A55 one base-3 digit costs
+//    5 NEON ops per 16 weights (mul, ushr, uhadd, ushr, sdot) and one 2-bit field costs 2 (and, sdot), so spending RAM on
+//    part of the tensors buys speed. GGML_Q2_0_SCALES=128 turns g128 on, GGML_Q2_0_F2_LAYERS=a-b uses f2 for blk.a..blk.b,
+//    GGML_Q2_0_F2_HEAD=1 for the pruned head.
+struct block_q2_0g128 {};
+struct block_q2_0f2 {};
+// f2g64: 2-bit fields that keep all 4 per-64 scales (Ternary-Bonsai-4B, whose adjacent scales differ): 576 bytes = 2.25 bits/weight,
+// the file's own size. GGML_Q2_0_F2G64_LAYERS=a-b (+ GGML_Q2_0_F2_HEAD=1) selects it; other tensors stay in the 1.875-bit layout.
+struct block_q2_0f2g64 {};
+struct block_t2g64x8 { ggml_half d[32]; uint8_t qs[512]; };
+static_assert(sizeof(block_t2g64x8) == 576, "t2g64x8 size");
+struct block_tq1g128x8 { ggml_half d[16]; uint8_t qs[416]; };
+struct block_t2g128x8  { ggml_half d[16]; uint8_t qs[512]; };
+static_assert(sizeof(block_tq1g128x8) == 448, "tq1g128x8 size");
+static_assert(sizeof(block_t2g128x8) == 544, "t2g128x8 size");
+
+// 0 = per-64 scales (block_tq1g64x8), 1 = g128, 2 = f2, 3 = f2g64
+static int q20c_mode(const struct ggml_tensor * t) {
+    static const bool on = getenv("GGML_Q2_0_SCALES") && atoi(getenv("GGML_Q2_0_SCALES")) == 128;
+    if (!on) {
+        const char * e64 = getenv("GGML_Q2_0_F2G64_LAYERS");
+        if (!e64) { return 0; }
+        int a64 = 1, b64 = 0, il64 = -1;
+        sscanf(e64, "%d-%d", &a64, &b64);
+        if (sscanf(t->name, "blk.%d.", &il64) == 1 && il64 >= a64 && il64 <= b64) { return 3; }
+        const char * h64 = getenv("GGML_Q2_0_F2_HEAD");
+        if (h64 && atoi(h64) != 0 && strcmp(t->name, "output.weight") == 0) { return 3; }
+        return 0;
+    }
+    static int a = 1, b = 0;
+    static const bool parsed = [] { const char * e = getenv("GGML_Q2_0_F2_LAYERS"); if (e) { sscanf(e, "%d-%d", &a, &b); } return true; }();
+    GGML_UNUSED(parsed);
+    int il = -1;
+    if (sscanf(t->name, "blk.%d.", &il) == 1 && il >= a && il <= b) { return 2; }
+    static const bool f2_head = getenv("GGML_Q2_0_F2_HEAD") && atoi(getenv("GGML_Q2_0_F2_HEAD")) != 0;
+    if (f2_head && strcmp(t->name, "output.weight") == 0) { return 2; }
+    return 1;
+}
+
+// one scale for a pair of 64-groups: identical in Ternary-Bonsai-2; GGML_Q2_0_SCALES_AVG=1 takes the mean otherwise (lossy)
+static inline ggml_half q20c_pair_scale(const struct ggml_tensor * t, const block_q2_0 * g) {
+    if (g[0].d == g[1].d) { return g[0].d; }
+    static const bool avg = getenv("GGML_Q2_0_SCALES_AVG") && atoi(getenv("GGML_Q2_0_SCALES_AVG")) != 0;
+    if (!avg) { GGML_ABORT("Q2_0 tensor %s: adjacent 64-groups have different scales; unset GGML_Q2_0_SCALES or set GGML_Q2_0_SCALES_AVG=1", t->name); }
+    return GGML_CPU_FP32_TO_FP16(0.5f * (GGML_CPU_FP16_TO_FP32(g[0].d) + GGML_CPU_FP16_TO_FP32(g[1].d)));
+}
+
+static int repack_q2_0_g128_tv(struct ggml_tensor * t, const void * GGML_RESTRICT data, size_t data_size) {
+    GGML_ASSERT(t->type == GGML_TYPE_Q2_0);
+    const int nrow = ggml_nrows(t);
+    const int nb64 = t->ne[0] / 64, nb = t->ne[0] / QK_K;
+    GGML_ASSERT(data_size == (size_t) nrow * nb64 * sizeof(block_q2_0));
+    if (t->ne[1] % 8 != 0 || t->ne[0] % QK_K != 0) { return -1; }
+    const block_q2_0 * src = (const block_q2_0 *) data;
+    block_tq1g128x8 * dst = (block_tq1g128x8 *) t->data;
+    for (int r = 0; r < nrow; r += 8) {
+        for (int b = 0; b < nb; b++) {
+            block_tq1g128x8 o;
+            for (int j = 0; j < 8; j++) {
+                const block_q2_0 * in = &src[(size_t) (r + j) * nb64 + b * 4];
+                o.d[j] = q20c_pair_scale(t, in); o.d[8 + j] = q20c_pair_scale(t, in + 2);
+                uint8_t tr[QK_K];
+                for (int e = 0; e < QK_K; e++) {
+                    const uint8_t q = (in[e / 64].qs[(e % 64) / 4] >> (2 * (e % 4))) & 3;
+                    if (q == 3) { GGML_ABORT("Q2_0 tensor %s is not ternary (value +2 found); run with GGML_Q2_0_TERNARY=0", t->name); }
+                    tr[e] = q;
+                }
+                uint8_t bytes[52];
+                for (int m = 0; m < 32; m++) { unsigned q = 0; for (int k = 0; k < 5; k++) { q = q * 3 + tr[m + 32 * k]; } bytes[m] = (uint8_t) ((q * 256 + 242) / 243); }
+                for (int m = 0; m < 16; m++) { unsigned q = 0; for (int k = 0; k < 5; k++) { q = q * 3 + tr[160 + m + 16 * k]; } bytes[32 + m] = (uint8_t) ((q * 256 + 242) / 243); }
+                for (int m = 0; m < 4; m++) { unsigned q = 0; for (int k = 0; k < 4; k++) { q = q * 3 + tr[240 + m + 4 * k]; } q *= 3; bytes[48 + m] = (uint8_t) ((q * 256 + 242) / 243); }
+                for (int c = 0; c < 13; c++) { memcpy(&o.qs[c * 32 + j * 4], bytes + c * 4, 4); }
+            }
+            *dst++ = o;
+        }
+    }
+    return 0;
+}
+
+// element = h*128 + 32s + 16g + 4*lane + i <-> crumb s of row byte 4*(8h + 4g + lane) + i (block_tq2_0x8's layout)
+static int repack_q2_0_f2_tv(struct ggml_tensor * t, const void * GGML_RESTRICT data, size_t data_size) {
+    GGML_ASSERT(t->type == GGML_TYPE_Q2_0);
+    const int nrow = ggml_nrows(t);
+    const int nb64 = t->ne[0] / 64, nb = t->ne[0] / QK_K;
+    GGML_ASSERT(data_size == (size_t) nrow * nb64 * sizeof(block_q2_0));
+    if (t->ne[1] % 8 != 0 || t->ne[0] % QK_K != 0) { return -1; }
+    const block_q2_0 * src = (const block_q2_0 *) data;
+    block_t2g128x8 * dst = (block_t2g128x8 *) t->data;
+    for (int r = 0; r < nrow; r += 8) {
+        for (int b = 0; b < nb; b++) {
+            block_t2g128x8 o;
+            for (int j = 0; j < 8; j++) {
+                const block_q2_0 * in = &src[(size_t) (r + j) * nb64 + b * 4];
+                o.d[j] = q20c_pair_scale(t, in); o.d[8 + j] = q20c_pair_scale(t, in + 2);
+                uint8_t bytes[64];
+                memset(bytes, 0, sizeof(bytes));
+                for (int e = 0; e < QK_K; e++) {
+                    const uint8_t q = (in[e / 64].qs[(e % 64) / 4] >> (2 * (e % 4))) & 3;
+                    if (q == 3) { GGML_ABORT("Q2_0 tensor %s is not ternary (value +2 found); run with GGML_Q2_0_TERNARY=0", t->name); }
+                    const int h = e >> 7, s = (e >> 5) & 3, g = (e >> 4) & 1, lane = (e >> 2) & 3, i = e & 3;
+                    bytes[4 * (8 * h + 4 * g + lane) + i] |= (uint8_t) (q << (2 * s));
+                }
+                for (int c = 0; c < 16; c++) { memcpy(&o.qs[c * 32 + j * 4], bytes + c * 4, 4); }
+            }
+            *dst++ = o;
+        }
+    }
+    return 0;
+}
+
+static int repack_q2_0_f2g64_tv(struct ggml_tensor * t, const void * GGML_RESTRICT data, size_t data_size) {
+    GGML_ASSERT(t->type == GGML_TYPE_Q2_0);
+    const int nrow = ggml_nrows(t);
+    const int nb64 = t->ne[0] / 64, nb = t->ne[0] / QK_K;
+    GGML_ASSERT(data_size == (size_t) nrow * nb64 * sizeof(block_q2_0));
+    if (t->ne[1] % 8 != 0 || t->ne[0] % QK_K != 0) { return -1; }
+    const block_q2_0 * src = (const block_q2_0 *) data;
+    block_t2g64x8 * dst = (block_t2g64x8 *) t->data;
+    for (int r = 0; r < nrow; r += 8) {
+        for (int b = 0; b < nb; b++) {
+            block_t2g64x8 o;
+            for (int j = 0; j < 8; j++) {
+                const block_q2_0 * in = &src[(size_t) (r + j) * nb64 + b * 4];
+                for (int g = 0; g < 4; g++) { o.d[g * 8 + j] = in[g].d; }
+                uint8_t bytes[64];
+                memset(bytes, 0, sizeof(bytes));
+                for (int e = 0; e < QK_K; e++) {
+                    const uint8_t q = (in[e / 64].qs[(e % 64) / 4] >> (2 * (e % 4))) & 3;
+                    if (q == 3) { GGML_ABORT("Q2_0 tensor %s is not ternary (value +2 found); run with GGML_Q2_0_TERNARY=0", t->name); }
+                    const int h = e >> 7, s = (e >> 5) & 3, g = (e >> 4) & 1, lane = (e >> 2) & 3, i = e & 3;
+                    bytes[4 * (8 * h + 4 * g + lane) + i] |= (uint8_t) (q << (2 * s));
+                }
+                for (int c = 0; c < 16; c++) { memcpy(&o.qs[c * 32 + j * 4], bytes + c * 4, 4); }
+            }
+            *dst++ = o;
+        }
+    }
+    return 0;
+}
+
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+#define Q20C_T3(v) vreinterpretq_s8_u8(vshrq_n_u8(vhaddq_u8((v), vshrq_n_u8((v), 1)), 6))
+
+static void ggml_gemv_q2_0_g128_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
