+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+#define TQTV_T3(v) vreinterpretq_s8_u8(vshrq_n_u8(vhaddq_u8((v), vshrq_n_u8((v), 1)), 6))
+
+static void ggml_gemv_q2_0_tq1g64_q8_K_tv(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
