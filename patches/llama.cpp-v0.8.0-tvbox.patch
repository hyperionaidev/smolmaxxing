+    if (!have && ftruncate(fd, (off_t) size) != 0) { close(fd); GGML_LOG_ERROR("%s: ftruncate %s failed\n", __func__, path.c_str()); return nullptr; }
+    void * p = mmap(nullptr, size, have ? PROT_READ : (PROT_READ | PROT_WRITE), MAP_SHARED, fd, 0);
+    close(fd);
+    if (p == MAP_FAILED) { GGML_LOG_ERROR("%s: mmap %s failed\n", __func__, path.c_str()); return nullptr; }
