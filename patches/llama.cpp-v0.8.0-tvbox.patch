+        return nullptr; // not cached: weights may not be loaded yet (memory-fit pass)
+    }
+    tv_head_embd_map & m = cache[ids];
+    const char * bname = ggml_backend_buft_name(ggml_backend_buffer_get_type(head->buffer));
+    const bool plain  = strcmp(bname, "CPU") == 0 || strcmp(bname, "CPU_Mapped") == 0;
+    const bool rep4k  = strcmp(bname, "CPU_REPACK") == 0 && head->type == GGML_TYPE_Q4_K && head->ne[1] % 8 == 0 &&
