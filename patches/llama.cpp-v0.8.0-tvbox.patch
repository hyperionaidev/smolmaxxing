+// ---- Q2_0 (group 64) holding ternary weights (PrismML Ternary-Bonsai) -> TQ1_0-style base-3 packing that keeps
+// the 4 per-64 scales: 480 bytes per 8 rows x 256 instead of 576 (1.875 bits/weight, lossless for ternary data).
+// Same 13-chunk trit layout as block_tq1_0x8; d[g*8 + j] = scale of row j's 64-group g. Each (chunk, trit) pair
+// lies inside one 64-group: chunks 0-7: trits 0,1 -> g0, 2,3 -> g1, 4 -> g2; chunks 8-11: 0,1 -> g2, 2-4 -> g3;
+// chunk 12 (4 trits) -> g3. The tensor is allocated at 5/6 of its file size (see the buffer type's get_alloc_size)
+// and row offsets inside it are scaled the same way (repack_rows_bytes).
+struct block_tq1g64x8 { ggml_half d[32]; uint8_t qs[416]; };
+static_assert(sizeof(block_tq1g64x8) * 6 == 8 * 4 * sizeof(block_q2_0) * 5, "tq1g64x8 size");
+
+static int repack_q2_0_to_tq1g64_tv(struct ggml_tensor * t, const void * GGML_RESTRICT data, size_t data_size) {
+    GGML_ASSERT(t->type == GGML_TYPE_Q2_0);
+    const int nrow = ggml_nrows(t);
+    const int nb64 = t->ne[0] / 64, nb = t->ne[0] / QK_K;
+    GGML_ASSERT(data_size == (size_t) nrow * nb64 * sizeof(block_q2_0));
+    if (t->ne[1] % 8 != 0 || t->ne[0] % QK_K != 0) {
+        return -1;
+    }
+    const block_q2_0 * src = (const block_q2_0 *) data;
+    block_tq1g64x8 * dst = (block_tq1g64x8 *) t->data;
+    for (int r = 0; r < nrow; r += 8) {
+        for (int b = 0; b < nb; b++) {
+            block_tq1g64x8 o;
+            for (int j = 0; j < 8; j++) {
+                uint8_t tr[QK_K];   // trit + 1 in {0, 1, 2}
+                for (int g = 0; g < 4; g++) {
+                    const block_q2_0 * in = &src[(size_t) (r + j) * nb64 + b * 4 + g];
+                    o.d[g * 8 + j] = in->d;
+                    for (int e = 0; e < 64; e++) {
+                        const uint8_t q = (in->qs[e / 4] >> (2 * (e % 4))) & 3;   // value q - 1
+                        if (q == 3) {
+                            GGML_ABORT("Q2_0 tensor %s is not ternary (value +2 found); run with GGML_Q2_0_TERNARY=0", t->name);
+                        }
+                        tr[g * 64 + e] = q;
+                    }
+                }
+                uint8_t bytes[52];   // packed exactly like quantize_row_tq1_0_ref
+                for (int m = 0; m < 32; m++) {
+                    unsigned q = 0;
+                    for (int k = 0; k < 5; k++) { q = q * 3 + tr[m + 32 * k]; }
+                    bytes[m] = (uint8_t) ((q * 256 + 242) / 243);
+                }
+                for (int m = 0; m < 16; m++) {
+                    unsigned q = 0;
+                    for (int k = 0; k < 5; k++) { q = q * 3 + tr[160 + m + 16 * k]; }
+                    bytes[32 + m] = (uint8_t) ((q * 256 + 242) / 243);
+                }
+                for (int m = 0; m < 4; m++) {
+                    unsigned q = 0;
+                    for (int k = 0; k < 4; k++) { q = q * 3 + tr[240 + m + 4 * k]; }
+                    q *= 3;
+                    bytes[48 + m] = (uint8_t) ((q * 256 + 242) / 243);
+                }
+                for (int c = 0; c < 13; c++) {
+                    memcpy(&o.qs[c * 32 + j * 4], bytes + c * 4, 4);
+                }
+            }
+            *dst++ = o;
+        }
+    }
+    return 0;
+}
