+        FILE * f = fopen((it->second.path + ".ok").c_str(), "w");
+        if (f) { fprintf(f, "%zu\n", it->second.size); fclose(f); }
+        GGML_LOG_INFO("%s: repack cache %s complete\n", __func__, it->second.path.c_str());
+    }
+    ggml_cpu_stream_stats();
+    munmap(b->context, it->second.size);
