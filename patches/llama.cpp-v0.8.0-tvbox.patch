+// gemm: 4 activation rows in the block_q8_Kx4 layout (4-byte interleave): element group e (4 elements) of the
+// 4 rows is the 16 bytes at qs + e*4, row r = lane r. Row sums from bsums[(sb/4)*16 + r*4 + sb%4].
+#define TQTV_GEMM_DOT(D0, D1, E) { const int8x16_t av = vld1q_s8(q8 + (E) * 4); \
+    c[0][0] = vdotq_laneq_s32(c[0][0], D0, av, 0); c[0][1] = vdotq_laneq_s32(c[0][1], D1, av, 0); \
+    c[1][0] = vdotq_laneq_s32(c[1][0], D0, av, 1); c[1][1] = vdotq_laneq_s32(c[1][1], D1, av, 1); \
+    c[2][0] = vdotq_laneq_s32(c[2][0], D0, av, 2); c[2][1] = vdotq_laneq_s32(c[2][1], D1, av, 2); \
+    c[3][0] = vdotq_laneq_s32(c[3][0], D0, av, 3); c[3][1] = vdotq_laneq_s32(c[3][1], D1, av, 3); }
+
+static inline void tqtv_gemm_finish(float32x4_t f[4][2], int32x4_t c[4][2], const block_q8_Kx4 * a, const ggml_half * wd) {
+    const float32x4_t d0 = vcvt_f32_f16(vld1_f16((const __fp16 *) wd)), d1 = vcvt_f32_f16(vld1_f16((const __fp16 *) wd + 4));
+    for (int r = 0; r < 4; r++) {
+        int32_t ysum = 0;
+        for (int sb = 0; sb < 16; sb++) { ysum += a->bsums[(sb / 4) * 16 + r * 4 + sb % 4]; }
+        const int32x4_t ys = vdupq_n_s32(ysum);
+        f[r][0] = vfmaq_f32(f[r][0], vmulq_n_f32(d0, a->d[r]), vcvtq_f32_s32(vsubq_s32(c[r][0], ys)));
+        f[r][1] = vfmaq_f32(f[r][1], vmulq_n_f32(d1, a->d[r]), vcvtq_f32_s32(vsubq_s32(c[r][1], ys)));
